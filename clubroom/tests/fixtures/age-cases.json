      "cases": [
        { "dob": "2015-01-01", "expect": "U14" },
        { "dob": "2015-01-02", "expect": "U12" },
        { "dob": "2013-01-01", "expect": null }
      ]
    },
    {
      "name": "birth year 2026 season",
      "mode": "birth_year",
      "cutoff": null,
      "divisions": [
        { "name": "U12", "sort": 1, "born_from": 2015, "born_to": 2016 },
        { "name": "U14", "sort": 2, "born_from": 2013, "born_to": 2014 },
        { "name": "U16", "sort": 3, "born_from": 2011, "born_to": 2012 },
        { "name": "Seniors", "sort": 4, "born_to": 2008 }
