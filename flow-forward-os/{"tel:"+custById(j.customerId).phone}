function Invoices(props){
  const {tenant,data,setData,toast}=props;
  const [filter,setFilter]=useState("all");
  const [chasing,setChasing]=useState(null);
  const [viewing,setViewing]=useState(null);
  const custById=id=>data.customers.find(c=>c.id===id)||{name:"—",phone:"",email:""};
  const shown=data.invoices.filter(i=>filter==="all"||i.status===filter).sort((a,b)=>b.issuedAt.localeCompare(a.issuedAt));
  const outstanding=data.invoices.filter(i=>i.status!=="paid").reduce((a,i)=>a+i.amount,0);
  const overdue=data.invoices.filter(i=>i.status==="overdue");

  const markPaid=inv=>{
    setData(d=>{
      d.invoices=d.invoices.map(x=>x.id===inv.id?{...x,status:"paid",paidAt:todayISO(),method:"bank"}:x);
      d.activity.unshift({id:uid(),text:"Invoice "+inv.num+" marked paid (bank transfer)",date:todayISO(),icon:"💳"});
      return d;
    });
    toast("Marked paid 💰");
  };

  if(viewing){
    const inv=data.invoices.find(x=>x.id===viewing); if(!inv){setViewing(null);return null;}
    return <InvoiceDoc inv={inv} tenant={tenant} cust={custById(inv.customerId)} onBack={()=>setViewing(null)}
      onMarkPaid={()=>{markPaid(inv);setViewing(null);}} onChase={()=>{setViewing(null);setChasing(inv);}}/>;
  }

  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Invoices & Payments</div><div className="muted tiny">Invoices auto-issue when jobs complete. Customers pay by card in their portal (Stripe).</div></div>
    </div>
    <div className="stats" style={{gridTemplateColumns:"repeat(3,1fr)"}}>
      <Stat label="Outstanding" value={fmt$(outstanding)} delta={shown.filter(i=>i.status==="sent").length+" awaiting"} tone="warn"/>
      <Stat label="Overdue" value={fmt$(overdue.reduce((a,i)=>a+i.amount,0))} delta={overdue.length+" invoice"+(overdue.length!==1?"s":"")} tone={overdue.length?"bad":"good"}/>
      <Stat label="Collected (all time)" value={fmt$(data.invoices.filter(i=>i.status==="paid").reduce((a,i)=>a+i.amount,0))} delta="via Stripe & bank" tone="good"/>
    </div>
    <div className="pills" style={{marginBottom:14}}>
      {["all","sent","overdue","paid"].map(s=><button key={s} className={"pill"+(filter===s?" active":"")} onClick={()=>setFilter(s)}>{s[0].toUpperCase()+s.slice(1)}</button>)}
    </div>
    <div className="card"><div className="list">
      {shown.map(inv=><div key={inv.id} className="list-row">
        <div style={{flex:1,minWidth:0,cursor:"pointer"}} onClick={()=>setViewing(inv.id)}>
          <div style={{fontWeight:600}}>{inv.num} · {inv.title}</div>
          <div className="tiny muted">{custById(inv.customerId).name} · issued {fmtDate(inv.issuedAt)} · {inv.status==="paid"?"paid "+fmtDate(inv.paidAt)+(inv.method==="card"?" 💳 card":" 🏦 bank"):"due "+fmtDate(inv.dueAt)}</div>
        </div>
        <span className="money" style={{fontWeight:700}}>{fmt$(inv.amount)}</span>
        <StatusBadge s={inv.status}/>
        {inv.status!=="paid" && <div className="row no-print" style={{gap:6}}>
          <button className={"btn btn-sm "+(inv.status==="overdue"?"btn-primary":"btn-ghost")} onClick={()=>setChasing(inv)}>{inv.status==="overdue"?"💬 Chase":"💬 Remind"}</button>
          <button className="btn btn-ghost btn-sm" onClick={()=>markPaid(inv)}>Mark paid</button>
        </div>}
      </div>)}
      {shown.length===0 && <Empty icon="💳" title="No invoices here" sub="Complete a job and its invoice is issued automatically."/>}
    </div></div>
    {chasing && <ChaseModal inv={chasing} cust={custById(chasing.customerId)} tenant={tenant} data={data} setData={setData} toast={toast} onClose={()=>setChasing(null)}/>}
  </React.Fragment>;
}

