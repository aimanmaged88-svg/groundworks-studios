function dueClass(due,done){ if(done)return 'dueflag'; if(due<todayISO())return 'dueflag over'; if(due===todayISO())return 'dueflag today'; return 'dueflag'; }
function dueLabel(due){ if(due<todayISO())return '⏰ Overdue '+friendlyDate(due); if(due===todayISO())return '📌 Today'; if(due===addDays(todayISO(),1))return 'Tomorrow'; return friendlyDate(due); }

