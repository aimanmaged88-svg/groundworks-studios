          <Avatar name={c.name} size={52}/>
          <div style={{flex:1}}>
            <div className="h2">{c.name} {c.tags?.map(t=><span key={t} className="badge b-accent" style={{marginLeft:6}}>{t}</span>)}</div>
            <div className="tiny muted">{c.address}</div>
            <div className="tiny muted">{c.phone} · {c.email}</div>
            {paymentProfile(data,c.id).flag && <div style={{marginTop:6}}><PayHistoryBadge p={paymentProfile(data,c.id)}/> <span className="tiny faint">internal only</span></div>}
          </div>
          <div style={{textAlign:"right"}}>
            <div className="tiny faint">Lifetime value</div>
            <div style={{fontWeight:800,fontSize:20}} className="money">{fmt$(lifetime(c))}</div>
          </div>
        </div>
        <div className="row no-print" style={{marginTop:14,flexWrap:"wrap"}}>
          <button className="btn btn-ghost btn-sm" onClick={()=>setModal(c)}>Edit</button>
          {c.phone && <a className="btn btn-ghost btn-sm" href={"tel:"+c.phone.replace(/\s/g,"")}>📞 Call</a>}
          {c.phone && <a className="btn btn-ghost btn-sm" href={"sms:"+c.phone.replace(/\s/g,"")+"?&body="+encodeURIComponent("Hi "+c.name.split(" ")[0]+", ")}>💬 SMS</a>}
          {c.email && <a className="btn btn-ghost btn-sm" href={"mailto:"+c.email+"?subject="+encodeURIComponent(tenant.name)+"&body="+encodeURIComponent("Hi "+c.name.split(" ")[0]+",\n\n")}>✉️ Email</a>}
        </div>
      </div>
      <div className="grid2" style={{alignItems:"start"}}>
        <div className="card"><div className="h3" style={{padding:"14px 16px 4px"}}>Quotes ({cQuotes.length})</div>
