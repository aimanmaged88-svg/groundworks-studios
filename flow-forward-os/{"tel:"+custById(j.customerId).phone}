function TenantApp({tenant,tenants,setTenants,session,onLogout,toast}){
  const [data,setDataRaw]=useState(()=>DB.load(tenant.id));
  const setData=updater=>{
    setDataRaw(prev=>{
      const next=typeof updater==="function"? updater(structuredClone(prev)) : updater;
      DB.save(tenant.id,next); return next;
    });
  };
  const updateTenant=patch=>{
    const next=tenants.map(t=>t.id===tenant.id?{...t,...patch}:t);
    setTenants(next); DB.saveTenants(next);
  };
  const baseInd=INDUSTRIES[tenant.industry];
  const ind={...baseInd, rates:(data.rates&&data.rates.length)?data.rates:baseInd.rates};
  const props={tenant,ind,data,setData,updateTenant,session,onLogout,toast};
  if(session.role==="staff") return <StaffPortal {...props}/>;
  if(session.role==="customer") return <CustomerPortal {...props}/>;
  return <OwnerApp {...props}/>;
}

