function generateAdvice(focus){
  const A=[]; const h=H(); const t=todayISO();
  const push=(icon,title,body,extra)=>A.push(Object.assign({icon,title,body},extra||{}));
  // ---- gather signals ----
  const soon = d=>d>=t && d<=addDays(t,7);
  const inSoon = S.upcoming.filter(u=>u.dir==='in'&&u.date&&soon(u.date));
  const outSoon = S.upcoming.filter(u=>u.dir==='out'&&u.date&&soon(u.date));
  const inTot=inSoon.reduce((a,b)=>a+b.amount,0), outTot=outSoon.reduce((a,b)=>a+b.amount,0);
  const net=inTot-outTot;
  const owed=S.projects.reduce((a,p)=>a+projOutstanding(normProject(p)),0);
  const owedN=S.projects.filter(p=>projOutstanding(p)>0);
  const overdue=S.tasks.filter(x=>!x.done&&x.due&&x.due<t);
  const dueToday=S.tasks.filter(x=>!x.done&&x.due===t);
  const highTasks=S.tasks.filter(x=>!x.done&&x.priority==='high');
  const openTasks=S.tasks.filter(x=>!x.done);
  const goal=S.goal||{};
  const wt=waterToday(), cal=calToday(), pro=proteinToday(), g=h.goals;
  const sleptRow=[...h.sleep].sort((a,b)=>b.date.localeCompare(a.date))[0];
  const free=nextFreeDays();
  const firstFree=free.find(f=>f.date!==t) || free[0];
  const eventsSoon=S.events.filter(e=>e.date>=t&&e.date<=addDays(t,7)&&e.type!=='pay'&&e.type!=='bill').sort(evtSort);

  const want = k => focus==='all'||focus===k;

  // ===== TODAY / focus headline =====
  if(want('today')||focus==='all'){
    let bits=[];
    if(dueToday.length) bits.push(`${dueToday.length} task${dueToday.length>1?'s':''} due`);
    if(inSoon.some(u=>u.date===t)) bits.push(`money landing today`);
    if(!h.water.some(w=>w.date===t)) bits.push(`no water logged yet`);
    push('📌','Today at a glance', bits.length?`You've got ${bits.join(', ')}. Knock over the ${dueToday.length?'task first while you\'re fresh':'quick wins'} and log your first glass of water.`:`Nothing urgent scheduled — a good day to get ahead on ${openTasks[0]?esc(openTasks[0].text):'a project'} or invest in your health.`,
      {acc:true,tag:'Start here',tagbg:'rgba(91,140,255,.18)',tagc:'var(--brand)'});
  }

  // ===== MONEY =====
  if(want('money')){
    if(S.balance!=null){
      if(net>=0) push('💰',`You're ${money(net)} up this week`, `About ${money(inTot)} is coming in and ${money(outTot)} going out over the next 7 days. With ${money(S.balance)} in the bank, you've got breathing room — consider moving ${money(Math.max(50,Math.round(net*0.3/10)*10))} into your “${esc(goal.name||'savings')}” goal while it's there.`);
      else push('⚠️',`Tight week ahead: ${money(net)}`, `More is going out (${money(outTot)}) than coming in (${money(inTot)}) over the next 7 days. You have ${money(S.balance)} now — hold off on non-essentials, and if any client owes you, this is the week to chase it.`,{tag:'Heads up',tagbg:'rgba(255,107,125,.15)',tagc:'var(--red)'});
    } else {
      push('💰','Set your bank balance', `Pop your current balance in on the Money tab and every insight here gets sharper — I can then tell you exactly what's safe to spend and save.`);
    }
    if(owed>0) push('🧾',`${money(owed)} is owed to you`, `${owedN.map(p=>esc(p.name)).slice(0,3).join(', ')}${owedN.length>3?' and more':''} ${owedN.length>1?'have':'has'} outstanding balances. A friendly “just following up on the invoice” today could bring that cash forward.`);
    if(goal&&goal.target){ const pct=Math.round((goal.saved||0)/goal.target*100); push('🎯',`${esc(goal.name)}: ${pct}% there`, `${money(goal.saved||0)} of ${money(goal.target)} saved. ${pct<100?`Setting aside just ${money(Math.max(20,Math.round((goal.target-(goal.saved||0))/12/10)*10))} a week gets you there in about 3 months.`:`You hit it — time to set a bigger goal. 🎉`}`); }
  }

  // ===== HEALTH =====
  if(want('health')){
    const anyHealth=h.water.length||h.meals.length||h.workouts.length;
    if(!anyHealth){ push('🥗','Kick off your health tracking', `You said you're ramping up — start tiny today: log one glass of water and what you had for your last meal. Small streaks beat big plans. I'll track the trend for you.`,{acc:true}); }
    else {
      if(wt<g.water) push('💧',`${((g.water-wt)/1000).toFixed(2)}L of water to go`, `You're on ${(wt/1000).toFixed(2)}L of your ${(g.water/1000).toFixed(1)}L goal. Keep a bottle in sight — hitting your water target is the single easiest win for energy and focus today.`);
      else push('💧','Water goal smashed 💦', `${(wt/1000).toFixed(2)}L down — nice work. Hydration sorted.`);
      if(pro<g.protein) push('🍗',`${g.protein-pro}g more protein today`, `You're at ${pro}g of ${g.protein}g. A protein-heavy next meal (chicken, eggs, Greek yoghurt, a shake) keeps you full and protects muscle while you get leaner.`);
      if(!moveToday().length) push('🏃','Move your body today', `No movement logged yet. Even a 20-minute walk counts — bank it now and your streak (and your head) will thank you.`);
      const streak=healthStreak(); if(streak>=3) push('🔥',`${streak}-day streak — protect it`, `You've logged ${streak} days straight. Don't break the chain: one quick log today keeps the momentum.`,{tag:'Momentum',tagbg:'rgba(255,194,77,.15)',tagc:'var(--amber)'});
    }
    if(sleptRow&&sleptRow.hours<7) push('😴','Prioritise sleep tonight', `Last logged night was ${sleptRow.hours}h. Aim for ${g.sleep||8}h — everything (mood, cravings, training) gets easier when you're rested. Wind down 30 min earlier tonight.`);
  }

  // ===== DAY OFF / RECHARGE =====
  if(want('dayoff')||focus==='all'){
    if(firstFree){
      const acts=['head to the beach for a swim & some sun ☀️','do some barefoot grounding on grass or sand 🌱','take a long walk somewhere green 🌳','book a sauna or a cold plunge ❄️','cook a proper meal and meal-prep for the week 🥘','leave the phone at home for a couple of hours 📵','stretch, mobilise and reset your body 🧘','ring family or a mate you’ve been meaning to catch 👨‍👩‍👧'];
      const pick=[acts[(new Date().getDate())%acts.length],acts[(new Date().getDate()+3)%acts.length]];
      const when=firstFree.date===t?'Today looks clear':`${friendlyDate(firstFree.date)} looks like a free ${firstFree.weekend?'weekend ':''}day`;
      push('🏖️',`${when} — actually rest`, `You work hard — protect this one. Ideas: ${pick[0]}, or ${pick[1]}. Recovery isn't lazy; it's what lets you keep going. Block it out so work doesn't creep in.`,{acc:true,tag:'Recharge',tagbg:'rgba(62,199,201,.16)',tagc:'var(--teal)'});
    }
  }

  // ===== WORK / PROJECTS =====
  if(want('work')){
    if(overdue.length) push('⏰',`${overdue.length} task${overdue.length>1?'s':''} overdue`, `Start with “${esc(overdue[0].text)}”. Overdue stuff drains more energy sitting there than doing it — clear one and the rest feel lighter.`,{tag:'Overdue',tagbg:'rgba(255,107,125,.15)',tagc:'var(--red)'});
    if(highTasks.length) push('🔴',`${highTasks.length} high-priority task${highTasks.length>1?'s':''}`, `Your big rock is “${esc(highTasks[0].text)}”. Give it your first focused block today before the small stuff eats your time.`);
    const active=S.projects.filter(p=>p.status==='Building'||p.status==='Awaiting');
    if(active.length){ const p=normProject(active[0]); if(p.nextAction) push('🚀',`Next on ${esc(p.name)}`, `“${esc(p.nextAction)}”. ${active.length>1?`You've got ${active.length} projects mid-flight — momentum on one beats a little on all of them.`:'Ship this and it moves you forward.'}`); }
    if(!overdue.length&&!highTasks.length&&openTasks.length) push('✅','You\'re on top of it', `No overdue or high-priority tasks — nice. If you want to get ahead, “${esc(openTasks[0].text)}” is next in line.`);
    if(!openTasks.length) push('🎉','Task list is clear', `Nothing open. Rare and well-earned — enjoy it, or line up one thing that future-you will thank you for.`);
  }

  // ===== upcoming events reminder (full scan only) =====
  if(focus==='all'&&eventsSoon.length){ const e=eventsSoon[0]; push('📅',`Coming up: ${esc(e.title)}`, `${friendlyDate(e.date)}${e.start?' at '+fmtTime(e.start):''}. ${eventsSoon.length>1?`Plus ${eventsSoon.length-1} more this week — glance at your calendar so nothing sneaks up.`:'On your calendar.'}`); }

  if(!A.length) push('✨','All quiet','Nothing pressing right now. Log a glass of water, and maybe line up one small goal for tomorrow.');
  return A;
}

