<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="theme-color" content="#12403C" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<title>Borealis SIL OS</title>
<link rel="manifest" href="manifest.json" />
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%2312403C'/%3E%3Ctext x='50' y='66' font-size='48' text-anchor='middle' fill='%23F7F3E3' font-family='Georgia'%3EB%3C/text%3E%3C/svg%3E" />
<script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
<script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
<script src="https://unpkg.com/@babel/standalone@7/babel.min.js"></script>
<script src="https://unpkg.com/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style>
:root{
  --bg:#F6F4EC; --surface:#FFFFFF; --surface2:#EFEDE3; --ink:#1B2422; --ink2:#5B6663; --ink3:#8B9490;
  --brand:#12403C; --brand2:#1D5A54; --brandSoft:#DCEAE6; --accent:#A8265C; --accentSoft:#F7E2EB;
  --ok:#2E7D4F; --okSoft:#E1F0E6; --warn:#9A6A00; --warnSoft:#FBF0D5; --danger:#B3362B; --dangerSoft:#F9E4E1;
  --border:#E2DFD2; --shadow:0 1px 3px rgba(20,30,28,.08),0 4px 14px rgba(20,30,28,.06);
  --radius:14px; --safe-b:env(safe-area-inset-bottom,0px);
}
[data-theme="dark"]{
  --bg:#101716; --surface:#1A2321; --surface2:#22302D; --ink:#EDF2EF; --ink2:#A9B6B1; --ink3:#77837F;
  --brand:#5FB3A4; --brand2:#7CC7B9; --brandSoft:#1E3833; --accent:#E876A6; --accentSoft:#3A2230;
  --ok:#68C08B; --okSoft:#1D332A; --warn:#E0B45C; --warnSoft:#3A3220; --danger:#E4776B; --dangerSoft:#3B2422;
  --border:#2C3A36; --shadow:0 1px 3px rgba(0,0,0,.4);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);font:16px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;-webkit-font-smoothing:antialiased}
h1,h2,h3{margin:0;font-weight:650;letter-spacing:-.01em}
button{font:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,select,textarea{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:11px 13px;width:100%;outline:none}
input:focus,select:focus,textarea:focus{border-color:var(--brand);box-shadow:0 0 0 3px var(--brandSoft)}
textarea{resize:vertical;min-height:88px}
label{display:block;font-size:13px;font-weight:600;color:var(--ink2);margin:12px 0 5px}
::placeholder{color:var(--ink3)}
.app{max-width:760px;margin:0 auto;min-height:100dvh;display:flex;flex-direction:column}
.hdr{position:sticky;top:0;z-index:30;background:var(--brand);color:#F7F3E3;padding:calc(env(safe-area-inset-top,0px) + 12px) 16px 12px;display:flex;align-items:center;gap:10px}
.hdr .logo{font-family:Georgia,serif;font-size:20px;font-weight:700}
.hdr .sub{font-size:12px;opacity:.75}
.main{flex:1;padding:16px 16px calc(84px + var(--safe-b));overflow-x:hidden}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px;box-shadow:var(--shadow);margin-bottom:12px}
.card h3{font-size:15px;margin-bottom:8px}
.row{display:flex;gap:10px;align-items:center}
.grow{flex:1}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--brand);color:#fff;border-radius:12px;padding:12px 18px;font-weight:600;font-size:15px;transition:transform .05s}
.btn:active{transform:scale(.97)}
.btn.sec{background:var(--surface2);color:var(--ink)}
.btn.danger{background:var(--danger)}
.btn.ghost{background:none;color:var(--brand);padding:8px 10px}
.btn.sm{padding:8px 12px;font-size:13px;border-radius:10px}
.btn.block{width:100%}
.btn:disabled{opacity:.45;cursor:default}
.pill{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:600;border-radius:99px;padding:3px 10px}
.pill.ok{background:var(--okSoft);color:var(--ok)} .pill.warn{background:var(--warnSoft);color:var(--warn)}
.pill.danger{background:var(--dangerSoft);color:var(--danger)} .pill.brand{background:var(--brandSoft);color:var(--brand)}
.pill.accent{background:var(--accentSoft);color:var(--accent)}
.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:760px;background:var(--surface);border-top:1px solid var(--border);display:flex;z-index:40;padding-bottom:var(--safe-b)}
.nav button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:9px 2px 7px;font-size:10.5px;color:var(--ink3);font-weight:600}
.nav button.on{color:var(--brand)}
.nav svg{width:23px;height:23px}
.tile{display:flex;flex-direction:column;gap:6px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px;box-shadow:var(--shadow);text-align:left;min-height:92px}
.tile .ic{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--brandSoft);color:var(--brand)}
.tile b{font-size:13.5px}
.tile span{font-size:11.5px;color:var(--ink2);line-height:1.35}
.list-item{display:flex;gap:12px;padding:12px 0;border-bottom:1px solid var(--border);align-items:flex-start}
.list-item:last-child{border-bottom:none}
.muted{color:var(--ink2);font-size:13px}
.tiny{color:var(--ink3);font-size:12px}
.section-title{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--ink3);margin:20px 0 8px}
.alert{border-radius:12px;padding:12px 14px;font-size:13.5px;line-height:1.5;margin-bottom:12px;border:1px solid}
.alert.warn{background:var(--warnSoft);border-color:var(--warn);color:var(--ink)}
.alert.danger{background:var(--dangerSoft);border-color:var(--danger);color:var(--ink)}
.alert.brand{background:var(--brandSoft);border-color:var(--brand);color:var(--ink)}
.chip{display:inline-block;background:var(--surface2);border:1px solid var(--border);border-radius:99px;padding:5px 12px;font-size:12.5px;margin:0 6px 6px 0}
.check{display:flex;align-items:center;gap:12px;padding:13px 4px;border-bottom:1px solid var(--border)}
.check:last-child{border-bottom:none}
.cbox{width:26px;height:26px;border-radius:8px;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;flex-shrink:0;background:var(--surface)}
.cbox.on{background:var(--ok);border-color:var(--ok);color:#fff}
.big-num{font-size:30px;font-weight:750;letter-spacing:-.02em}
.seg{display:flex;background:var(--surface2);border-radius:11px;padding:3px;gap:3px;margin-bottom:14px;overflow-x:auto}
.seg button{flex:1;padding:8px 10px;border-radius:9px;font-size:13px;font-weight:600;color:var(--ink2);white-space:nowrap}
.seg button.on{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.fab-note{position:fixed;bottom:calc(92px + var(--safe-b));right:max(16px,calc(50% - 364px));z-index:35;background:var(--accent);color:#fff;border-radius:16px;padding:14px 18px;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,.25);display:flex;gap:8px;align-items:center}
.fab-add{position:fixed;bottom:calc(92px + var(--safe-b));right:max(16px,calc(50% - 364px));z-index:36;background:var(--brand);color:#fff;border-radius:16px;padding:14px 18px;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,.25);display:flex;gap:8px;align-items:center}
.fab-add.up{bottom:calc(158px + var(--safe-b))}
.modal-bg{position:fixed;inset:0;background:rgba(10,20,18,.55);z-index:60;display:flex;align-items:flex-end;justify-content:center}
.modal{background:var(--bg);width:100%;max-width:760px;max-height:92dvh;border-radius:20px 20px 0 0;overflow-y:auto;padding:18px 16px calc(24px + var(--safe-b))}
.modal .grab{width:40px;height:4px;border-radius:2px;background:var(--border);margin:0 auto 14px}
.avatar{width:38px;height:38px;border-radius:50%;background:var(--brandSoft);color:var(--brand);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;flex-shrink:0}
.kv{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);font-size:14px}
.kv:last-child{border-bottom:none}
.kv b{text-align:right}
.search-hit mark{background:var(--warnSoft);color:inherit;border-radius:3px;padding:0 2px}
.login-wrap{min-height:100dvh;display:flex;flex-direction:column;justify-content:center;padding:24px;max-width:440px;margin:0 auto}
.spin{width:20px;height:20px;border:3px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:sp 1s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.toast{position:fixed;top:calc(env(safe-area-inset-top,0px) + 60px);left:50%;transform:translateX(-50%);background:var(--ink);color:var(--bg);border-radius:12px;padding:11px 18px;font-size:14px;font-weight:600;z-index:99;box-shadow:var(--shadow);max-width:90%}
@media(min-width:761px){.main{padding-left:24px;padding-right:24px}}
</style>
</head>
