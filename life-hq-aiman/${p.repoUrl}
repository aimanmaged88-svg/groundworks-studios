function daysAgo(iso){ if(!iso)return 9999; const[y,mm,d]=iso.split('-').map(Number); const a=new Date(y,mm-1,d); const t=new Date(); t.setHours(0,0,0,0); return Math.round((t-a)/86400000); }
function daysUntil(iso){ const n=-daysAgo(iso); return n<=0?'Today':n===1?'Tomorrow':n+'d'; }

