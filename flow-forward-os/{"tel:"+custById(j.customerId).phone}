function StaffPortal(props){
  const {tenant,ind,data,setData,session,onLogout,toast}=props;
  const me=data.team.find(m=>m.id===session.userId)||data.team[0];
  const [tab,setTab]=useState("today");
  const t=todayISO();
  const mine=data.jobs.filter(j=>j.assigneeId===me.id);
  const todayJobs=mine.filter(j=>j.date<=t && j.status!=="done");
  const upcoming=mine.filter(j=>j.date>t && j.status==="scheduled").sort((a,b)=>a.date.localeCompare(b.date));
  const doneJobs=mine.filter(j=>j.status==="done");
  const custById=id=>data.customers.find(c=>c.id===id)||{name:"—",phone:""};
  const upload=usePhotoUpload();

  const setStatus=(j,status)=>{
    setData(d=>{
      d.jobs=d.jobs.map(x=>x.id===j.id?{...x,status}:x);
      if(status==="done"){
        const c=custById(j.customerId);
        d.activity.unshift({id:uid(),text:me.name+" completed "+j.title,date:t,icon:"🏁"});
        runAutomations(d,"job_done",{customerName:c.name});
        if(j.value && !d.invoices.some(i=>i.jobId===j.id)){
          d.counters.invoice++;
          d.invoices.unshift({id:uid(),num:"INV-"+d.counters.invoice,customerId:j.customerId,jobId:j.id,title:j.title,amount:j.value,status:"sent",issuedAt:t,dueAt:addDays(t,14),paidAt:null,method:null});
        }
      }
      return d;
    });
    toast(status==="done"?"Job complete — office notified ✓":"Job started");
  };
  const addSitePhoto=j=>upload(url=>{
    setData(d=>{
      const pair=d.photos.find(p=>p.jobId===j.id);
      if(pair) d.photos=d.photos.map(p=>p.jobId===j.id?{...p, [p.before?"after":"before"]:url}:p);
      else d.photos.unshift({id:uid(),jobId:j.id,title:j.title,before:url,after:null,beforeGrad:"",afterGrad:"linear-gradient(135deg,#34D399,#059669)",date:t});
      return d;
    });
    toast("Site photo saved 📸");
  });

  const JobCard=({j,active})=><div className="card" style={{padding:16,marginBottom:11}}>
    <div className="spread" style={{marginBottom:6}}>
      <span className="tiny faint">{j.num} · {fmtDate(j.date)}</span><StatusBadge s={j.status}/>
    </div>
    <div style={{fontWeight:700,fontSize:15,marginBottom:2}}>{j.time} — {j.title}</div>
    <div className="tiny muted" style={{marginBottom:2}}>{custById(j.customerId).name}</div>
    <div className="tiny muted">📍 {j.address}</div>
    {j.notes&&<div className="tiny" style={{marginTop:8,padding:"9px 11px",background:"var(--bg)",borderRadius:8}}>📝 {j.notes}</div>}
    {active&&<div className="row" style={{marginTop:12}}>
      <a className="btn btn-ghost btn-sm" href={"tel:"+custById(j.customerId).phone}>📞 Call</a>
      <a className="btn btn-ghost btn-sm" href={"https://maps.google.com/?q="+encodeURIComponent(j.address)} target="_blank">🗺 Navigate</a>
      <button className="btn btn-ghost btn-sm" onClick={()=>addSitePhoto(j)}>📸 Photo</button>
      <div style={{flex:1}}/>
      {j.status==="scheduled"
        ? <button className="btn btn-primary btn-sm" onClick={()=>setStatus(j,"in_progress")}>Start job</button>
        : <button className="btn btn-primary btn-sm" onClick={()=>setStatus(j,"done")}>Complete ✓</button>}
    </div>}
  </div>;

  return <div style={{maxWidth:640,margin:"0 auto",padding:"0 14px 40px"}}>
    <div className="topbar" style={{margin:"0 -14px",padding:"12px 16px"}}>
      <div className="row">
        <div className="s-logo" style={{background:tenant.color}}>{initials(tenant.name)}</div>
        <div><div style={{fontWeight:700,fontSize:14}}>{tenant.name}</div><div className="tiny faint">Staff portal · {me.name}</div></div>
      </div>
      <button className="btn btn-ghost btn-sm" onClick={onLogout}>Sign out</button>
    </div>
    <div style={{padding:"18px 0 6px"}}>
      <div className="h1">G'day, {me.name.split(" ")[0]} 🦺</div>
      <div className="muted tiny">{todayJobs.length? "You've got "+todayJobs.length+" "+ind.jobNoun+(todayJobs.length>1?"s":"")+" on today.":"No "+ind.jobNoun+"s due today — check upcoming."}</div>
    </div>
    <div className="pills" style={{margin:"12px 0 16px"}}>
      {[["today","Today ("+todayJobs.length+")"],["upcoming","Upcoming ("+upcoming.length+")"],["done","Done ("+doneJobs.length+")"]].map(([k,l])=>
        <button key={k} className={"pill"+(tab===k?" active":"")} onClick={()=>setTab(k)}>{l}</button>)}
    </div>
    {tab==="today" && (todayJobs.length? todayJobs.map(j=><JobCard key={j.id} j={j} active/>) : <div className="card"><Empty icon="🎉" title="Nothing due" sub="Enjoy the breather or check upcoming."/></div>)}
    {tab==="upcoming" && (upcoming.length? upcoming.map(j=><JobCard key={j.id} j={j}/>) : <div className="card"><Empty icon="🗓" title="Nothing booked" sub="New assignments appear here."/></div>)}
    {tab==="done" && (doneJobs.length? doneJobs.map(j=><JobCard key={j.id} j={j}/>) : <div className="card"><Empty icon="🏁" title="No completed jobs yet" sub=""/></div>)}
  </div>;
}

/* ================================================================
   CUSTOMER PORTAL — quotes, payments (Stripe), job status, reviews
   ================================================================ */
function CustomerPortal(props){
  const {tenant,ind,data,setData,session,onLogout,toast}=props;
  const me=data.customers.find(c=>c.id===session.userId)||data.customers[0];
  const myQuotes=data.quotes.filter(q=>q.customerId===me.id && q.status!=="draft");
  const myJobs=data.jobs.filter(j=>j.customerId===me.id);
  const myInv=data.invoices.filter(i=>i.customerId===me.id);
  const due=myInv.filter(i=>i.status!=="paid");
  const [viewQuote,setViewQuote]=useState(null);
  const [pay,setPay]=useState(null);
  const [rev,setRev]=useState(null);
  const [revF,setRevF]=useState({rating:5,text:""});

  const accept=(q,yes)=>{
    setData(d=>{
      d.quotes=d.quotes.map(x=>x.id===q.id?{...x,status:yes?"accepted":"declined"}:x);
      if(yes){
        d.activity.unshift({id:uid(),text:"Quote "+q.num+" accepted by "+me.name+" (portal)",date:todayISO(),icon:"✅"});
        runAutomations(d,"quote_accepted",{customerId:me.id,title:q.title,quoteId:q.id,num:q.num,total:q.total,address:me.address});
      }
      return d;
    });
    setViewQuote(null);
    toast(yes?"Quote accepted — we'll be in touch to confirm the booking! 🎉":"No worries — quote declined.");
  };
  const submitReview=()=>{
    setData(d=>{
      d.reviews.unshift({id:uid(),customerId:me.id,rating:revF.rating,text:revF.text,date:todayISO(),reply:null,platform:"Portal"});
      d.activity.unshift({id:uid(),text:"New "+revF.rating+"★ review from "+me.name,date:todayISO(),icon:"⭐"});
      return d;
    });
    setRev(null); setRevF({rating:5,text:""}); toast("Thanks for the review! ⭐");
  };

  if(viewQuote){
    const q=data.quotes.find(x=>x.id===viewQuote);
    return <div style={{maxWidth:640,margin:"0 auto",padding:"18px 14px 40px"}}>
      <button className="btn btn-ghost btn-sm" style={{marginBottom:12}} onClick={()=>setViewQuote(null)}>← Back</button>
      <QuoteDoc q={q} tenant={tenant} cust={me} readOnly onAccept={yes=>accept(q,yes)}/>
    </div>;
  }

  return <div style={{maxWidth:640,margin:"0 auto",padding:"0 14px 40px"}}>
    <div className="topbar" style={{margin:"0 -14px",padding:"12px 16px"}}>
      <div className="row">
        <div className="s-logo" style={{background:tenant.color}}>{initials(tenant.name)}</div>
        <div><div style={{fontWeight:700,fontSize:14}}>{tenant.name}</div><div className="tiny faint">Customer portal</div></div>
      </div>
      <button className="btn btn-ghost btn-sm" onClick={onLogout}>Sign out</button>
    </div>
    <div style={{padding:"18px 0 14px"}}>
      <div className="h1">Hi, {me.name.split(" ")[0]} 👋</div>
      <div className="muted tiny">Your quotes, bookings and payments with {tenant.name}.</div>
    </div>

    {due.length>0 && <div className="card" style={{padding:16,marginBottom:14,borderLeft:"3px solid var(--warn)"}}>
      <div className="h3" style={{marginBottom:10}}>💳 Payments due</div>
      {due.map(i=><div key={i.id} className="spread" style={{padding:"8px 0",borderTop:"1px solid var(--border)"}}>
        <div><div style={{fontWeight:600,fontSize:13}}>{i.num} · {i.title}</div><div className="tiny faint">Due {fmtDate(i.dueAt)}</div></div>
        <div className="row"><span className="money" style={{fontWeight:700}}>{fmt$(i.amount)}</span>
        <button className="btn btn-primary btn-sm" onClick={()=>setPay(i)}>Pay now</button></div>
      </div>)}
    </div>}

    {myQuotes.filter(q=>q.status==="sent").length>0 && <div className="card" style={{padding:16,marginBottom:14,borderLeft:"3px solid var(--accent)"}}>
      <div className="h3" style={{marginBottom:10}}>📄 Quotes awaiting your decision</div>
      {myQuotes.filter(q=>q.status==="sent").map(q=><div key={q.id} className="spread" style={{padding:"8px 0",borderTop:"1px solid var(--border)"}}>
        <div><div style={{fontWeight:600,fontSize:13}}>{q.num} · {q.title}</div><div className="tiny faint">{fmt$(q.total)} inc GST</div></div>
        <button className="btn btn-primary btn-sm" onClick={()=>setViewQuote(q.id)}>Review & accept</button>
      </div>)}
    </div>}

    <div className="card" style={{marginBottom:14}}>
      <div className="h3" style={{padding:"14px 16px 4px"}}>🗓 Your {ind.jobNoun}s</div>
      <div className="list">
        {myJobs.map(j=><div key={j.id} className="list-row">
          <div style={{flex:1}}><div style={{fontWeight:600,fontSize:13}}>{j.title}</div><div className="tiny faint">{fmtDateFull(j.date)} · {j.time}</div></div>
          <StatusBadge s={j.status}/>
          {j.status==="done"&&!data.reviews.some(r=>r.customerId===me.id&&r.text.includes(j.title))&&
            <button className="btn btn-ghost btn-sm" onClick={()=>{setRev(j);setRevF({rating:5,text:""});}}>⭐ Review</button>}
        </div>)}
        {myJobs.length===0&&<Empty icon="🗓" title="No bookings yet" sub="Accepted quotes become bookings automatically."/>}
      </div>
    </div>

    <div className="card">
      <div className="h3" style={{padding:"14px 16px 4px"}}>🧾 Payment history</div>
      <div className="list">
        {myInv.filter(i=>i.status==="paid").map(i=><div key={i.id} className="list-row">
          <div style={{flex:1}}><div style={{fontWeight:600,fontSize:13}}>{i.num} · {i.title}</div><div className="tiny faint">Paid {fmtDate(i.paidAt)} {i.method==="card"?"· 💳 card":"· 🏦 bank"}</div></div>
          <span className="money tiny" style={{fontWeight:700}}>{fmt$(i.amount)}</span>
        </div>)}
        {myInv.filter(i=>i.status==="paid").length===0&&<div className="empty tiny">No payments yet</div>}
      </div>
    </div>
    <div className="tiny faint" style={{textAlign:"center",marginTop:20}}>Powered by Flow Forward OS · Secure payments by Stripe</div>

    {pay && <StripeCheckout inv={pay} tenant={tenant} onClose={()=>setPay(null)} onPaid={()=>{
      setData(d=>{
        d.invoices=d.invoices.map(x=>x.id===pay.id?{...x,status:"paid",paidAt:todayISO(),method:"card"}:x);
        d.activity.unshift({id:uid(),text:"Invoice "+pay.num+" paid online via Stripe 💳",date:todayISO(),icon:"💳"});
        d.messages.unshift({id:uid(),to:me.name,channel:"email",auto:true,date:todayISO(),body:"Hi "+me.name.split(" ")[0]+", payment of "+fmt$(pay.amount)+" received — receipt attached. Thank you!"});
        return d;
      });
      setPay(null); toast("Payment successful — receipt emailed 🎉");
    }}/>}

    {rev && <Modal title={"Review: "+rev.title} onClose={()=>setRev(null)}>
      <Field label="Your rating">
        <div className="row" style={{gap:4}}>{[1,2,3,4,5].map(n=>
          <button key={n} style={{fontSize:30,color:n<=revF.rating?"#F79009":"var(--border-strong)"}} onClick={()=>setRevF({...revF,rating:n})}>★</button>)}</div>
      </Field>
      <Field label="Tell others about your experience"><textarea className="textarea" rows={3} autoFocus value={revF.text} onChange={e=>setRevF({...revF,text:e.target.value})}/></Field>
      <button className="btn btn-primary btn-lg" style={{width:"100%"}} disabled={!revF.text.trim()} onClick={submitReview}>Submit review</button>
    </Modal>}
  </div>;
}

/* Stripe-style checkout (simulated in V1; swaps to Stripe Checkout links in V2) */
function StripeCheckout({inv,tenant,onClose,onPaid}){
  const [card,setCard]=useState({num:"",exp:"",cvc:"",name:""});
  const [busy,setBusy]=useState(false);
  const fmtNum=v=>v.replace(/\D/g,"").slice(0,16).replace(/(.{4})/g,"$1 ").trim();
  const fmtExp=v=>{const d=v.replace(/\D/g,"").slice(0,4);return d.length>2?d.slice(0,2)+"/"+d.slice(2):d;};
  const ok=card.num.replace(/\s/g,"").length===16&&card.exp.length===5&&card.cvc.length>=3&&card.name.trim();
  const submit=()=>{ setBusy(true); setTimeout(onPaid,1400); };
  return <Modal title="Secure payment" onClose={busy?()=>{}:onClose}>
    <div className="card" style={{padding:14,marginBottom:16,boxShadow:"none",background:"var(--bg)"}}>
      <div className="spread"><span className="tiny muted">{inv.num} · {inv.title}</span><span className="money" style={{fontWeight:800,fontSize:18}}>{fmt$(inv.amount)}</span></div>
      <div className="tiny faint" style={{marginTop:3}}>Paying {tenant.name}</div>
    </div>
    <Field label="Card number"><input className="input" inputMode="numeric" placeholder="4242 4242 4242 4242" value={card.num} onChange={e=>setCard({...card,num:fmtNum(e.target.value)})}/></Field>
    <div className="grid2">
      <Field label="Expiry"><input className="input" inputMode="numeric" placeholder="MM/YY" value={card.exp} onChange={e=>setCard({...card,exp:fmtExp(e.target.value)})}/></Field>
      <Field label="CVC"><input className="input" inputMode="numeric" placeholder="123" value={card.cvc} onChange={e=>setCard({...card,cvc:e.target.value.replace(/\D/g,"").slice(0,4)})}/></Field>
    </div>
    <Field label="Name on card"><input className="input" value={card.name} onChange={e=>setCard({...card,name:e.target.value})}/></Field>
    <button className="btn btn-primary btn-lg" style={{width:"100%"}} disabled={!ok||busy} onClick={submit}>{busy?"Processing…":"Pay "+fmt$(inv.amount)}</button>
    <div className="tiny faint" style={{textAlign:"center",marginTop:12}}>🔒 256-bit encrypted · Powered by <b>Stripe</b> · Demo mode — use 4242 4242 4242 4242</div>
  </Modal>;
}

const IS_PUBLIC_LEAD_PAGE = new URLSearchParams(location.search).get("lead")==="1";
ReactDOM.createRoot(document.getElementById("root")).render(IS_PUBLIC_LEAD_PAGE? <PublicLeadForm/> : <App/>);
