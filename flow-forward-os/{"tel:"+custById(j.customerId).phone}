  return <Modal title={rate?"Edit service":"New service"} onClose={onClose}>
    <Field label="Service name"><input className="input" autoFocus value={f.name} onChange={e=>setF({...f,name:e.target.value})} placeholder="e.g. Colorbond fence supply & install"/></Field>
    <div className="grid2">
