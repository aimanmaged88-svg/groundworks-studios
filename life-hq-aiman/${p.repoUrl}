============================================================ */
let AC;
function sfx(type){
  if(!S.sound) return;
  try{
    AC = AC || new (window.AudioContext||window.webkitAudioContext)();
    if(AC.state==='suspended') AC.resume();
    const now=AC.currentTime;
    const notes={
      tap:[[520,.05,.05]],
      add:[[440,.06,.08],[660,.05,.12]],
      done:[[523,.06,.09],[784,.07,.16]],
      cash:[[880,.05,.06],[1175,.05,.12],[1568,.06,.2]],
      error:[[200,.14,.2]],
      pop:[[700,.05,.08]]
    }[type]||[[520,.05,.05]];
    notes.forEach(([freq,dur,when])=>{
      const o=AC.createOscillator(), g=AC.createGain();
      o.type=type==='error'?'sawtooth':'sine'; o.frequency.value=freq;
      g.gain.setValueAtTime(0,now+when);
      g.gain.linearRampToValueAtTime(type==='tap'?.06:.13,now+when+.012);
      g.gain.exponentialRampToValueAtTime(.0001,now+when+dur+.05);
      o.connect(g).connect(AC.destination);
      o.start(now+when); o.stop(now+when+dur+.08);
    });
  }catch(e){}
}

/* ============================================================
   CONFETTI  (celebration)
============================================================ */
function confetti(){
  const cv=$('#confetti'); if(!cv)return;
  const ctx=cv.getContext('2d'); const W=cv.width=innerWidth, H=cv.height=innerHeight;
  cv.style.display='block';
  const cols=['#3ec7c9','#5b8cff','#8a6bff','#2fd39a','#ffc24d','#ff9ec4'];
  const N=120, parts=[];
  for(let i=0;i<N;i++) parts.push({x:W/2+(Math.random()-.5)*120,y:H*.32,vx:(Math.random()-.5)*11,vy:Math.random()*-13-4,r:Math.random()*7+4,c:cols[i%cols.length],rot:Math.random()*6,vr:(Math.random()-.5)*.4,life:1});
  let t=0;
  (function frame(){
    ctx.clearRect(0,0,W,H); t++;
    parts.forEach(p=>{ p.vy+=.42; p.x+=p.vx; p.y+=p.vy; p.rot+=p.vr; p.life-=.008;
      ctx.save(); ctx.globalAlpha=Math.max(0,p.life); ctx.translate(p.x,p.y); ctx.rotate(p.rot);
      ctx.fillStyle=p.c; ctx.fillRect(-p.r/2,-p.r/2,p.r,p.r*1.5); ctx.restore(); });
    if(t<130) requestAnimationFrame(frame); else cv.style.display='none';
  })();
}

