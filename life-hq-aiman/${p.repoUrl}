/* ---- Google Calendar one-tap link ---- */
function gcalLink(e){
  const dt=(date,time)=>{ if(!time) return date.replace(/-/g,''); return date.replace(/-/g,'')+'T'+time.replace(':','')+'00'; };
  let s,en;
  if(e.start){ s=dt(e.date,e.start); en=dt(e.date, e.end||addMin(e.start,60)); }
  else { s=e.date.replace(/-/g,''); en=addDays(e.date,1).replace(/-/g,''); } // all-day
  const p=new URLSearchParams({action:'TEMPLATE',text:e.title,dates:`${s}/${en}`,details:e.note||('Added from Life HQ')});
  return 'https://calendar.google.com/calendar/render?'+p.toString();
}
/* ---- .ics export (import the lot into Google Calendar) ---- */
function exportICS(){
  if(!S.events.length){ toast('No events to export'); return; }
  const pad=n=>String(n).padStart(2,'0');
  const stamp=new Date().toISOString().replace(/[-:]/g,'').split('.')[0]+'Z';
  const fmt=(date,time)=> time? date.replace(/-/g,'')+'T'+time.replace(':','')+'00' : date.replace(/-/g,'');
  let ics='BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Life HQ//EN\r\nCALSCALE:GREGORIAN\r\n';
  S.events.forEach(e=>{
    ics+='BEGIN:VEVENT\r\n';
    ics+=`UID:${e.id}@lifehq\r\nDTSTAMP:${stamp}\r\n`;
    if(e.start){ ics+=`DTSTART:${fmt(e.date,e.start)}\r\nDTEND:${fmt(e.date, e.end||addMin(e.start,60))}\r\n`; }
    else { ics+=`DTSTART;VALUE=DATE:${fmt(e.date)}\r\nDTEND;VALUE=DATE:${fmt(addDays(e.date,1))}\r\n`; }
    ics+=`SUMMARY:${(typeIcon(e.type)+' '+e.title).replace(/,/g,'\\,')}\r\n`;
    if(e.note) ics+=`DESCRIPTION:${e.note.replace(/,/g,'\\,').replace(/\n/g,'\\n')}\r\n`;
    ics+='END:VEVENT\r\n';
  });
  ics+='END:VCALENDAR';
  const blob=new Blob([ics],{type:'text/calendar'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='life-hq-calendar.ics'; a.click();
  toast('Calendar exported — open it to import into Google');
}

