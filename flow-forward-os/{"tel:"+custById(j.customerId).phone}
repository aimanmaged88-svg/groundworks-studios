function ensureSeeded(){
  let tenants = DB.loadTenants();
  if(!tenants){ tenants = DEFAULT_TENANTS.map(t=>({...t})); DB.saveTenants(tenants); }
  tenants.forEach(t=>{
    const existing = DB.load(t.id);
    const isDemo = DEFAULT_TENANTS.some(d=>d.id===t.id);
    // refresh stale demo data on seed upgrades; NEVER touch user-created tenants
    if(!existing || (isDemo && (existing._v||1)!==SEED_V)) DB.save(t.id, seedData(t.industry, t.team||["Owner"]));
  });
  return tenants;
}

/* ---------------- automation engine ---------------------------- */
/* Automations are real: events raised by the app run enabled rules
   and produce actual in-app effects (messages, jobs, activity). */
function runAutomations(data, event, payload){
  const fired=[];
  data.automations.filter(a=>a.on && a.trigger===event).forEach(a=>{
    const t=todayISO();
    if(event==="lead_created"){
      data.messages.unshift({id:uid(),to:payload.name,channel:"sms",auto:true,date:t,
        body:"Hi "+payload.name.split(" ")[0]+", thanks for reaching out! We've received your enquiry and will call you within the hour. — "+payload.brandName});
      fired.push(a.name);
    }
    if(event==="quote_accepted"){
      data.counters.job++;
      data.jobs.unshift({id:uid(),num:"J-"+data.counters.job,customerId:payload.customerId,title:payload.title,
        quoteId:payload.quoteId,status:"scheduled",date:addDays(t,3),time:"8:00 AM",
        assigneeId:data.team[1]?.id||data.team[0]?.id,address:payload.address||"",notes:"Auto-created from accepted quote "+payload.num,value:Math.round(payload.total)});
      fired.push(a.name);
    }
    if(event==="job_done"){
      data.messages.unshift({id:uid(),to:payload.customerName,channel:"email",auto:true,date:t,
        body:"Hi "+payload.customerName.split(" ")[0]+", thanks for having us! If you were happy with the work we'd love a quick Google review — it means the world to a local business: g.page/review-link"});
      fired.push(a.name);
    }
    if(event==="invoice_overdue"){
      data.messages.unshift({id:uid(),to:payload.customerName,channel:"email",auto:true,date:t,
        body:"Hi "+payload.customerName.split(" ")[0]+", just a friendly reminder that invoice "+payload.num+" ("+fmt$(payload.amount)+") is now past due. You can pay securely online any time: pay.link/"+payload.num});
      fired.push(a.name);
    }
  });
  fired.forEach(n=>data.activity.unshift({id:uid(),text:"⚙️ Automation ran: "+n,date:todayISO(),icon:"⚙️"}));
  return fired;
}

/* ---------------- AI quote brain ------------------------------- */
function aiDraftQuote(desc, ind){
  const d=desc.toLowerCase();
  const items=[];
  // pull quantities like "25m", "40 m2", "3 gates", "2 rooms"
  const numNear = kw => {
    const idx=d.indexOf(kw); if(idx<0) return null;
    const window=d.slice(Math.max(0,idx-24), idx+kw.length+18);
    const m=window.match(/(\d+(?:\.\d+)?)\s*(?:m2|m²|sqm|m|x|hrs?|hours?|rooms?|panels?|zones?|gates?|points?|tiles?)?/);
    return m? parseFloat(m[1]) : null;
  };
  ind.rates.forEach(r=>{
    const hit=r.kw.find(k=>d.includes(k));
    if(hit){
      let qty=numNear(hit) || (r.unit==="m"||r.unit==="m²"? 20 : 1);
      if(qty>2000) qty=1; // phone numbers etc.
      items.push({id:uid(),name:r.name,qty,unit:r.unit,rate:r.rate});
    }
  });
  if(items.length===0){
    const lab=ind.rates.find(r=>r.name==="Labour")||ind.rates[ind.rates.length-1];
    items.push({id:uid(),name:ind.rates[0].name,qty:1,unit:ind.rates[0].unit,rate:ind.rates[0].rate});
    items.push({id:uid(),name:lab.name,qty:4,unit:lab.unit,rate:lab.rate});
  } else if(!items.some(i=>i.name==="Labour") && items.length<3){
    const lab=ind.rates.find(r=>r.name==="Labour");
    if(lab) items.push({id:uid(),name:lab.name,qty:3,unit:lab.unit,rate:lab.rate});
  }
  const notes = "Scope based on your description: \""+desc.trim().slice(0,140)+(desc.length>140?"…":"")+"\". Includes materials, workmanship guarantee and full site clean-up. Any variations quoted before work proceeds. Quote valid 30 days.";
  return {items,notes};
}

/* ---------------- payment reliability (internal, facts only) ---- */
/* Computed purely from invoice history. Shown ONLY in the owner HQ,
   never in the customer portal. States facts, draws no conclusions. */
function paymentProfile(data, custId){
  const inv = data.invoices.filter(i=>i.customerId===custId);
  const paid = inv.filter(i=>i.status==="paid");
  const daysLate = i => Math.round((new Date(i.paidAt)-new Date(i.dueAt))/86400000);
  const late = paid.filter(i=>i.paidAt && i.dueAt && daysLate(i)>0);
  const overdueNow = inv.filter(i=>i.status==="overdue").length;
  const owed = inv.filter(i=>i.status!=="paid").reduce((a,i)=>a+i.amount,0);
  const avgLate = late.length? Math.round(late.reduce((a,i)=>a+daysLate(i),0)/late.length) : 0;
  return { total:inv.length, paid:paid.length, late:late.length, avgLate, overdueNow, owed,
    flag: late.length>=2 || (overdueNow>=1 && late.length>=1) };
}
function PayHistoryBadge({p}){
  if(!p.flag) return null;
  return <span className="badge b-amber" title="Internal only — computed from invoice history, never shown to the customer">
    ⏱ {p.late} of {p.paid} paid late{p.avgLate?` · avg ${p.avgLate}d`:""}</span>;
}

