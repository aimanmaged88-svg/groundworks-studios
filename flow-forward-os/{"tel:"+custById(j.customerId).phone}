      <div><div className="h1">Customers</div><div className="muted tiny">Your CRM — every client, every {ind.jobNoun}, every dollar.</div></div>
      <button className="btn btn-primary no-print" onClick={()=>setModal("new")}>+ Add customer</button>
    </div>
    <input className="input" placeholder="Search name, suburb, email…" value={q} onChange={e=>setQ(e.target.value)} style={{marginBottom:14,maxWidth:420}}/>
    <div className="card"><div className="list">
      {shown.map(c=><div key={c.id} className="list-row clickable" onClick={()=>setView(c.id)}>
        <Avatar name={c.name}/>
        <div style={{flex:1,minWidth:0}}>
          <div style={{fontWeight:600}}>{c.name} {c.tags?.includes("VIP")&&<span className="badge b-accent" style={{marginLeft:4}}>VIP</span>} <PayHistoryBadge p={paymentProfile(data,c.id)}/></div>
          <div className="tiny muted" style={{whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis"}}>{c.address}</div>
