        { "name": "U12", "sort": 2, "min_age": 10, "max_age": 11 },
        { "name": "U14", "sort": 3, "min_age": 12, "max_age": 13 },
        { "name": "U16", "sort": 4, "min_age": 14, "max_age": 15 },
        { "name": "U18", "sort": 5, "min_age": 16, "max_age": 17 }
      ],
      "cases": [
        { "dob": "2018-01-01", "expect": "U10" },
        { "dob": "2017-01-01", "expect": "U10" },
        { "dob": "2016-12-31", "expect": "U12" },
        { "dob": "2015-06-15", "expect": "U12" },
        { "dob": "2014-12-31", "expect": "U14" },
        { "dob": "2013-02-28", "expect": "U14" },
