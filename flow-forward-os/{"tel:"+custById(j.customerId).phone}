/* one-tap payment chaser: number/email pre-populated, message pre-written,
   opens the phone's own SMS/email app and logs the send in the feed */
function ChaseModal({inv,cust,tenant,data,setData,toast,onClose}){
  const isOverdue=inv.status==="overdue";
  const first=(cust.name||"there").split(" ")[0];
  const smsBody="Hi "+first+", friendly reminder from "+tenant.name+": invoice "+inv.num+" ("+fmt$(inv.amount)+") "+(isOverdue?"was due "+fmtDate(inv.dueAt):"is due "+fmtDate(inv.dueAt))+". You can pay by card any time in your customer portal. Reply here if anything's up — thanks!";
  const emailBody="Hi "+first+",\n\nJust a friendly reminder that invoice "+inv.num+" for "+fmt$(inv.amount)+" "+(isOverdue?"was due on "+fmtDateFull(inv.dueAt):"is due on "+fmtDateFull(inv.dueAt))+".\n\nYou can pay securely by card in your customer portal, or reply to this email if you have any questions.\n\nThanks,\n"+tenant.name;
  const [channel,setChannel]=useState("sms");
  const [body,setBody]=useState(smsBody);
  const pickChannel=ch=>{ setChannel(ch); setBody(ch==="sms"?smsBody:emailBody); };
  const p=paymentProfile(data,cust.id);

  const log=note=>{
    setData(d=>{
      d.messages.unshift({id:uid(),to:cust.name,channel,body,date:todayISO(),auto:false});
      d.activity.unshift({id:uid(),text:"Payment "+(isOverdue?"chase":"reminder")+" sent for "+inv.num+" via "+channel.toUpperCase(),date:todayISO(),icon:"💬"});
      return d;
    });
    toast(note);
  };
  const send=()=>{
    const a=document.createElement("a");
    a.href = channel==="sms"
      ? "sms:"+cust.phone+"?&body="+encodeURIComponent(body)
      : "mailto:"+cust.email+"?subject="+encodeURIComponent("Payment reminder — invoice "+inv.num)+"&body="+encodeURIComponent(body);
    a.click();
    log(channel==="sms"?"Opening your SMS app 💬":"Opening your email app ✉️");
    onClose();
  };
  const copy=()=>{
    (navigator.clipboard?navigator.clipboard.writeText(body):Promise.reject()).then(
      ()=>log("Message copied — paste it anywhere 📋"),
      ()=>toast("Couldn't copy on this device"));
    onClose();
  };

  return <Modal title={isOverdue?"Chase payment":"Payment reminder"} onClose={onClose}>
    <div className="card" style={{padding:13,marginBottom:14,boxShadow:"none",background:"var(--bg)"}}>
      <div className="spread"><span className="tiny muted">{inv.num} · {inv.title}</span><span className="money" style={{fontWeight:800}}>{fmt$(inv.amount)}</span></div>
      <div className="tiny faint" style={{marginTop:2}}>{isOverdue?"Was due":"Due"} {fmtDateFull(inv.dueAt)}</div>
    </div>
    {p.flag && <div className="tiny" style={{background:"#FFFAEB",border:"1px solid #FEDF89",color:"#B54708",borderRadius:9,padding:"9px 12px",marginBottom:14}}>
      📊 <b>Payment history (visible only to you):</b> {cust.name} has paid {p.late} of {p.paid} invoices late (avg {p.avgLate} days past due).</div>}
    <Field label="Send via">
      <div className="row">
        <button className={"pill"+(channel==="sms"?" active":"")} onClick={()=>pickChannel("sms")}>💬 SMS</button>
        <button className={"pill"+(channel==="email"?" active":"")} onClick={()=>pickChannel("email")}>✉️ Email</button>
      </div>
    </Field>
    <Field label={channel==="sms"?"To (from their profile)":"To (from their profile)"}>
      <input className="input" readOnly value={channel==="sms"?(cust.phone||"no phone on file"):(cust.email||"no email on file")} style={{background:"var(--bg)",fontWeight:600}}/>
    </Field>
    <Field label="Message (edit if you like)">
      <textarea className="textarea" rows={5} value={body} onChange={e=>setBody(e.target.value)}/>
    </Field>
    <div className="row">
      <button className="btn btn-ghost btn-lg" onClick={copy}>📋 Copy</button>
      <button className="btn btn-primary btn-lg" style={{flex:1}} onClick={send} disabled={channel==="sms"?!cust.phone:!cust.email}>
        {channel==="sms"?"Open SMS app →":"Open email app →"}</button>
    </div>
    <div className="tiny faint" style={{textAlign:"center",marginTop:10}}>Opens on your phone with everything pre-filled — just hit send. Logged in your SMS & Email feed either way.</div>
  </Modal>;
}

/* ================================================================
