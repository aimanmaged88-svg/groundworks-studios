/* ---- scores (0–100, all computed locally from your own data) ---- */
function moneyScore(){
  const tm=thisMonthTxns();
  if(S.balance==null && !S.txns.length) return null;
  const inc=tm.filter(t=>t.type==='in').reduce((a,b)=>a+b.amount,0);
  const out=tm.filter(t=>t.type==='out').reduce((a,b)=>a+b.amount,0);
  let s=70;
  if(S.balance!=null){ const r=S.balance/(S.minBalance||2000); s = r>=1.5?88 : r>=1?78 : r>=.75?55 : r>=.4?35 : 15; }
  if(inc>0){ const keep=(inc-out)/inc; s += keep>=.3?10 : keep>=0?5 : keep>=-.2?-10 : -18; }
  if(S.goal&&S.goal.target>0) s += Math.min(8, Math.round(S.goal.saved/S.goal.target*8));
  return Math.max(0,Math.min(100,Math.round(s)));
}
function healthScore(){
  const h=H(); const any=h.water.length||h.meals.length||h.workouts.length||h.sleep.length||h.weight.length;
  if(!any) return null;
  const g=h.goals; let today=0;
  const wt=waterToday(); if(wt>=g.water)today+=1; else if(wt>0)today+=Math.min(.8,wt/g.water);
  if(mealsToday().length>=2)today+=1; else if(mealsToday().length)today+=.5;
  if(moveToday().length)today+=1;
  const sl=h.sleep.find(x=>x.date===hToday()||x.date===addDays(hToday(),-0)); if(sl&&sl.hours>=(g.sleep-1))today+=1; else if(sl)today+=.4;
  const streak=Math.min(7,healthStreak());
  return Math.max(0,Math.min(100,Math.round( (today/4)*58 + (streak/7)*42 )));
}
function weekHours(){
  let h=0; for(let i=0;i<7;i++){ h += +((S.workLog||{})[addDays(todayISO(),-i)]||0); }
  S.events.filter(e=>e.type==='shift'&&e.start&&e.end&&e.date>=addDays(todayISO(),-6)&&e.date<=todayISO()).forEach(e=>{
    const[a,b]=[e.start,e.end].map(x=>{const[hh,mm]=x.split(':').map(Number);return hh+mm/60;}); if(b>a)h+=b-a; });
  return Math.round(h*4)/4;
}
function workScore(){
  const hasData=S.tasks.length||Object.keys(S.workLog||{}).length||S.events.some(e=>e.type==='shift');
  if(!hasData) return null;
  let s=72;
  const open=S.tasks.filter(t=>!t.done);
  s -= open.filter(t=>t.due&&t.due<todayISO()).length*12;
  s -= open.filter(t=>t.due===todayISO()).length*4;
  if(S.tasks.length&&S.tasks.every(t=>t.done)) s+=15;
  if(weekHours()>0) s+=Math.min(12,Math.round(weekHours()));
  if(S.events.some(e=>e.type==='shift'&&e.date===todayISO())) s+=4;
  return Math.max(0,Math.min(100,Math.round(s)));
}
function M(d){ S.mind=S.mind||{}; const k=d||todayISO(); S.mind[k]=S.mind[k]||{}; const m=S.mind[k]; m.entries=m.entries||[]; m.habits=m.habits||[]; return m; }
function mindScore(){
  const today=(S.mind||{})[todayISO()];
  let past=0; for(let i=1;i<=6;i++){ const x=(S.mind||{})[addDays(todayISO(),-i)]; if(x&&(x.mood||(x.entries&&x.entries.length)||(x.habits&&x.habits.length)))past++; }
  const any=today&&(today.mood||(today.entries||[]).length||(today.habits||[]).length);
  if(!any&&!past) return null;
  let s=0;
  if(today&&today.mood) s+=20+(today.mood-3)*4;
  if(today) s+=Math.min(30,Math.round(((today.habits||[]).length/((S.habits||[]).length||4))*30));
  if(today) s+=Math.min(20,(today.entries||[]).length*8);
  s+=Math.round(past/6*30);
  return Math.max(0,Math.min(100,s));
}
function lifeScore(){
  const parts=[moneyScore(),healthScore(),workScore(),mindScore()].filter(x=>x!=null);
  if(!parts.length) return null;
  return Math.round(parts.reduce((a,b)=>a+b,0)/parts.length);
}

/* ---- gauge + pillar rings ---- */
let gaugeAnim;
function animateGauge(target){
  const arc=$('#gaugeArc'), num=$('#lifeNum'); if(!arc||!num) return;
  const c=2*Math.PI*64;
  if(target==null){ arc.style.strokeDashoffset=c; num.textContent='–'; num.dataset.v=0; return; }
  requestAnimationFrame(()=>{ arc.style.strokeDashoffset=c*(1-target/100); });
  const start=+(num.dataset.v||0), t0=performance.now();
  cancelAnimationFrame(gaugeAnim);
  const step=t=>{ const p=Math.min(1,(t-t0)/1000); const v=Math.round(start+(target-start)*(1-Math.pow(1-p,3))); num.textContent=v; num.dataset.v=v; if(p<1)gaugeAnim=requestAnimationFrame(step); };
  gaugeAnim=requestAnimationFrame(step);
}
function ringSVG(score,d){
  const r=(d-10)/2, c=2*Math.PI*r, off=score==null?c:c*(1-score/100);
  const col=score==null?'var(--line-2)':score>=75?'var(--green)':score>=50?'var(--amber)':'var(--red)';
  return `<svg width="${d}" height="${d}" viewBox="0 0 ${d} ${d}" style="transform:rotate(-90deg);flex:0 0 auto">
    <circle cx="${d/2}" cy="${d/2}" r="${r}" fill="none" stroke="var(--line)" stroke-width="4.5"/>
    <circle cx="${d/2}" cy="${d/2}" r="${r}" fill="none" stroke="${col}" stroke-width="4.5" stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${off}" style="transition:stroke-dashoffset .8s cubic-bezier(.2,.8,.2,1)"/>
    <text x="${d/2}" y="${d/2}" transform="rotate(90 ${d/2} ${d/2})" text-anchor="middle" dominant-baseline="central" fill="var(--white)" font-size="${Math.round(d*0.3)}" font-weight="800" font-family="Bricolage Grotesque">${score==null?'–':score}</text></svg>`;
}
function pillarCard(emoji,label,score,rows,view){
