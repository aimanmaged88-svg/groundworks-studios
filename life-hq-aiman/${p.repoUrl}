const GCAL_SCOPE='https://www.googleapis.com/auth/calendar.events';
const GCAL_CLIENT_ID='646637498618-07fqhnabg6f3t893apbdi9il389dgjtl.apps.googleusercontent.com'; // public OAuth client, safe to ship
