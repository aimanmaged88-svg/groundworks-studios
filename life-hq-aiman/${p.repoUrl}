    {id:'bal', text:S.balance!=null?`Stay above ${money(min)} balance`:'Set your account balance', done:(S.balance!=null&&S.balance>=min)||fd.includes('bal')},
    {id:'health', text:'Do one thing for your health', done:(waterToday()>0||mealsToday().length>0||moveToday().length>0)||fd.includes('health')},
    {id:'work', text:dueT?`Finish today’s work — ${dueT} due`:'Finish today’s work', done:dueT===0||fd.includes('work')},
    {id:'log', text:'Update your dashboard (log one thing)', done:anyToday||fd.includes('log')}
  ];
}
function toggleFocus(id){
  const fd=S.focusDone[todayISO()]=S.focusDone[todayISO()]||[];
  const i=fd.indexOf(id); if(i>=0)fd.splice(i,1); else{ fd.push(id); sfx('done'); }
  save(); renderHome();
}

/* ---- MIND ---- */
const MOODS=['😞','😕','😐','🙂','😄'];
function renderMind(){
  const m=M(), sc=mindScore();
  $('#mindBody').innerHTML=`
    <div class="card glass" style="display:flex;align-items:center;gap:15px;margin-bottom:14px">
      ${ringSVG(sc,62)}
      <div><b style="font-family:'Bricolage Grotesque';font-size:17px">${sc==null?'Start today':'Mind score '+sc}</b>
      <div class="tiny muted" style="margin-top:4px">Checking in counts more than feeling perfect.</div></div>
    </div>
    <div class="sechead"><h3>How are you feeling?</h3></div>
    <div class="moodrow">${MOODS.map((e,i)=>`<div class="mood ${m.mood===i+1?'on':''}" onclick="setMood(${i+1})">${e}</div>`).join('')}</div>
    <div class="grid2" style="margin-top:12px">
      <div class="card"><div class="tiny muted" style="font-weight:800;letter-spacing:.5px;margin-bottom:8px">⚡ ENERGY</div>
        <div class="row" style="gap:6px">${['Low','OK','High'].map(v=>`<div class="chip ${m.energy===v?'on':''}" style="flex:1;text-align:center" onclick="setMState('energy','${v}')">${v}</div>`).join('')}</div></div>
      <div class="card"><div class="tiny muted" style="font-weight:800;letter-spacing:.5px;margin-bottom:8px">🌡 STRESS</div>
        <div class="row" style="gap:6px">${['Low','OK','High'].map(v=>`<div class="chip ${m.stress===v?'on':''}" style="flex:1;text-align:center" onclick="setMState('stress','${v}')">${v}</div>`).join('')}</div></div>
    </div>
    <div class="sechead"><h3>Routines & habits</h3></div>
    <div class="card">${(S.habits||[]).map(hb=>{const on=m.habits.includes(hb);return `
      <div class="fitem" style="cursor:pointer" onclick="toggleHabit('${hb.replace(/'/g,"\\'")}')">
        <div class="check ${on?'on':''}" style="width:22px;height:22px">${on?'✓':''}</div>
        <div class="sp"><div class="t" style="${on?'opacity:.55':''}">${hb}</div></div></div>`;}).join('')}</div>
    <div class="sechead"><h3>Get it out of your head</h3></div>
    <div class="hgrid">
      <div class="qa" onclick="openEntry('journal','✍️ Journal','What happened today?')"><div class="ic">✍️</div><span>Journal</span></div>
      <div class="qa" onclick="openBreath()"><div class="ic">🌬</div><span>Breathing</span></div>
      <div class="qa" onclick="openEntry('dump','🧠 Brain dump','Everything rattling around up there…')"><div class="ic">🧠</div><span>Brain dump</span></div>
      <div class="qa" onclick="openEntry('gratitude','🙏 Gratitude','Three things you’re grateful for…')"><div class="ic">🙏</div><span>Gratitude</span></div>
      <div class="qa" onclick="openEntry('win','⭐ Today’s win','What went right today?')"><div class="ic">⭐</div><span>Win</span></div>
      <div class="qa" onclick="openEntry('reflect','🌙 Reflection','How did today go, honestly?')"><div class="ic">🌙</div><span>Reflect</span></div>
    </div>
    ${m.entries.length?`<div class="sechead"><h3>Today’s entries</h3></div><div class="card">${m.entries.map(e=>`
      <div class="fitem"><div class="ic">${e.icon}</div><div class="sp"><div class="t" style="white-space:pre-wrap;font-weight:500">${esc(e.text)}</div><div class="s">${e.time}</div></div></div>`).join('')}</div>`:''}`;
}
function setMood(v){ M().mood=v; save(); sfx('pop'); renderMind(); }
function setMState(k,v){ M()[k]=v; save(); sfx('tap'); renderMind(); }
function toggleHabit(hb){ const m=M(); const i=m.habits.indexOf(hb); if(i>=0)m.habits.splice(i,1); else{ m.habits.push(hb); sfx('done'); } save(); renderMind(); }
function openEntry(type,title,ph){
  sheet(`<h3>${title}</h3><div class="sub">No filter needed — it’s just for you.</div>
    <div class="field"><textarea id="entryText" placeholder="${ph}" style="min-height:130px" autofocus></textarea></div>
    <div class="btnrow"><button class="btn ghost" onclick="closeSheet()">Cancel</button><button class="btn" onclick="saveEntry('${type}','${title.split(' ')[0]}')">Save</button></div>`);
}
function saveEntry(type,icon){
  const v=$('#entryText').value.trim(); if(!v){toast('Write something first');return;}
  M().entries.push({icon,text:v,time:new Date().toLocaleTimeString('en-AU',{hour:'numeric',minute:'2-digit'}),type});
  save(); sfx('add'); closeSheet(); renderMind(); toast('Saved ✍️');
}
function openBreath(){
  sheet(`<div class="listening"><div class="listorb" style="animation:breathe 9s ease-in-out infinite">🌬</div>
    <h3>Breathe with the circle</h3><div class="sub">In as it grows … out as it shrinks. A few rounds is plenty.</div>
    <button class="btn" style="margin-top:16px" onclick="if(!M().habits.includes('🌬 Breathing exercise'))M().habits.push('🌬 Breathing exercise');save();closeSheet();sfx('done');toast('🧘 Well done');renderMind()">Done — I feel better</button></div>`);
}

/* ---- WORK: shift timer ---- */
function toggleShift(){
  if(!S.activeShift){ S.activeShift=Date.now(); save(); sfx('add'); toast('▶ Shift started — go get it'); }
  else{
    const hrs=Math.max(.25, Math.round((Date.now()-S.activeShift)/3600000*4)/4);
    S.workLog=S.workLog||{}; S.workLog[todayISO()]=(+S.workLog[todayISO()]||0)+hrs;
    S.activeShift=null; save(); sfx('cash'); toast(`⏹ Shift ended — ${hrs}h logged`);
  }
  if($('#v-work').classList.contains('active'))renderTasks();
}

/* ---- QUICK CAPTURE (⚡ say it like you'd say it to a mate) ---- */
const WORDNUM={one:1,two:2,three:3,four:4,five:5,six:6,seven:7,eight:8,nine:9,ten:10,eleven:11,twelve:12,half:.5};
function numFrom(s){ if(WORDNUM[s]!=null)return WORDNUM[s]; const n=parseFloat(s); return isNaN(n)?null:n; }
function quickCapture(){
  sheet(`<h3>⚡ Quick capture</h3><div class="sub">Say it like you'd say it to a mate — I'll file it.</div>
    <div class="field"><input id="qcInput" placeholder="e.g. got paid $900 · walked 5km · had lunch" autofocus onkeydown="if(event.key==='Enter')captureRoute(this.value)"></div>
    <div class="row" style="gap:8px"><button class="btn dark sm" style="flex:1" onclick="voiceStart()">🎤 Speak</button><button class="btn sm" style="flex:1" onclick="captureRoute($('#qcInput').value)">Add</button></div>
    <div class="fabnote">Money, meals, water, walks, workouts, sleep, work hours — one box for all of it.</div>`);
}
function finishCapture(msg){ sfx('done'); closeSheet(); toast(msg); renderHome(); if($('#v-health').classList.contains('active'))renderHealth(); }
function captureRoute(text){
  if(!text||!text.trim()){ toast('Say or type something'); return; }
  const raw=text.trim(), t=' '+raw.toLowerCase()+' ';
  // business ideas — "idea: meal prep app for gyms" / "business idea …"
  const im=raw.match(/^(?:business\s+)?ideas?\s*[:\-–]?\s+(.+)/i);
  if(im || / business idea /.test(t)){
    const title=(im?im[1]:raw.replace(/business idea/ig,'')).trim();
    if(title){ const cat=ideaCategory(title); S.ideas.unshift({id:uid(),title,note:'',cat,created:todayISO()});
      save(); sfx('done'); closeSheet(); toast(`💡 Filed under ${cat}`); if($('#v-proj').classList.contains('active'))renderIdeas(); return; }
  }
  // work hours
  let m=t.match(/work(?:ed)?\s+(?:for\s+)?([\w.]+)\s*(?:hours?|hrs?)/);
  if(m&&numFrom(m[1])!=null){ const hrs=numFrom(m[1]); S.workLog=S.workLog||{}; S.workLog[todayISO()]=Math.round(((+S.workLog[todayISO()]||0)+hrs)*4)/4; save(); sfx('done'); closeSheet(); toast(`💼 ${hrs}h logged — ${weekHours()}h this week`); renderHome(); if($('#v-work').classList.contains('active'))renderTasks(); return; }
  // walks / steps
  if(/(walk|jog|\bran\b|steps)/.test(t)){
    const km=t.match(/([\d.]+)\s*(?:km|k\b|kilometi?res?)/); const mins=t.match(/([\d.]+)\s*(?:min|minutes?)/);
    H().workouts.push({id:uid(),date:hToday(),type:/jog|\bran\b/.test(t)?'Run':'Walk',mins:mins?+mins[1]:0,cal:0,note:km?km[1]+'km':''});
    save(); finishCapture(km?`🚶 ${km[1]}km logged — legs earning their keep`:'🚶 Walk logged'); return;
  }
  if(/(water|hydrat)/.test(t)&&!/coconut/.test(t)){ const ml=t.match(/([\d]+)\s*ml/); addWater(ml?+ml[1]:250); closeSheet(); return; }
  if(/(breakfast|lunch|dinner|snack|\bate\b|meal|feed)/.test(t)){
    const type=/breakfast/.test(t)?'Breakfast':/lunch/.test(t)?'Lunch':/dinner/.test(t)?'Dinner':'Snack';
    const name=raw.replace(/\b(i|had|ate|a|an|my|for|just|some|the|breakfast|lunch|dinner|snack|meal)\b/ig,'').replace(/\s+/g,' ').trim();
    H().meals.push({id:uid(),date:hToday(),meal:type,name:name||type,cal:0,protein:0,carbs:0,fat:0});
    save(); finishCapture(`🍽️ ${type} logged`); return;
  }
  if(/(workout|gym|trained|training|boxing|swam|swim)/.test(t)){ H().workouts.push({id:uid(),date:hToday(),type:/box/.test(t)?'Boxing':/swim|swam/.test(t)?'Swim':'Gym',mins:0,cal:0,note:''}); save(); finishCapture('💪 Workout logged'); return; }
  if(/(slept|sleep)/.test(t)){ const sm=t.match(/([\d.]+)\s*(?:hours?|hrs?)/)||t.match(/slept\s+([\w.]+)/); const v=sm?numFrom(sm[1]):null;
    if(v){ const ex=H().sleep.find(x=>x.date===hToday()); if(ex)ex.hours=v; else H().sleep.push({id:uid(),date:hToday(),hours:v}); save(); finishCapture(`😴 ${v}h sleep logged`); return; } }
  if(/(meditat|breath)/.test(t)){ if(!M().habits.includes('🧘 Meditation'))M().habits.push('🧘 Meditation'); save(); finishCapture('🧘 Logged — nice reset'); return; }
  // default → money
  openMoneyEntry(null,null,parseMoneyVoice(raw));
}
reviewVoice=captureRoute; // mic + typed input both route through the smart capture

/* ---- SHOPPING RADAR (restock reminders + cart that builds over time) ---- */
function shopDue(){ return (S.shopping||[]).filter(it=>!it.inCart&&(!it.snooze||it.snooze<=todayISO())&&daysAgo(it.last)>=(it.every||7)); }
function renderShopCard(){
  const el=$('#shopCard'); if(!el)return;
  const due=shopDue(), cart=(S.shopping||[]).filter(i=>i.inCart);
  el.innerHTML=`<div class="card glass" style="margin-bottom:12px">
    <div class="row" onclick="openShopping()" style="cursor:pointer"><b style="font-family:'Bricolage Grotesque';font-size:14.5px">🛒 Shopping radar</b><span class="sp"></span><span class="tiny" style="color:var(--brand);font-weight:700">${cart.length} in cart · manage →</span></div>
    ${due.length?due.slice(0,3).map(it=>`
      <div class="fitem"><div class="ic">🔔</div>
        <div class="sp"><div class="t">${esc(it.name)}</div><div class="s">${it.last?`last ordered ${daysAgo(it.last)} days ago`:'not ordered yet'} — chuck it in the cart?</div></div>
        <button class="btn sm" style="width:auto;padding:8px 12px" onclick="cartAdd('${it.id}')">＋ Cart</button></div>`).join('')
      :`<div class="tiny muted" style="margin-top:9px">Nothing due right now. ${cart.length?'Cart’s building nicely — order when it’s worth it.':'All stocked. 👌'}</div>`}
  </div>`;
}
function cartAdd(id){ const it=S.shopping.find(x=>x.id===id); if(!it)return; it.inCart=true; it.snooze=''; save(); sfx('add'); toast(esc(it.name)+' → cart 🛒'); renderShopCard(); }
function cartRemove(id){ const it=S.shopping.find(x=>x.id===id); if(it)it.inCart=false; save(); openShopping(); renderShopCard(); }
function cartOrdered(){ S.shopping.forEach(it=>{ if(it.inCart){ it.last=todayISO(); it.inCart=false; } }); save(); sfx('cash'); confetti(); toast('Order logged — timers reset ✅'); openShopping(); renderShopCard(); }
function shopDel(id){ S.shopping=S.shopping.filter(x=>x.id!==id); save(); openShopping(); renderShopCard(); }
function wooliesLink(name){ return 'https://www.woolworths.com.au/shop/search/products?searchTerm='+encodeURIComponent(name); }
function openShopping(){
  const cart=(S.shopping||[]).filter(i=>i.inCart);
  sheet(`<h3>🛒 Shopping radar</h3><div class="sub">Build the cart over time — order when it’s worth the delivery.</div>
    ${cart.length?`<div class="sechead" style="margin:10px 2px 8px"><h3>In the cart (${cart.length})</h3></div>
    <div class="card">${cart.map(it=>`<div class="fitem"><div class="ic">🛒</div><div class="sp"><div class="t">${esc(it.name)}</div></div>
      <a class="tiny" style="color:var(--brand);font-weight:700;text-decoration:none;padding:6px" target="_blank" href="${wooliesLink(it.name)}">Woolies ↗</a>
      <div class="x" onclick="cartRemove('${it.id}')">✕</div></div>`).join('')}</div>
    <button class="btn" style="margin-top:10px" onclick="cartOrdered()">✅ Ordered — reset the timers</button>`:''}
    <div class="sechead" style="margin:16px 2px 8px"><h3>Watching</h3><a onclick="openShopItem()">+ Add item</a></div>
    <div class="card">${(S.shopping||[]).length?(S.shopping||[]).map(it=>`
      <div class="fitem"><div class="ic">${it.inCart?'🛒':'👀'}</div>
        <div class="sp"><div class="t">${esc(it.name)}</div><div class="s">every ${it.every||7} days · ${it.last?daysAgo(it.last)+'d since last order':'not ordered yet'}</div></div>
        ${!it.inCart?`<button class="btn sm dark" style="width:auto;padding:7px 11px" onclick="cartAdd('${it.id}');openShopping()">＋</button>`:''}
        <div class="x" onclick="shopDel('${it.id}')">✕</div></div>`).join(''):'<div class="empty">Add the things you buy regularly.</div>'}</div>
    <div class="fabnote">I can’t live-scan store prices from inside the app — but the Woolies links jump straight to each item, and you can ask me in chat anytime to hunt down the cheapest option for you.</div>
    <div class="btnrow"><button class="btn" onclick="closeSheet()">Done</button></div>`);
}
function openShopItem(){
  sheet(`<h3>👀 Watch an item</h3><div class="sub">I’ll remind you when it’s due again.</div>
    <div class="field"><label class="fl">Item</label><input id="siName" placeholder="e.g. Coconut water" autofocus></div>
    <div class="field"><label class="fl">You buy it about every… (days)</label><input id="siEvery" type="number" inputmode="numeric" value="7"></div>
    <div class="btnrow"><button class="btn ghost" onclick="openShopping()">Back</button><button class="btn" onclick="saveShopItem()">Watch it</button></div>`);
}
function saveShopItem(){
  const n=$('#siName').value.trim(); if(!n){toast('Name the item');return;}
  S.shopping.push({id:uid(),name:n,every:Math.max(1,+$('#siEvery').value||7),last:'',inCart:false});
  save(); sfx('add'); openShopping(); renderShopCard(); toast('Watching 👀');
}

/* ---- home insights (positive, from your own data) ---- */
function sumOutRange(from,to){ return S.txns.filter(t=>t.type==='out'&&t.date>=from&&t.date<=to).reduce((a,b)=>a+b.amount,0); }
function renderHomeInsights(){
  const el=$('#dashInsights'); if(!el)return;
  const ins=[];
  const wOut=sumOutRange(addDays(todayISO(),-6),todayISO());
  const prevAvg=sumOutRange(addDays(todayISO(),-27),addDays(todayISO(),-7))/3;
  if(wOut&&prevAvg) ins.push(wOut<prevAvg
    ? `💸 You've spent less than usual this week — about ${money(prevAvg-wOut)} under your average. 👏`
    : `💡 Spending's a touch above your average this week — nothing drastic, just worth knowing.`);
  if(!waterToday()) ins.push('💧 No water logged yet today — an easy first win.');
  const streak=healthStreak(); if(streak>=3) ins.push(`🔥 ${streak} days straight logging your health. Excellent consistency.`);
  if(S.goal&&S.goal.target>0&&S.goal.saved<S.goal.target) ins.push(`🎯 ${money(S.goal.target-S.goal.saved)} to go on “${esc(S.goal.name)}” — closer than you think.`);
  const due=shopDue(); if(due.length) ins.push(`🛒 ${due.length} restock item${due.length>1?'s are':' is'} due — the cart's ready to build.`);
  const m=(S.mind||{})[todayISO()]; if(m&&m.mood>=4) ins.push('🙂 Good mood logged today — ride the wave.');
  el.innerHTML = ins.length ? `<div class="sechead"><h3>✨ Noticing</h3></div><div class="card glass">${ins.slice(0,4).map(t=>`<div class="fitem"><div class="sp" style="font-size:13.5px;line-height:1.55">${t}</div></div>`).join('')}</div>` : '';
}

