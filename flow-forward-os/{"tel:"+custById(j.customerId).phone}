function Quotes(props){
  const {tenant,ind,data,setData,toast}=props;
  const [filter,setFilter]=useState("all");
  const [builder,setBuilder]=useState(false);
  const [view,setView]=useState(null);
  const custById=id=>data.customers.find(c=>c.id===id)||{name:"—"};
  const shown=data.quotes.filter(q=>filter==="all"||q.status===filter);

  const setStatus=(q,status)=>{
    setData(d=>{
      d.quotes=d.quotes.map(x=>x.id===q.id?{...x,status}:x);
      if(status==="accepted"){
        const c=custById(q.customerId);
        d.activity.unshift({id:uid(),text:"Quote "+q.num+" accepted by "+c.name,date:todayISO(),icon:"✅"});
        runAutomations(d,"quote_accepted",{customerId:q.customerId,title:q.title,quoteId:q.id,num:q.num,total:q.total,address:c.address});
      }
      return d;
    });
    toast(status==="accepted"?"Accepted — job auto-created ⚙️":"Quote "+status);
  };

  if(view){
    const q=data.quotes.find(x=>x.id===view); if(!q){setView(null);return null;}
    return <QuoteDoc q={q} tenant={tenant} cust={custById(q.customerId)} onBack={()=>setView(null)} onStatus={s=>setStatus(q,s)} toast={toast}/>;
  }

  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Quotes</div><div className="muted tiny">Describe the job in plain English — AI drafts the quote in seconds.</div></div>
      <button className="btn btn-primary no-print" onClick={()=>setBuilder(true)}>✨ New AI quote</button>
    </div>
    <div className="pills" style={{marginBottom:14}}>
      {["all","draft","sent","accepted","declined"].map(s=><button key={s} className={"pill"+(filter===s?" active":"")} onClick={()=>setFilter(s)}>{s[0].toUpperCase()+s.slice(1)}</button>)}
    </div>
    <div className="card"><div className="list">
      {shown.map(q=><div key={q.id} className="list-row clickable" onClick={()=>setView(q.id)}>
        <div style={{flex:1,minWidth:0}}>
          <div style={{fontWeight:600}}>{q.num} · {q.title}</div>
          <div className="tiny muted">{custById(q.customerId).name} · {fmtDate(q.createdAt)}</div>
        </div>
        <span className="money" style={{fontWeight:700}}>{fmt$(q.total)}</span>
        <StatusBadge s={q.status}/>
      </div>)}
      {shown.length===0 && <Empty icon="📄" title="No quotes here" sub="Win more work by quoting the same day." action={<button className="btn btn-primary btn-sm" onClick={()=>setBuilder(true)}>✨ Create with AI</button>}/>}
    </div></div>
    {builder && <QuoteBuilder {...props} onClose={()=>setBuilder(false)} onCreated={id=>{setBuilder(false);setView(id);}}/>}
  </React.Fragment>;
}

function QuoteBuilder({tenant,ind,data,setData,toast,onClose,onCreated}){
  const [step,setStep]=useState(1);
  const [desc,setDesc]=useState("");
  const [custId,setCustId]=useState(data.customers[0]?.id||"");
  const [draft,setDraft]=useState(null);
  const [thinking,setThinking]=useState(false);

  const generate=()=>{
    setThinking(true);
    setTimeout(()=>{ setDraft(aiDraftQuote(desc,ind)); setThinking(false); setStep(2); },900);
  };
  const upd=(i,patch)=>setDraft(d=>({...d,items:d.items.map((it,idx)=>idx===i?{...it,...patch}:it)}));
  const addItem=name=>{ const r=ind.rates.find(x=>x.name===name); setDraft(d=>({...d,items:[...d.items,{id:uid(),name:r.name,qty:1,unit:r.unit,rate:r.rate}]})); };
  const sub=draft? draft.items.reduce((a,i)=>a+i.qty*i.rate,0):0;

  const saveQuote=status=>{
    let newId;
    setData(d=>{
      d.counters.quote++;
      const q={id:uid(),num:"Q-"+d.counters.quote,customerId:custId,title:draft.items[0].name,items:draft.items,notes:draft.notes,
        status,createdAt:todayISO(),subtotal:sub,gst:sub*GST,total:sub*(1+GST)};
      newId=q.id; d.quotes.unshift(q);
      if(status==="sent"){
        const c=d.customers.find(x=>x.id===custId);
        d.messages.unshift({id:uid(),to:c.name,channel:"email",auto:false,date:todayISO(),
          body:"Hi "+c.name.split(" ")[0]+", your quote "+q.num+" ("+fmt$(q.total)+" inc GST) is ready — view and accept it any time in your customer portal."});
        d.activity.unshift({id:uid(),text:"Quote "+q.num+" sent to "+c.name,date:todayISO(),icon:"📤"});
      }
      return d;
    });
    toast(status==="sent"?"Quote sent to customer portal 📤":"Draft saved");
    onCreated(newId);
  };

  return <Modal title={step===1?"✨ AI Quote Generator":"Review AI draft"} onClose={onClose} wide>
    {step===1 && <React.Fragment>
      <Field label="Customer">
        <select className="select" value={custId} onChange={e=>setCustId(e.target.value)}>
          {data.customers.map(c=><option key={c.id} value={c.id}>{c.name} — {c.address}</option>)}
        </select>
      </Field>
      {(()=>{ const p=paymentProfile(data,custId); const c=data.customers.find(x=>x.id===custId);
        return p.flag? <div className="tiny" style={{background:"#FFFAEB",border:"1px solid #FEDF89",color:"#B54708",borderRadius:9,padding:"9px 12px",margin:"-4px 0 14px"}}>
          📊 <b>Payment history (visible only to you):</b> {c?.name} has paid {p.late} of {p.paid} invoices late (avg {p.avgLate} days). Consider a deposit upfront in the quote terms.</div> : null; })()}
      <Field label="Describe the job (plain English — sizes help)">
        <textarea className="textarea" autoFocus rows={4} value={desc} onChange={e=>setDesc(e.target.value)}
          placeholder={tenant.industry==="fencing"?"e.g. Remove 25m of old timber fence and install new colorbond fence, plus 1 gate":"Describe the work, quantities and any details…"}/>
      </Field>
      <div className="tiny faint" style={{marginBottom:14}}>AI matches your description against {tenant.name}'s rate card ({ind.rates.length} services) and drafts line items, quantities and terms. You review everything before it's sent.</div>
      <button className="btn btn-primary btn-lg" style={{width:"100%"}} disabled={!desc.trim()||thinking} onClick={generate}>{thinking?"Thinking…":"✨ Generate quote"}</button>
    </React.Fragment>}

    {step===2 && draft && <React.Fragment>
      <div className="tiny" style={{background:"color-mix(in srgb,var(--accent) 8%,white)",border:"1px solid color-mix(in srgb,var(--accent) 25%,white)",borderRadius:9,padding:"9px 12px",marginBottom:14}}>
        ✨ AI drafted {draft.items.length} line item{draft.items.length>1?"s":""} from your description. Adjust quantities or rates below — nothing sends until you say so.</div>
      {draft.items.map((it,i)=><div key={it.id} className="row" style={{marginBottom:8,alignItems:"flex-end"}}>
        <div style={{flex:1}}><label className="label">{i===0?"Item":""}</label><input className="input" value={it.name} onChange={e=>upd(i,{name:e.target.value})}/></div>
        <div style={{width:76}}><label className="label">{i===0?"Qty":""}</label><input type="number" className="input" value={it.qty} onChange={e=>upd(i,{qty:+e.target.value||0})}/></div>
        <div style={{width:96}}><label className="label">{i===0?"Rate":""}</label><input type="number" className="input" value={it.rate} onChange={e=>upd(i,{rate:+e.target.value||0})}/></div>
        <button className="x" onClick={()=>setDraft(d=>({...d,items:d.items.filter((_,x)=>x!==i)}))}>✕</button>
      </div>)}
      <select className="select" style={{marginBottom:14}} value="" onChange={e=>{if(e.target.value)addItem(e.target.value)}}>
        <option value="">+ Add service from rate card…</option>
        {ind.rates.map(r=><option key={r.name} value={r.name}>{r.name} ({fmt$(r.rate)}/{r.unit})</option>)}
      </select>
      <Field label="Notes & terms"><textarea className="textarea" rows={3} value={draft.notes} onChange={e=>setDraft(d=>({...d,notes:e.target.value}))}/></Field>
      <div className="card" style={{padding:14,marginBottom:14,boxShadow:"none"}}>
        <div className="spread tiny"><span className="muted">Subtotal</span><span className="money">{fmt$(sub)}</span></div>
        <div className="spread tiny" style={{margin:"4px 0"}}><span className="muted">GST 10%</span><span className="money">{fmt$(sub*GST)}</span></div>
        <div className="spread" style={{fontWeight:800,fontSize:16}}><span>Total inc GST</span><span className="money">{fmt$(sub*(1+GST))}</span></div>
      </div>
      <div className="row">
        <button className="btn btn-ghost btn-lg" onClick={()=>setStep(1)}>← Re-describe</button>
        <button className="btn btn-ghost btn-lg" style={{flex:1}} onClick={()=>saveQuote("draft")} disabled={!draft.items.length}>Save draft</button>
        <button className="btn btn-primary btn-lg" style={{flex:2}} onClick={()=>saveQuote("sent")} disabled={!draft.items.length}>Send to customer →</button>
      </div>
    </React.Fragment>}
  </Modal>;
}

function QuoteDoc({q,tenant,cust,onBack,onStatus,toast,readOnly,onAccept}){
  return <React.Fragment>
    {!readOnly && <div className="spread no-print" style={{marginBottom:14}}>
      <button className="btn btn-ghost btn-sm" onClick={onBack}>← Quotes</button>
      <div className="row">
        {q.status==="draft" && <button className="btn btn-primary btn-sm" onClick={()=>onStatus("sent")}>Send to customer</button>}
        {q.status==="sent" && <React.Fragment>
          <button className="btn btn-ghost btn-sm" onClick={()=>onStatus("declined")}>Mark declined</button>
          <button className="btn btn-primary btn-sm" onClick={()=>onStatus("accepted")}>Mark accepted</button>
        </React.Fragment>}
        <button className="btn btn-ghost btn-sm" onClick={()=>window.print()}>🖨 Print / PDF</button>
