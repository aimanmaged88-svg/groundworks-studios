/* ================= DATA LAYER (local-first, Supabase-ready) ================= */
function useStore(key, seed){
  const [data,setData] = useState(()=>LS.get(key,seed));
  const save = useCallback((next)=>{
    setData(prev=>{
      const v = typeof next==="function" ? next(prev) : next;
      LS.set(key,v);
      return v;
    });
  },[key]);
  return [data,save];
}
function getSupabase(){
  const cfg = LS.get("sbcfg",null);
  if(!cfg || !cfg.url || !cfg.key) return null;
  try{ return window.supabase.createClient(cfg.url, cfg.key); }catch(e){ return null; }
}

/* ================= AUDIT (local trail; Supabase triggers cover cloud) ================= */
function audit(actor, action, detail){
  const log = LS.get("audit",[]);
  log.unshift({at:new Date().toISOString(), actor, action, detail});
  LS.set("audit", log.slice(0,2000));
}

/* ================= NDIS NOTE GENERATOR (~2000 chars) ================= */
function generateNote(s, user){
  const p = "Muhamad";
  const parts = [];
  const dateLine = new Date().toLocaleDateString("en-AU",{weekday:"long",day:"numeric",month:"long",year:"numeric"});
  parts.push(`PROGRESS NOTE — ${dateLine}. Shift: ${s.shiftType||"day"} (${s.start||"start"}–${s.end||"end"}). Support worker: ${user.name}.`);

  const moodMap = {
    calm:"presented as calm and settled throughout the shift, with no behaviours of concern observed",
    happy:"presented in a positive and cheerful mood, engaging warmly with the support worker",
    tired:"appeared tired, and this was reflected in his overall mood and energy across the shift",
    flat:"presented with a flat affect and low motivation, requiring gentle, low-pressure encouragement",
    agitated:"showed periods of agitation; early warning signs were observed and de-escalation strategies from the BSP were applied",
    distressed:"experienced a period of significant distress during the shift (see incident/detail below); staff followed the BSP by stopping demands, giving space and using minimal calm words"
  };
  parts.push(`${p} ${moodMap[s.mood]||"presented as settled"}.`);

  if(s.meals) parts.push(`Nutrition: ${s.meals.trim()} Consistent with his known pattern, staff encouraged storing unfinished food and fluids in the fridge.`);
  if(s.fluids) parts.push(`Fluids: ${s.fluids.trim()}`);

  if(s.medsGiven==="given") parts.push(`Medication: all scheduled medication was supported and accepted at the scheduled times using calm wording, and recorded in the medication log.`);
  else if(s.medsGiven==="refused") parts.push(`Medication: ${p} declined medication when offered. In line with the BSP, staff did not pressure or repeat the request, re-approached later, and notified the Case Manager/office immediately. The refusal has been logged and an incident report completed.`);
  else if(s.medsGiven==="partial") parts.push(`Medication: medication was partially supported this shift — see medication log for detail; the Case Manager has been advised of any missed doses.`);

  if(s.hygiene) parts.push(`Hygiene and self-care: ${s.hygiene.trim()}`);
  if(s.prayer) parts.push(`Religious and cultural support: ${s.prayer.trim()} Prayer times were respected and never interrupted.`);
  if(s.community) parts.push(`Community access: ${s.community.trim()}`);
  if(s.household) parts.push(`Household: ${s.household.trim()}`);
  if(s.smoking) parts.push(`Smoking/fire safety: ${s.smoking.trim()} Stove use was supervised and a fire-safety check completed.`);
  if(s.money) parts.push(`Money handling: ${s.money.trim()} All purchases were recorded on the daily reconciliation form with receipts photographed and sent to his sister as required.`);
  if(s.warnings) parts.push(`Early warning signs observed: ${s.warnings.trim()} Staff responded by stopping the demand, reducing talking and giving space, re-approaching once ${p} was calm ("That's okay, we can come back to that later").`);
  if(s.incidents) parts.push(`Incident: ${s.incidents.trim()} A separate incident report has been completed and the office notified.`);
  if(s.goals) parts.push(`Progress toward goals: ${s.goals.trim()}`);
  if(s.other) parts.push(s.other.trim());

  parts.push(`Handover: the money pouch, keys and reconciliation form were handed to the incoming worker, and outstanding items were communicated. ${p}'s routine, dignity and cultural needs were supported in line with his Interim Behaviour Support Plan throughout the shift.`);

  let note = parts.join(" ");
  if(note.length > 2050){
    note = note.slice(0,2000);
    note = note.slice(0, note.lastIndexOf(".")+1);
  }
  return note;
}

/* ================= QUICK ADD — the app reads plain words and files them ================= */
const CAT_LABEL = {
  task:"📝 Note / task", appointment:"📍 Appointment", outing:"🚗 Outing / plan",
  supplies:"🛒 Shopping / supplies", meds:"💊 Medication", money:"💰 Money",
  handover:"🤝 Handover note", incident:"⚠️ Incident-related"
};

function understand(raw){
  const text = raw.trim();
  const lower = " "+text.toLowerCase()+" ";
  const out = {raw:text};

  // when — day
  const base = new Date(); const d = new Date(base);
  const dayNames = ["sunday","monday","tuesday","wednesday","thursday","friday","saturday"];
  if(lower.includes("tomorrow")) d.setDate(d.getDate()+1);
  else for(let i=0;i<7;i++){ if(lower.includes(" "+dayNames[i])){ d.setDate(d.getDate()+((i-base.getDay()+7)%7)); break; } }
  out.day = localDay(d);

  // when — time
  let time = "";
  let m = text.match(/\b(\d{1,2})(?:[:.](\d{2}))?\s*(am|pm)\b/i);
  if(m){ let h = parseInt(m[1],10)%12; if(m[3].toLowerCase()==="pm") h+=12; time = String(h).padStart(2,"0")+":"+(m[2]||"00"); }
  else if((m = text.match(/\b(\d{1,2}):(\d{2})\b/))){ time = m[1].padStart(2,"0")+":"+m[2]; }
  else if(lower.includes("morning")) time = "09:00";
  else if(lower.includes("afternoon")) time = "14:00";
  else if(lower.includes("tonight")||lower.includes("evening")) time = "18:00";
  out.time = time;

  // what kind of thing this is
  const CATS = [
    ["appointment",["haircut","barber","doctor","dentist"," gp ","clinic","blood test","injection","appointment","appt","hospital","pharmacy","optometrist","specialist"]],
    ["outing",["take him","take muhamad","go to","going to","visit","see his","seeing his","mosque","shopping","coffee","kmart","park ","drive","pick up","drop off","outing"]],
    ["supplies",["buy ","need more","out of","running low","low on","get more","groceries","need to get","restock"]],
    ["meds",["medication","meds","clozapine","candesartan","tablet","dose","script"]],
    ["money",["receipt","pouch","balance","reconcil","money form","cash"]],
    ["handover",["handover","next worker","next shift","tell the next","let the next"]],
    ["incident",["aggress","escalat","police","refus","punched","hit ","yell","left the property","missing","threat"]]
  ];
  out.category = "task";
  outer: for(const [k,kws] of CATS){ for(const kw of kws){ if(lower.includes(kw)){ out.category = k; break outer; } } }

  // who's involved
  const ppl = [];
  if(/sister|batoul/i.test(text)) ppl.push("his sister Batoul");
  if(/mother|mum|mom/i.test(text)) ppl.push("his mother");
  if(/\bangel\b/i.test(text)) ppl.push("Angel (Case Manager)");
  if(/\bdonya\b/i.test(text)) ppl.push("Donya");
  out.people = ppl;

  // order-of-events hint ("haircut so he can see his sister after")
  out.sequence = /after that|after the|then |straight after|so he can|before /i.test(text);

  // short title
  const KNOWN = {"haircut":"Haircut","blood test":"Blood test","injection":"Injection appointment","mosque":"Mosque","shopping":"Shopping","coffee":"Coffee outing","doctor":"Doctor","dentist":"Dentist","handover":"Handover note"};
  let title = "";
  for(const k in KNOWN){ if(lower.includes(k)){ title = KNOWN[k]; break; } }
  if(!title){
    title = text.split(/[.!\n]/)[0].trim();
    title = title.charAt(0).toUpperCase()+title.slice(1);
    if(title.length>60) title = title.slice(0,57)+"…";
  }
  out.title = title;
  return out;
}

function QuickAdd({open,onClose,user,setQuickItems,toast}){
  const [text,setText] = useState("");
  const [draft,setDraft] = useState(null);
  const [dirty,setDirty] = useState(false);
  useEffect(()=>{ if(!open){ setText(""); setDraft(null); setDirty(false); } },[open]);
  useEffect(()=>{
    if(dirty) return;
    if(text.trim().length>=4) setDraft(understand(text));
    else setDraft(null);
  },[text,dirty]);
  const set = k=>e=>{ setDirty(true); setDraft({...draft,[k]:e.target.value}); };
  const save = ()=>{
    if(!draft || !draft.title.trim()) return;
    const item = {id:uid(),raw:text.trim(),title:draft.title.trim(),category:draft.category,day:draft.day,time:draft.time,people:draft.people||[],done:false,by:user.name,at:new Date().toISOString()};
    setQuickItems(prev=>[item,...prev]);
    audit(user.name,"quick_add",{title:item.title,category:item.category});
    toast("Got it — it's on the plan ✓");
    onClose();
  };
  return <Modal open={open} onClose={onClose} title="Add anything">
    <p className="tiny" style={{marginBottom:10}}>Just type it the way you'd say it. The app works out the when, what and who — you can fix anything before saving.</p>
    <textarea autoFocus style={{minHeight:96}} placeholder='e.g. "Gotta take him for a haircut at 2 so he can see his sister after that"' value={text} onChange={e=>setText(e.target.value)}/>
    {draft && <div style={{marginTop:12}}>
      <div className="tiny" style={{fontWeight:700,letterSpacing:".05em",marginBottom:6}}>HERE'S HOW I READ IT — FIX ANYTHING</div>
      <div style={{marginBottom:4}}>
        <span className="pill brand" style={{marginRight:6}}>{CAT_LABEL[draft.category]}</span>
        <span className="pill accent" style={{marginRight:6}}>📅 {fmtDate(draft.day+"T12:00")}</span>
        {draft.time && <span className="pill warn">⏰ {t12(draft.time)}</span>}
      </div>
      {draft.people && draft.people.length>0 && <p className="tiny" style={{margin:"4px 0"}}>👥 Involves {draft.people.join(" and ")}</p>}
      {draft.sequence && <p className="tiny" style={{margin:"4px 0"}}>🔁 Sounds like one thing happens after another — your exact words are kept with it.</p>}
      {draft.category==="incident" && <div className="alert danger" style={{marginTop:8}}>This sounds like it could be an incident. Save it here as a reminder, but serious events still need an <b>incident report + phone call</b> to the office.</div>}
      <Field label="What"><input value={draft.title} onChange={set("title")}/></Field>
      <div className="grid2">
        <Field label="Day"><input type="date" value={draft.day} onChange={set("day")}/></Field>
        <Field label="Time (optional)"><input type="time" value={draft.time} onChange={set("time")}/></Field>
      </div>
      <Field label="File under">
        <select value={draft.category} onChange={set("category")}>
          {Object.entries(CAT_LABEL).map(([k,l])=><option key={k} value={k}>{l}</option>)}
        </select>
      </Field>
      <button className="btn block" style={{marginTop:14}} onClick={save}>Save to the plan</button>
    </div>}
  </Modal>;
}

