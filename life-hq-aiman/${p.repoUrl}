function voiceStart(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){ toast('Voice not supported here — type it'); openVoiceType(); return; }
  let rec; try{ rec=new SR(); }catch(e){ openVoiceType(); return; }
  rec.lang='en-AU'; rec.interimResults=false; rec.maxAlternatives=1;
  sheet(`<div class="listening"><div class="listorb">🎤</div><h3>Listening…</h3>
    <div class="sub">Try “I'm getting paid 2000 on the 15th” or “rent 600 due Friday”.</div>
