   CALENDAR
   ================================================================ */
function CalendarPage(props){
  const {data,setData,ind,toast}=props;
  const [ym,setYm]=useState(monthKey(todayISO()));
  const [sel,setSel]=useState(null);      // ISO date whose day-sheet is open
  const [editing,setEditing]=useState(null); // job object | "new" (opens JobModal)
  const [y,m]=ym.split("-").map(Number);
  const first=new Date(y,m-1,1); const startDow=(first.getDay()+6)%7; // Mon start
  const days=new Date(y,m,0).getDate();
  const cells=[]; for(let i=0;i<startDow;i++)cells.push(null); for(let d=1;d<=days;d++)cells.push(d);
  const iso=d=>ym+"-"+String(d).padStart(2,"0");
  const jobsOn=dISO=>data.jobs.filter(j=>j.date===dISO).sort((a,b)=>a.time.localeCompare(b.time));
  const shift=n=>{ const dt=new Date(y,m-1+n,1); setYm(dt.getFullYear()+"-"+String(dt.getMonth()+1).padStart(2,"0")); };
  const monthName=first.toLocaleDateString("en-AU",{month:"long",year:"numeric"});
  const custById=id=>data.customers.find(c=>c.id===id)||{name:"—"};
  const teamById=id=>data.team.find(t=>t.id===id)||{name:"Unassigned"};

  const save=j=>{
    setData(d=>{
      if(j.id) d.jobs=d.jobs.map(x=>x.id===j.id?j:x);
      else{ d.counters.job++; d.jobs.unshift({...j,id:uid(),num:"J-"+d.counters.job,status:"scheduled"}); }
      return d;
    });
    setEditing(null); toast(j.id?"Rescheduled ✓":"Booked in ✓");
  };
  const del=j=>{ setData(d=>{ d.jobs=d.jobs.filter(x=>x.id!==j.id); return d; }); setEditing(null); toast("Deleted"); };
  const monthCount=data.jobs.filter(j=>monthKey(j.date)===ym).length;

  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Calendar</div><div className="muted tiny">Tap any day to book a {ind.jobNoun} · tap a booking to edit, reschedule or remove.</div></div>
      <div className="row no-print">
        <button className="btn btn-ghost btn-sm" onClick={()=>setYm(monthKey(todayISO()))}>Today</button>
        <button className="btn btn-ghost btn-sm" onClick={()=>shift(-1)}>←</button>
        <span style={{fontWeight:700,minWidth:132,textAlign:"center"}}>{monthName}</span>
        <button className="btn btn-ghost btn-sm" onClick={()=>shift(1)}>→</button>
      </div>
    </div>
    <div className="tiny muted" style={{marginBottom:10}}>{monthCount} {ind.jobNoun}{monthCount===1?"":"s"} this month</div>
    <div className="cal">
      {["Mon","Tue","Wed","Thu","Fri","Sat","Sun"].map(d=><div key={d} className="cal-h">{d}</div>)}
      {cells.map((d,i)=>{
        if(!d) return <div key={i} className="cal-d off"/>;
        const dISO=iso(d); const evs=jobsOn(dISO); const isToday=dISO===todayISO();
        return <div key={i} className={"cal-d"+(isToday?" today":"")} onClick={()=>setSel(dISO)}>
          <span className="n">{d}</span>
          {evs.slice(0,2).map(e=><div key={e.id} className="cal-ev" onClick={ev=>{ev.stopPropagation();setEditing(e);}}>{e.time.replace(":00","").replace(" ","")} {e.title}</div>)}
          {evs.length>2&&<div className="tiny faint cal-ev" style={{background:"transparent"}}>+{evs.length-2} more</div>}
          {evs.length>0&&<span className="has"/>}
        </div>;
      })}
    </div>

    {sel && <Modal title={fmtDateFull(sel)} onClose={()=>setSel(null)}>
      {jobsOn(sel).length===0
        ? <Empty icon="🗓" title={"Nothing booked "+(sel===todayISO()?"today":"this day")} sub={"Add a "+ind.jobNoun+" to fill the day."}/>
        : jobsOn(sel).map(j=><div key={j.id} className="card clickable" style={{padding:14,marginBottom:9,boxShadow:"none"}} onClick={()=>setEditing(j)}>
            <div className="spread"><span style={{fontWeight:700}}>{j.time} — {j.title}</span><StatusBadge s={j.status}/></div>
            <div className="tiny muted" style={{marginTop:3}}>{custById(j.customerId).name}{j.address?" · "+j.address:""}</div>
            <div className="tiny faint" style={{marginTop:3}}>👷 {teamById(j.assigneeId).name} · {fmt$(j.value)} · tap to edit</div>
          </div>)}
      <button className="btn btn-primary btn-lg" style={{width:"100%",marginTop:4}} onClick={()=>setEditing("new")}>+ Add {ind.jobNoun} on this day</button>
    </Modal>}

    {editing && <JobModal job={editing==="new"?null:editing} data={data} ind={ind} defaultDate={sel||todayISO()} onSave={save} onDelete={del} onClose={()=>setEditing(null)}/>}
  </React.Fragment>;
}

