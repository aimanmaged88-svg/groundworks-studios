let taskFilter='Open';
function taskSort(a,b){
  const pr={high:0,med:1,low:2};
  if(!!a.done!==!!b.done) return a.done?1:-1;
  if((a.due||'9999')!==(b.due||'9999')) return (a.due||'9999').localeCompare(b.due||'9999');
  return (pr[a.priority]??1)-(pr[b.priority]??1);
}
function renderTasks(){
  const open=S.tasks.filter(t=>!t.done).length;
  $('#workSub').textContent = open?`${open} open task${open!==1?'s':''}`:'All clear ✨';
  const fs=['Open','All','Done'];
  $('#taskFilter').innerHTML=fs.map(f=>`<div class="chip ${f===taskFilter?'on':''}" onclick="taskFilter='${f}';renderTasks()">${f}</div>`).join('');
  let list=[...S.tasks];
  if(taskFilter==='Open') list=list.filter(t=>!t.done);
  if(taskFilter==='Done') list=list.filter(t=>t.done);
  list.sort(taskSort);
  const box=$('#taskList');
  if(!list.length){ box.innerHTML=`<div class="empty">${taskFilter==='Done'?'Nothing completed yet.':'No tasks. Add one above 👆'}</div>`; return; }
  box.innerHTML=list.map(t=>`
    <div class="task ${t.done?'done':''}">
      <div class="check ${t.done?'on':''}" onclick="toggleTask('${t.id}')">${t.done?'✓':''}</div>
      <div class="sp"><div class="tt">${esc(t.text)}</div>
        <div class="tm">
          ${t.projectId&&projName(t.projectId)?`<span class="pill blue" onclick="openProjectDetail('${t.projectId}')" style="cursor:pointer">${esc(projName(t.projectId))}</span>`:''}
          ${t.tag?`<span class="pill">${esc(t.tag)}</span>`:''}
          <span>${t.priority==='high'?'🔴 High':t.priority==='low'?'🟢 Low':'🟡 Med'}</span>
          ${t.due?`<span class="${dueClass(t.due,t.done)}">${dueLabel(t.due)}</span>`:''}
        </div></div>
      <div class="x" onclick="delTask('${t.id}')">✕</div>
    </div>`).join('');
  $('#workNotes').value=S.notes||'';
  const sb2=$('#shiftBtn'); if(sb2) sb2.innerHTML = S.activeShift ? '⏹ End shift' : '▶ Start shift';
  const wh=$('#wkHours'); if(wh) wh.textContent = weekHours()+'h';
}
