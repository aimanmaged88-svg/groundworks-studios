    {name:"Blocked drain clearing (jet)",unit:"drain",rate:320,kw:["block","drain","clog"]},
    {name:"Toilet supply & install",unit:"unit",rate:380,kw:["toilet","cistern"]},
    {name:"Pipe repair / relocation",unit:"hr",rate:130,kw:["pipe","leak","burst"]},
