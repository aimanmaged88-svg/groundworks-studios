function H(){ if(!S.health) S.health={goals:{water:3000,cal:2200,protein:160,sleep:8},water:[],meals:[],weight:[],workouts:[],sleep:[]}; const h=S.health; h.goals=h.goals||{water:3000,cal:2200,protein:160,sleep:8}; h.water=h.water||[]; h.meals=h.meals||[]; h.weight=h.weight||[]; h.workouts=h.workouts||[]; h.sleep=h.sleep||[]; return h; }
const hToday = () => todayISO();
function waterToday(){ return H().water.filter(w=>w.date===hToday()).reduce((a,b)=>a+(+b.ml||0),0); }
function mealsToday(){ return H().meals.filter(m=>m.date===hToday()); }
function calToday(){ return mealsToday().reduce((a,b)=>a+(+b.cal||0),0); }
function proteinToday(){ return mealsToday().reduce((a,b)=>a+(+b.protein||0),0); }
function moveToday(){ return H().workouts.filter(w=>w.date===hToday()); }
function ring(label, val, goal, unit, color){
  const pct=Math.max(0,Math.min(100, goal? Math.round(val/goal*100):0));
  return `<div class="ring"><div class="dial" style="background:conic-gradient(${color} ${pct*3.6}deg, var(--line) 0)">
    <b>${pct}%</b></div><div class="rl">${label}</div><div class="rv">${val}${unit} / ${goal}${unit}</div></div>`;
}
function healthStreak(){ // consecutive days (up to 30) with any log
  const h=H(); const days=new Set();
  [...h.water,...h.meals,...h.workouts,...h.weight,...h.sleep].forEach(x=>x.date&&days.add(x.date));
  let n=0, d=hToday();
