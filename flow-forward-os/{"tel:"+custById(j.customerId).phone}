function Avatar({name,size}){ return <div className="avatar" style={{background:avColor(name),width:size||34,height:size||34,fontSize:(size||34)*0.37}}>{initials(name)}</div>; }
function StatusBadge({s}){
  const map={new:["b-blue","New"],contacted:["b-amber","Contacted"],quoted:["b-purple","Quoted"],won:["b-green","Won"],lost:["b-red","Lost"],
    draft:["b-gray","Draft"],sent:["b-blue","Sent"],accepted:["b-green","Accepted"],declined:["b-red","Declined"],
    scheduled:["b-blue","Scheduled"],in_progress:["b-amber","In progress"],done:["b-green","Done"],
    paid:["b-green","Paid"],overdue:["b-red","Overdue"]};
  const [cls,label]=map[s]||["b-gray",s];
  return <span className={"badge "+cls}>{label}</span>;
}
function Toggle({on,onChange}){ return <button className={"switch"+(on?" on":"")} onClick={onChange} aria-label="toggle"/>; }
function Stars({n,size}){ return <span style={{color:"#F79009",fontSize:size||14,letterSpacing:1}}>{"★".repeat(n)}<span style={{color:"var(--border-strong)"}}>{"★".repeat(5-n)}</span></span>; }

/* simple SVG bar chart */
function BarChart({series,height=150,money=true,onBar}){
  const max=Math.max(...series.map(s=>s.v),1);
  const bw=100/series.length;
  return <div style={{position:"relative"}}>
    <svg viewBox={"0 0 100 "+ (height/3)} style={{width:"100%",height}} preserveAspectRatio="none">
      {series.map((s,i)=>{
        const h=Math.max(1.5,(s.v/max)*(height/3-10));
        return <rect key={i} className={"bar"+(i===series.length-1?"":" dim")} x={i*bw+bw*0.18} y={height/3-h} width={bw*0.64} height={h} rx="1.4"/>;
      })}
    </svg>
    {onBar && <div style={{position:"absolute",inset:0,display:"flex"}}>
      {series.map((s,i)=><button key={i} title={s.l+": "+fmt$(s.v)} onClick={()=>onBar(i)} style={{flex:1,background:"transparent",cursor:"pointer"}}/>)}
    </div>}
    <div style={{display:"flex"}}>
      {series.map((s,i)=><div key={i} style={{flex:1,textAlign:"center"}} className="tiny faint">{s.l}</div>)}
    </div>
  </div>;
}
function Donut({parts,size=120}){
  const total=parts.reduce((a,p)=>a+p.v,0)||1;
  let acc=0; const r=15.9, c=2*Math.PI*r;
  return <svg viewBox="0 0 42 42" style={{width:size,height:size}}>
    <circle cx="21" cy="21" r={r} fill="none" stroke="var(--border)" strokeWidth="5"/>
    {parts.map((p,i)=>{
      const frac=p.v/total, off=acc; acc+=frac;
      return <circle key={i} cx="21" cy="21" r={r} fill="none" stroke={p.c} strokeWidth="5"
        strokeDasharray={`${frac*c} ${c}`} strokeDashoffset={-off*c} transform="rotate(-90 21 21)" strokeLinecap="butt"/>;
    })}
  </svg>;
}

