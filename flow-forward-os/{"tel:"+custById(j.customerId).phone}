function usePhotoUpload(){
  return (cb)=>{
    const inp=document.createElement("input"); inp.type="file"; inp.accept="image/*";
    inp.onchange=()=>{ const f=inp.files[0]; if(!f) return;
      const rd=new FileReader(); rd.onload=()=>cb(rd.result,f); rd.readAsDataURL(f); };
    inp.click();
  };
}
function Photos(props){
  const {data,setData,toast,ind}=props;
  const upload=usePhotoUpload();
  const [modal,setModal]=useState(false);
  const [nf,setNf]=useState({title:"",before:null,after:null});
  const setSide=(pairId,side)=>upload(url=>{
    setData(d=>{ d.photos=d.photos.map(p=>p.id===pairId?{...p,[side]:url}:p); return d; });
    toast(side[0].toUpperCase()+side.slice(1)+" photo updated");
  });
  const add=()=>{
    setData(d=>{ d.photos.unshift({id:uid(),jobId:null,title:nf.title||"New "+ind.jobNoun,before:nf.before,after:nf.after,beforeGrad:"linear-gradient(135deg,#94A3B8,#475569)",afterGrad:"linear-gradient(135deg,#34D399,#059669)",date:todayISO()}); return d; });
    setModal(false); setNf({title:"",before:null,after:null}); toast("Showcase added 📸");
  };
  const Half=({p,side,label})=>{
    const img=p[side];
    return <div onClick={()=>setSide(p.id,side)} style={{flex:1,aspectRatio:"4/3",borderRadius:10,cursor:"pointer",position:"relative",overflow:"hidden",
      background:img?("url("+img+") center/cover"):p[side+"Grad"],display:"flex",alignItems:"flex-end"}}>
      <span className="badge" style={{margin:8,background:"rgba(12,17,29,.72)",color:"#fff"}}>{label}</span>
      {!img&&<span style={{position:"absolute",inset:0,display:"flex",alignItems:"center",justifyContent:"center",color:"rgba(255,255,255,.85)",fontSize:11.5,fontWeight:600}}>Tap to add photo</span>}
    </div>;
  };
  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Before / After</div><div className="muted tiny">Your best sales tool — proof of quality, ready to share.</div></div>
      <button className="btn btn-primary no-print" onClick={()=>setModal(true)}>+ Add showcase</button>
    </div>
    {data.photos.map(p=><div key={p.id} className="card" style={{padding:14,marginBottom:14}}>
      <div className="spread" style={{marginBottom:10}}><span style={{fontWeight:700}}>{p.title}</span><span className="tiny faint">{fmtDate(p.date)}</span></div>
      <div className="row" style={{gap:10}}><Half p={p} side="before" label="BEFORE"/><Half p={p} side="after" label="AFTER"/></div>
