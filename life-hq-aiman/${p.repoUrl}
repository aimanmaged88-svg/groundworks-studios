============================================================ */
let calCursor=new Date(); calCursor.setDate(1);
let selDate=todayISO();
function typeIcon(t){ return {shift:'🗓️',work:'💼',personal:'🎯',pay:'💵',family:'👪',google:'📆',bill:'🧾'}[t]||'📅'; }
function typeColor(t){ return {shift:'var(--teal)',work:'var(--amber)',personal:'var(--brand-2)',pay:'var(--green)',family:'#ff9ec4',google:'#5b8cff',bill:'var(--red)'}[t]||'var(--brand)'; }
function evtSort(a,b){ return (a.date+ (a.start||'')).localeCompare(b.date+(b.start||'')); }

function renderCal(){
  const y=calCursor.getFullYear(), m=calCursor.getMonth();
  $('#calMonth').textContent=calCursor.toLocaleDateString('en-AU',{month:'long',year:'numeric'});
  const first=new Date(y,m,1).getDay();
  const days=new Date(y,m+1,0).getDate();
  const dows=['Su','Mo','Tu','We','Th','Fr','Sa'];
  let html=dows.map(d=>`<div class="dow">${d}</div>`).join('');
  for(let i=0;i<first;i++) html+=`<div class="cell empty"></div>`;
  for(let d=1;d<=days;d++){
    const iso=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const evs=S.events.filter(e=>e.date===iso);
    const types=[...new Set(evs.map(e=>e.type))].slice(0,4);
    html+=`<div class="cell ${iso===todayISO()?'today':''} ${iso===selDate?'sel':''}" onclick="selDate='${iso}';renderCal()">
      <div class="n">${d}</div>
      <div class="dots">${types.map(t=>`<i class="${t}"></i>`).join('')}</div>
    </div>`;
  }
  $('#calGrid').innerHTML=html;
  renderDay();
}
function calMove(n){ calCursor.setMonth(calCursor.getMonth()+n); renderCal(); }
function renderDay(){
  const d=new Date(selDate+'T00:00');
  $('#dayLbl').textContent = d.toLocaleDateString('en-AU',{weekday:'long',day:'numeric',month:'long'});
  const evs=S.events.filter(e=>e.date===selDate).sort(evtSort);
  const box=$('#dayEvents');
