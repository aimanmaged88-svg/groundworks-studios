    <div class="fabnote">Prefer to type? <b style="color:var(--brand);cursor:pointer" onclick="openVoiceType()">Type instead</b></div></div>`);
  rec.onresult=e=>{ reviewVoice(e.results[0][0].transcript); };
  rec.onerror=e=>{ if(e.error==='no-speech'){ toast('Didn’t hear anything'); closeSheet(); } else if(e.error==='not-allowed'){ toast('Mic blocked — type it instead'); openVoiceType(); } else { openVoiceType(); } };
  try{ rec.start(); }catch(e){ openVoiceType(); }
}
function openVoiceType(){
  sheet(`<h3>Tell me in words</h3><div class="sub">Type it naturally — I'll fill in the rest.</div>
    <div class="field"><input id="vtInput" placeholder="e.g. getting paid 2000 on the 15th" autofocus onkeydown="if(event.key==='Enter')reviewVoice(this.value)"></div>
    <div class="btnrow"><button class="btn ghost" onclick="closeSheet()">Cancel</button><button class="btn" onclick="reviewVoice($('#vtInput').value)">Next</button></div>`);
}
function reviewVoice(text){ if(!text||!text.trim()){ toast('Say or type something'); return; } openMoneyEntry(null, null, parseMoneyVoice(text.trim())); }

function parseMoneyVoice(text){
  const t=' '+text.toLowerCase()+' ';
  let amount='';
  const am=t.match(/(?:\$)?\s*([\d]+(?:,\d{3})*(?:\.\d{1,2})?)\s*(k|grand|thousand)?/);
  if(am){ amount=parseFloat(am[1].replace(/,/g,'')); if(am[2])amount*=1000; }
  const incRe=/(getting paid|get paid|got paid|being paid|income|coming in|wage|salary|payday|deposit|refund|invoice|client|pay me|paid me)/;
  const expRe=/(bill|spent|spend|expense|rent|owe|due|paying for|pay for|bought|groceries|subscription|repayment|mortgage|fee)/;
  let dir='out';
  if(incRe.test(t) && !/(pay for|paying for|paid for)/.test(t)) dir='in';
  else if(expRe.test(t)) dir='out';
  else if(/\bpaid\b/.test(t)) dir='in';
  const date=parseSpokenDate(t);
  let repeat='';
  if(/(every fortnight|fortnightly|every two weeks|every 2 weeks|each fortnight)/.test(t)) repeat='fortnightly';
  else if(/(every week|weekly|each week)/.test(t)) repeat='weekly';
  else if(/(every month|monthly|each month)/.test(t)) repeat='monthly';
  let status='expected';
  if(/(landed|arrived|received|got it|just got|already|cleared|bought|spent|spend|paid for|got paid|just paid|was paid)/.test(t)) status='happened';
  let cat = dir==='in' ? (/(client|invoice)/.test(t)?'Client payment':'Wage/Shift') : 'Other';
  if(dir==='out'){ if(/(rent|electric|water|\bgas\b|internet|phone|insurance|mortgage|bill)/.test(t))cat='Rent/Bills'; else if(/(grocer|food|coles|woolies|woolworths|aldi)/.test(t))cat='Groceries'; else if(/(fuel|petrol|transport|uber|train|bus|rego)/.test(t))cat='Transport'; else if(/(subscription|netflix|spotify)/.test(t))cat='Subscriptions'; }
  let label=text.replace(/\$/g,'')
    .replace(/\b\d+(?:,\d{3})*(?:\.\d{1,2})?\s*(k|grand|thousand|dollars|bucks)?\b/ig,'')
    .replace(/\b(getting|get|got|being|paid|pay|spent|spend|bought|on|the|of|due|next|this|by|for|i'?m|im|is|to|me|in|out|coming|a|an|my|every|each|fortnight|fortnightly|weekly|monthly)\b/ig,'')
    .replace(/\b(today|tomorrow|monday|tuesday|wednesday|thursday|friday|saturday|sunday|january|february|march|april|may|june|july|august|september|october|november|december|jan|feb|mar|apr|jun|jul|aug|sep|sept|oct|nov|dec)\b/ig,'')
    .replace(/\b\d{1,2}(st|nd|rd|th)?\b/ig,'')
    .replace(/[-–,]/g,' ').replace(/\s+/g,' ').trim();
  if(label) label=label.charAt(0).toUpperCase()+label.slice(1);
  return {dir,status,amount,date,cat,label,repeat,heard:text};
}
function parseSpokenDate(text){
  const t=' '+text.toLowerCase()+' ';
  const wd={sunday:0,monday:1,tuesday:2,wednesday:3,thursday:4,friday:5,saturday:6};
  const mo={january:0,february:1,march:2,april:3,may:4,june:5,july:6,august:7,september:8,october:9,november:10,december:11,jan:0,feb:1,mar:2,apr:3,jun:5,jul:6,aug:7,sep:8,sept:8,oct:9,nov:10,dec:11};
  const today=new Date(); today.setHours(0,0,0,0);
  const I=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  const add=(d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x;};
  let m;
  if(/\btoday\b/.test(t)) return I(today);
  if(/\btomorrow\b/.test(t)) return I(add(today,1));
  if((m=t.match(/in (\d{1,2}) days?/))) return I(add(today,+m[1]));
  if((m=t.match(/\b(sunday|monday|tuesday|wednesday|thursday|friday|saturday)\b/))){ let diff=((wd[m[1]]-today.getDay())+7)%7; if(diff===0)diff=7; if(/\bnext\b/.test(t))diff=diff; return I(add(today,diff)); }
  if((m=t.match(/\b(\d{1,2})(?:st|nd|rd|th)?\s+(?:of\s+)?([a-z]{3,})\b/)) && mo[m[2]]!==undefined){ let d=new Date(today.getFullYear(),mo[m[2]],+m[1]); if(d<today)d=new Date(today.getFullYear()+1,mo[m[2]],+m[1]); return I(d); }
  if((m=t.match(/\b([a-z]{3,})\s+(\d{1,2})(?:st|nd|rd|th)?\b/)) && mo[m[1]]!==undefined){ let d=new Date(today.getFullYear(),mo[m[1]],+m[2]); if(d<today)d=new Date(today.getFullYear()+1,mo[m[1]],+m[2]); return I(d); }
  if((m=t.match(/\b(?:on\s+)?(?:the\s+)?(\d{1,2})(?:st|nd|rd|th)\b/))){ const day=+m[1]; if(day>=1&&day<=31){ let d=new Date(today.getFullYear(),today.getMonth(),day); if(d<today)d=new Date(today.getFullYear(),today.getMonth()+1,day); return I(d); } }
  if((m=t.match(/(\d{4})-(\d{1,2})-(\d{1,2})/))) return `${m[1]}-${String(+m[2]).padStart(2,'0')}-${String(+m[3]).padStart(2,'0')}`;
  return '';
}

