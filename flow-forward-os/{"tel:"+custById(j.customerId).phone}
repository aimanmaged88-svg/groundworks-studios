    body:"It has produced "+fmt$(topSvc[1])+" in paid work — your average sale is "+fmt$(Math.round(avgJob))+". Feature it first on quotes and ads.",
    nav:"analytics", cta:"See top services"});
  if(outSum>0) out.push({icon:"💰",tone:"blue",title:fmt$(outSum)+" in invoices awaiting payment",
    body:"Offering card payment on the customer portal typically halves days-to-paid versus bank transfer.",
    nav:"invoices", cta:"View invoices"});
  const payers=data.customers.map(c=>({c,p:paymentProfile(data,c.id)})).filter(x=>x.p.flag).sort((a,b)=>b.p.late-a.p.late);
