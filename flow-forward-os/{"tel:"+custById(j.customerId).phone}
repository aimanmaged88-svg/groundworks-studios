    <div className="tiny faint" style={{marginBottom:14}}>When a quote description mentions any keyword, the AI adds this line automatically. Leave blank for a fallback/labour item.</div>
    <button className="btn btn-primary btn-lg" style={{width:"100%"}} disabled={!f.name.trim()} onClick={save}>{rate?"Save changes":"Add service"}</button>
  </Modal>;
}

