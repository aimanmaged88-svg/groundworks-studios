/* ================= SMALL COMPONENTS ================= */
function Toast({msg}){ return msg ? <div className="toast">{msg}</div> : null; }
function Modal({open,onClose,children,title}){
  if(!open) return null;
  return <div className="modal-bg" onClick={e=>{if(e.target===e.currentTarget)onClose()}}>
    <div className="modal">
      <div className="grab"/>
      {title && <h2 style={{fontSize:18,marginBottom:12}}>{title}</h2>}
      {children}
    </div>
  </div>;
}
function Field({label,children}){ return <div><label>{label}</label>{children}</div>; }
function Empty({text}){ return <div style={{textAlign:"center",padding:"28px 12px"}} className="muted">{text}</div>; }

/* ================= LOGIN ================= */
function Login({users,setUsers,onLogin}){
  const [email,setEmail] = useState(LS.get("lastEmail",""));
  const [name,setName] = useState("");
  const [isNew,setIsNew] = useState(false);
  const [busy,setBusy] = useState(false);
  const sb = getSupabase();

  const go = async ()=>{
    const em = email.trim().toLowerCase();
    if(!em) return;
    setBusy(true);
    if(sb){
      // Supabase magic-link auth (production)
      const {error} = await sb.auth.signInWithOtp({email:em});
      setBusy(false);
      if(error) alert("Sign-in error: "+error.message);
      else alert("Check your email for the sign-in link, then reopen the app.");
      return;
    }
    // Local mode
    let u = users.find(x=>x.email.toLowerCase()===em);
    if(!u){
      if(!isNew){ setIsNew(true); setBusy(false); return; }
      if(!name.trim()){ setBusy(false); return; }
      u = {id:uid(),name:name.trim(),email:em,role:"support_worker"};
      setUsers(prev=>[...prev,u]);
    }
    LS.set("lastEmail",em);
    audit(u.name,"login",{email:em});
    onLogin(u);
    setBusy(false);
  };

  return <div className="login-wrap">
    <div style={{textAlign:"center",marginBottom:28}}>
      <div style={{width:72,height:72,borderRadius:20,background:"var(--brand)",color:"#F7F3E3",display:"inline-flex",alignItems:"center",justifyContent:"center",fontFamily:"Georgia,serif",fontSize:40,fontWeight:700,marginBottom:14}}>B</div>
      <h1 style={{fontSize:24}}>Borealis SIL OS</h1>
      <p className="muted" style={{marginTop:4}}>Muhamad Khayat support team</p>
    </div>
    <div className="card">
      <Field label="Your work email">
        <input type="email" inputMode="email" autoComplete="email" placeholder="you@borealis.com.au" value={email} onChange={e=>setEmail(e.target.value)} onKeyDown={e=>e.key==="Enter"&&go()} />
      </Field>
      {isNew && !sb && <Field label="Your name (first login)">
        <input placeholder="e.g. Donya" value={name} onChange={e=>setName(e.target.value)} onKeyDown={e=>e.key==="Enter"&&go()} />
      </Field>}
      <button className="btn block" style={{marginTop:16}} onClick={go} disabled={busy}>
        {busy ? <div className="spin"/> : (sb ? "Email me a sign-in link" : (isNew ? "Create my account" : "Sign in"))}
      </button>
      {!sb && <p className="tiny" style={{marginTop:12,textAlign:"center"}}>Local mode — data stays on this device. Connect Supabase in Settings for the whole team to share one secure database.</p>}
    </div>
    <p className="tiny" style={{textAlign:"center"}}>Confidential — authorised Borealis support staff only.<br/>Participant information is protected under NDIS Practice Standards.</p>
  </div>;
}

/* ================= DASHBOARD ================= */
function Dashboard({user,go,shift,meds,medLog,appts,checkLog,checklist,handovers,moneyDays,incidents,quickItems,setQuickItems}){
  const now = new Date();
  const day = todayStr();
  const hour = now.getHours();
  const greet = hour<12?"Good morning":hour<17?"Good afternoon":"Good evening";

  // Next appointment logic
  const upcoming = useMemo(()=>{
    const out=[];
    appts.forEach(a=>{
      for(let i=0;i<15;i++){
        const d = new Date(); d.setDate(d.getDate()+i); d.setHours(9,0,0,0);
        if(d.getDay()!==a.day) continue;
        if(a.anchor){
          const weeks = Math.round((d - new Date(a.anchor))/6048e5);
          if(weeks % 2 !== 0) continue;
        }
        out.push({...a,date:d}); break;
      }
    });
    return out.sort((x,y)=>x.date-y.date);
  },[appts]);

  const clozToday = medLog.some(l=>l.day===day && l.name.startsWith("Clozapine") && l.status==="given");
  const clozDue = hour>=17 && !clozToday;
  const dailyDone = checkLog.filter(l=>l.day===day && checklist.find(c=>c.id===l.templateId && c.kind==="daily")).length;
  const dailyTotal = checklist.filter(c=>c.kind==="daily").length;
  const lastHand = handovers[0];
  const todayMoney = moneyDays.find(d=>d.day===day);
  const openIncCount = (incidents||[]).filter(i=>i.status==="open").length;

  return <div>
    <div style={{marginBottom:16}}>
      <h1 style={{fontSize:22}}>{greet}, {user.name.split(" ")[0]}</h1>
      <p className="muted">{now.toLocaleDateString("en-AU",{weekday:"long",day:"numeric",month:"long"})} · Supporting <b style={{color:"var(--ink)"}}>Muhamad</b></p>
    </div>

    {!shift && <button className="btn block" style={{marginBottom:12,padding:"16px"}} onClick={()=>go("shift")}>▶ Start my shift</button>}
    {shift && <div className="card" style={{borderLeft:"4px solid var(--ok)"}}>
      <div className="row">
        <div className="grow">
          <b>Shift in progress</b>
          <div className="muted">Started {fmtTime(shift.startedAt)} · {shift.shiftType}</div>
        </div>
        <button className="btn sm sec" onClick={()=>go("shift")}>Open</button>
      </div>
    </div>}

    {clozDue && <div className="alert danger" onClick={()=>go("meds")} style={{cursor:"pointer"}}>
      <b>⏰ Clozapine due — 5:30 PM.</b> Tap to record. Calm wording: "Here's your medication, Muhamad." Refusal = call office immediately.
    </div>}

    {(()=>{
      const items = (quickItems||[]).filter(q=>q.day<=day && (!q.done || q.day===day))
        .sort((a,b)=>((a.done?"1":"0")+a.day+(a.time||"99")).localeCompare((b.done?"1":"0")+b.day+(b.time||"99")));
      const coming = (quickItems||[]).filter(q=>q.day>day && !q.done).sort((a,b)=>(a.day+(a.time||"99")).localeCompare(b.day+(b.time||"99"))).slice(0,5);
      if(!items.length && !coming.length) return null;
      const toggle = q=>setQuickItems(prev=>prev.map(x=>x.id===q.id?{...x,done:!x.done}:x));
      const del = q=>{ if(confirm("Remove \""+q.title+"\" from the plan?")) setQuickItems(prev=>prev.filter(x=>x.id!==q.id)); };
      const Row = ({q,future})=><div className="check">
        <div className={"cbox "+(q.done?"on":"")} onClick={()=>toggle(q)} style={{cursor:"pointer"}}>{q.done&&"✓"}</div>
        <div className="grow" onClick={()=>toggle(q)} style={{cursor:"pointer"}}>
          <span style={q.done?{opacity:.55,textDecoration:"line-through"}:{}}>{(CAT_LABEL[q.category]||"📝").split(" ")[0]} {q.title}</span>
          <div className="tiny">
            {(future||q.day<day)?fmtDate(q.day+"T12:00")+" · ":""}
            {q.time?t12(q.time)+" · ":""}
            {q.people&&q.people.length?"with "+q.people.join(" and ")+" · ":""}
            added by {q.by}
          </div>
          {q.raw && q.raw.toLowerCase()!==q.title.toLowerCase() && <div className="tiny" style={{fontStyle:"italic"}}>"{q.raw}"</div>}
        </div>
        <button className="btn ghost sm" onClick={()=>del(q)}>✕</button>
      </div>;
      return <>
        <div className="section-title">Today's plan</div>
        <div className="card">
          {items.length===0 && <Empty text="Nothing planned yet — tap ＋ Add and just type it."/>}
          {items.map(q=><Row key={q.id} q={q}/>)}
          {coming.length>0 && <>
            <div className="tiny" style={{fontWeight:700,letterSpacing:".05em",margin:"12px 0 2px"}}>COMING UP</div>
            {coming.map(q=><Row key={q.id} q={q} future/>)}
          </>}
        </div>
      </>;
    })()}
    {upcoming[0] && (upcoming[0].date.toDateString()===now.toDateString()) &&
      <div className="alert warn" onClick={()=>go("calendar")} style={{cursor:"pointer"}}>
        <b>📍 Today: {upcoming[0].title}.</b> {upcoming[0].location}. Discuss calmly and early — avoid pressure.
      </div>}

    <div className="grid2">
      <button className="tile" onClick={()=>go("meds")}>
        <div className="ic"><I.pill/></div><b>Medication</b>
        <span>{clozToday?"✓ Clozapine logged today":"Clozapine 5:30 PM · morning tablet"}</span>
      </button>
      <button className="tile" onClick={()=>go("money")}>
        <div className="ic"><I.money/></div><b>Money</b>
        <span>{todayMoney?`Balance ${fmtMoney(todayMoney.balance)}`:"Start today's form"}</span>
      </button>
      <button className="tile" onClick={()=>go("checklist")}>
        <div className="ic"><I.checkl/></div><b>Daily checklist</b>
        <span>{dailyDone}/{dailyTotal} done today</span>
      </button>
      <button className="tile" onClick={()=>go("handover")}>
        <div className="ic"><I.hand/></div><b>Handover</b>
        <span>{lastHand?`Last: ${fmtTime(lastHand.at)} by ${lastHand.fromName}`:"No handovers yet"}</span>
      </button>
      <button className="tile" onClick={()=>go("profile")}>
        <div className="ic"><I.book/></div><b>About Muhamad</b>
        <span>Triggers · warning signs · BSP quick guide</span>
      </button>
      <button className="tile" onClick={()=>go("incidents")}>
        <div className="ic" style={{background:"var(--dangerSoft)",color:"var(--danger)"}}><I.alertT/></div><b>Incidents</b>
        <span>{openIncCount?`${openIncCount} open`:"Report an incident"}</span>
      </button>
    </div>

    <div className="section-title">Next appointments</div>
    <div className="card">
      {upcoming.slice(0,3).map(a=><div key={a.id} className="list-item">
        <div className="avatar" style={{borderRadius:12}}>{a.date.getDate()}</div>
        <div className="grow">
          <b style={{fontSize:14}}>{a.title}</b>
          <div className="tiny">{fmtDate(a.date)} · {a.location}</div>
        </div>
      </div>)}
    </div>

    <div className="section-title">Emergency</div>
    <div className="card" style={{background:"var(--dangerSoft)",borderColor:"var(--danger)"}}>
      <p style={{fontSize:13.5,margin:"0 0 10px"}}>Immediate danger: call <b>000 first</b>, then the Case Manager / office. Never manage serious situations alone.</p>
      <div className="row">
        <a className="btn danger sm grow" style={{textDecoration:"none",textAlign:"center",justifyContent:"center"}} href="tel:000">📞 000</a>
        <button className="btn sm sec grow" onClick={()=>go("profile","contacts")}>All contacts</button>
      </div>
    </div>
  </div>;
}

/* ================= PARTICIPANT PROFILE (editable) ================= */
function EditableList({items,onChange,placeholder}){
  const [txt,setTxt] = useState("");
  const add = ()=>{ if(!txt.trim()) return; onChange([...(items||[]),txt.trim()]); setTxt(""); };
  return <div>
    {(items||[]).map((x,i)=><div key={i} className="row" style={{padding:"6px 0",borderBottom:"1px solid var(--border)"}}>
      <span className="grow" style={{fontSize:14}}>{x}</span>
      <button className="btn ghost sm" onClick={()=>onChange(items.filter((_,j)=>j!==i))} aria-label="Remove">✕</button>
    </div>)}
    <div className="row" style={{marginTop:10}}>
      <input className="grow" placeholder={placeholder||"Add another…"} value={txt} onChange={e=>setTxt(e.target.value)} onKeyDown={e=>e.key==="Enter"&&add()}/>
      <button className="btn sm" onClick={add}>Add</button>
    </div>
  </div>;
}

function Profile({initialTab,participant,setParticipant,user,toast}){
  const P = participant;
  const [tab,setTab] = useState(initialTab||"quick");
  const [edit,setEdit] = useState(false);
  const [nc,setNc] = useState({name:"",role:"",phone:"",note:""});
  const upd = (k,v)=>setParticipant(prev=>({...prev,[k]:v}));
  const doneEdit = ()=>{ setEdit(false); audit(user.name,"profile_edit",{}); toast("Profile updated ✓"); };
  const List = ({items})=><ul style={{margin:"4px 0",paddingLeft:20}}>{(items||[]).map((x,i)=><li key={i} style={{marginBottom:6,fontSize:14}}>{x}</li>)}</ul>;
  const LX = ({k})=> edit ? <EditableList items={P[k]} onChange={v=>upd(k,v)}/> : <List items={P[k]}/>;
  const addContact = ()=>{
    if(!nc.name.trim()) return;
    upd("contacts",[...P.contacts,{...nc,name:nc.name.trim()}]);
    setNc({name:"",role:"",phone:"",note:""});
  };
  return <div>
    <div className="card" style={{display:"flex",gap:14,alignItems:"center"}}>
      <div className="avatar" style={{width:54,height:54,fontSize:20}}>MK</div>
      <div className="grow">
        <h2 style={{fontSize:18}}>{P.fullName}</h2>
        <div className="tiny">{P.culture} · {P.languages} · {P.supportNeeds}</div>
      </div>
      {edit ? <button className="btn sm" onClick={doneEdit}>Done</button>
            : <button className="btn sm sec" onClick={()=>setEdit(true)}>✏️ Edit</button>}
    </div>
    {edit && <div className="alert brand" style={{fontSize:13}}>Edit mode — add, change or remove anything on any tab. Everything here shapes how the team supports Muhamad, so keep it accurate. Tap <b>Done</b> when finished.</div>}
    {edit && <div className="card"><h3>Basics</h3>
      <Field label="Full name"><input value={P.fullName} onChange={e=>upd("fullName",e.target.value)}/></Field>
      <Field label="Preferred name"><input value={P.preferredName} onChange={e=>upd("preferredName",e.target.value)}/></Field>
      <Field label="Address"><textarea value={P.address} onChange={e=>upd("address",e.target.value)}/></Field>
      <div className="grid2">
        <Field label="Languages"><input value={P.languages} onChange={e=>upd("languages",e.target.value)}/></Field>
        <Field label="Culture"><input value={P.culture} onChange={e=>upd("culture",e.target.value)}/></Field>
      </div>
      <Field label="Support needs"><input value={P.supportNeeds} onChange={e=>upd("supportNeeds",e.target.value)}/></Field>
    </div>}
    <div className="seg">
      {[["quick","Quick guide"],["triggers","Triggers"],["escalation","Escalation"],["routine","Routine"],["safety","Safety"],["contacts","Contacts"]].map(([k,l])=>
        <button key={k} className={tab===k?"on":""} onClick={()=>setTab(k)}>{l}</button>)}
    </div>

    {tab==="quick" && <div>
      <div className="alert brand"><b>Keep support: Calm. Simple. Respectful. Predictable. Safe.</b> If unsure, call the Case Manager / office — escalate early.</div>
      <div className="card"><h3>Diagnoses</h3>
        {edit ? <LX k="diagnoses"/> : P.diagnoses.map(d=><span key={d} className="chip">{d}</span>)}
        {!edit && <p className="muted" style={{marginTop:8}}>May experience: {P.presentations.join("; ").toLowerCase()}.</p>}
        {edit && <div style={{marginTop:10}}><b style={{fontSize:13}}>May experience</b><LX k="presentations"/></div>}
      </div>
      <div className="card"><h3>✅ Communication — Do</h3><LX k="commsDo"/></div>
      <div className="card"><h3>🚫 Communication — Don't</h3><LX k="commsDont"/></div>
      <div className="card"><h3>❌ Never (critical worker rules)</h3><LX k="neverRules"/></div>
      <div className="card"><h3>What we've learned about Muhamad</h3>
        <LX k="observations"/>
        {!edit && <p className="tiny" style={{marginTop:8}}>Learned something new about Muhamad? Tap ✏️ Edit up top and add it — the whole team benefits.</p>}
      </div>
    </div>}

    {tab==="triggers" && <div>
      <div className="card"><h3>Known triggers</h3><LX k="triggers"/></div>
      <div className="card"><h3>Early warning signs — watch for</h3><LX k="warningSigns"/></div>
      <div className="card" style={{borderLeft:"4px solid var(--warn)"}}><h3>When you see warning signs</h3><LX k="warningResponse"/>
        {edit ? <Field label="Phrase to use"><input value={P.warningPhrase} onChange={e=>upd("warningPhrase",e.target.value)}/></Field>
              : <div className="alert warn" style={{marginTop:10,marginBottom:0}}>Use this phrase: <b>"{P.warningPhrase}"</b></div>}
      </div>
    </div>}

    {tab==="escalation" && <div>
      <div className="card" style={{borderLeft:"4px solid var(--danger)"}}><h3>If Muhamad escalates</h3><LX k="escalationSteps"/>
        {edit ? <Field label="Phrase to use"><input value={P.escalationPhrase} onChange={e=>upd("escalationPhrase",e.target.value)}/></Field>
              : <div className="alert danger" style={{marginTop:10,marginBottom:0}}>Use this phrase: <b>"{P.escalationPhrase}"</b></div>}
      </div>
      <div className="card"><h3>Once he calms down</h3><LX k="afterCalm"/></div>
      <div className="card"><h3>If he leaves the property</h3><LX k="leavesProperty"/>
        <div className="alert danger" style={{marginTop:10,marginBottom:0}}>Missing / uncontactable / safety concern = <b>urgent escalation</b>. Immediate danger: <b>000 first</b>, then office.</div></div>
      <div className="card"><h3>Call the office immediately for</h3><LX k="callOfficeFor"/></div>
    </div>}

    {tab==="routine" && <div>
      <div className="card"><h3>Daily routine to support</h3><LX k="routine"/>
        <div className="alert brand" style={{marginTop:10,marginBottom:0}}>Tell Muhamad about changes early: <b>"Muhamad, today we will go shopping in the afternoon instead of the morning."</b></div></div>
      <div className="card"><h3>Religion & culture</h3>
        <List items={["Respect prayer times — never interrupt prayer","Never use prayer or mosque as reward or punishment","Support mosque attendance","Ensure all food is halal","Arabic swearing when distressed is not more threatening than English"]}/></div>
      <div className="card"><h3>Hygiene support</h3><LX k="hygiene"/></div>
    </div>}

    {tab==="safety" && <div>
      <div className="card" style={{borderLeft:"4px solid var(--danger)"}}><h3>🔥 Fire, stove & smoking</h3>
        <p className="muted">Fire risk due to unsafe stove use and indoor smoking. Has smoked tea leaves in rolling papers when out of cigarettes.</p>
        <LX k="fireSafety"/></div>
      <div className="card"><h3>Money safeguarding</h3><LX k="moneyRules"/></div>
    </div>}

    {tab==="contacts" && <div>
      <div className="card">
        {P.contacts.map((c,i)=><div key={i} className="list-item">
          <div className="avatar">{c.name.slice(0,2).toUpperCase()}</div>
          <div className="grow">
            <b style={{fontSize:14}}>{c.name}</b> <span className="tiny">— {c.role}</span>
            <div className="tiny" style={{marginTop:2}}>{c.note}</div>
          </div>
          {edit ? <button className="btn ghost sm" onClick={()=>upd("contacts",P.contacts.filter((_,j)=>j!==i))}>✕</button>
                : c.phone && <a className="btn sm sec" href={"tel:"+c.phone.replace(/\s/g,"")} style={{textDecoration:"none"}}>📞</a>}
        </div>)}
      </div>
      {edit && <div className="card"><h3>Add contact</h3>
        <div className="grid2">
          <Field label="Name"><input value={nc.name} onChange={e=>setNc({...nc,name:e.target.value})}/></Field>
          <Field label="Role"><input value={nc.role} onChange={e=>setNc({...nc,role:e.target.value})} placeholder="e.g. GP, Aunt"/></Field>
        </div>
        <Field label="Phone (optional)"><input value={nc.phone} onChange={e=>setNc({...nc,phone:e.target.value})}/></Field>
        <Field label="Note (optional)"><input value={nc.note} onChange={e=>setNc({...nc,note:e.target.value})}/></Field>
        <button className="btn block sm" style={{marginTop:12}} onClick={addContact}>Add contact</button>
      </div>}
    </div>}
  </div>;
}

/* ================= SHIFT — punch in your times, edit them any time ================= */
const SHIFT_TYPES = ["Day","Evening","Sleepover","Active night"];
const hm = (d)=>{const x=new Date(d);return String(x.getHours()).padStart(2,"0")+":"+String(x.getMinutes()).padStart(2,"0")};
const dayTimeISO = (day,t)=>new Date(day+"T"+(t||"00:00")).toISOString();

function ShiftForm({initial,onSave,onDelete,saveLabel}){
  const [f,setF] = useState(initial);
  const set = k=>e=>setF({...f,[k]:e.target.value});
  return <div>
    <Field label="Shift type">
      <select value={f.type} onChange={set("type")}>{SHIFT_TYPES.map(t=><option key={t}>{t}</option>)}</select>
    </Field>
    <Field label="Date"><input type="date" value={f.day} onChange={set("day")}/></Field>
    <div className="grid2">
      <Field label="Started"><input type="time" value={f.start} onChange={set("start")}/></Field>
      <Field label="Finished"><input type="time" value={f.end} onChange={set("end")}/></Field>
    </div>
    <button className="btn block" style={{marginTop:14}} onClick={()=>f.start&&onSave(f)}>{saveLabel}</button>
    {onDelete && <button className="btn danger block" style={{marginTop:8}} onClick={onDelete}>Delete this shift</button>}
  </div>;
}

function Shift({user,shift,setShift,shifts,setShifts,go,toast}){
  const [type,setType] = useState("Day");
  const [startT,setStartT] = useState(hm(new Date()));
  const [endT,setEndT] = useState("");
  const [editingId,setEditingId] = useState(null);
  const [addPast,setAddPast] = useState(false);

  const start = ()=>{
    const s = {id:uid(),workerId:user.id,workerName:user.name,shiftType:type,startedAt:dayTimeISO(todayStr(),startT||hm(new Date()))};
    setShift(s); LS.set("activeShift",s);
    audit(user.name,"shift_start",{type,at:startT});
    toast("Shift started — have a great one 💪");
  };
  const updateStart = (t)=>{
    if(!t) return;
    const s = {...shift,startedAt:dayTimeISO(localDay(shift.startedAt),t)};
    setShift(s); LS.set("activeShift",s);
  };
  const end = ()=>{
    const t = endT || hm(new Date());
    if(!confirm(`Finish shift at ${t12(t)}? Make sure your progress note, money form and handover are done.`)) return;
    const done = {...shift,endedAt:dayTimeISO(todayStr(),t)};
    setShifts(prev=>[done,...prev]); setShift(null); LS.del("activeShift"); setEndT("");
    audit(user.name,"shift_end",{at:t});
    toast("Shift ended. Thanks for looking after Muhamad today 🙏");
  };
  const saveEdit = (s0)=>(f)=>{
    setShifts(prev=>prev.map(s=>s.id!==s0.id?s:{...s,shiftType:f.type,startedAt:dayTimeISO(f.day,f.start),endedAt:f.end?dayTimeISO(f.day,f.end):null}));
    audit(user.name,"shift_edit",{id:s0.id});
    setEditingId(null); toast("Shift updated ✓");
  };
  const del = (s0)=>{
    if(!confirm("Delete this shift record?")) return;
    setShifts(prev=>prev.filter(s=>s.id!==s0.id));
    audit(user.name,"shift_delete",{id:s0.id});
    setEditingId(null); toast("Shift deleted");
  };
  const savePast = (f)=>{
    if(!f.end){ alert("Add a finish time for a past shift."); return; }
    setShifts(prev=>[{id:uid(),workerId:user.id,workerName:user.name,shiftType:f.type,startedAt:dayTimeISO(f.day,f.start),endedAt:dayTimeISO(f.day,f.end)},...prev]);
    audit(user.name,"shift_add_past",{day:f.day});
    setAddPast(false); toast("Shift added ✓");
  };
  const editing = shifts.find(s=>s.id===editingId);

  return <div>
    {!shift ? <div className="card">
      <h3>Start shift</h3>
      <p className="tiny">Punch in whatever time is right — you can edit it any time. This is here to make your life easier, not to police anyone.</p>
      <div className="grid2">
        <Field label="Shift type">
          <select value={type} onChange={e=>setType(e.target.value)}>{SHIFT_TYPES.map(t=><option key={t}>{t}</option>)}</select>
        </Field>
        <Field label="Start time"><input type="time" value={startT} onChange={e=>setStartT(e.target.value)}/></Field>
      </div>
      <button className="btn block" style={{marginTop:14}} onClick={start}>Start shift</button>
    </div> :
    <div>
      <div className="card" style={{borderLeft:"4px solid var(--ok)"}}>
        <h3>Shift in progress</h3>
        <div className="kv"><span>Worker</span><b>{shift.workerName}</b></div>
        <div className="kv"><span>Type</span><b>{shift.shiftType}</b></div>
        <Field label="Started at (tap to fix)"><input type="time" value={hm(shift.startedAt)} onChange={e=>updateStart(e.target.value)}/></Field>
      </div>
      <div className="grid2">
        <button className="tile" onClick={()=>go("notes")}><div className="ic"><I.note/></div><b>Write progress note</b><span>Composed for you, NDIS ready</span></button>
        <button className="tile" onClick={()=>go("handover")}><div className="ic"><I.hand/></div><b>Do handover</b><span>Pouch, keys, summary</span></button>
      </div>
      <div className="card">
        <Field label="Finish time (leave blank to use the current time)"><input type="time" value={endT} onChange={e=>setEndT(e.target.value)}/></Field>
        <button className="btn danger block" style={{marginTop:10}} onClick={end}>End shift</button>
      </div>
    </div>}

    <div className="section-title">Recent shifts</div>
    <div className="card">
      {shifts.length===0 ? <Empty text="No completed shifts yet."/> :
        shifts.slice(0,10).map(s=><div key={s.id} className="list-item">
          <div className="grow"><b style={{fontSize:14}}>{s.workerName}</b><div className="tiny">{fmtDate(s.startedAt)} · {fmtTime(s.startedAt)}–{s.endedAt?fmtTime(s.endedAt):"—"} · {s.shiftType}</div></div>
          <button className="btn ghost sm" onClick={()=>setEditingId(s.id)}>✏️ Edit</button>
        </div>)}
      <button className="btn sec block sm" style={{marginTop:10}} onClick={()=>setAddPast(true)}>＋ Add a shift I forgot to log</button>
    </div>

    <Modal open={!!editing} onClose={()=>setEditingId(null)} title="Edit shift">
      {editing && <ShiftForm saveLabel="Save changes"
        initial={{type:editing.shiftType,day:localDay(editing.startedAt),start:hm(editing.startedAt),end:editing.endedAt?hm(editing.endedAt):""}}
        onSave={saveEdit(editing)} onDelete={()=>del(editing)}/>}
    </Modal>
    <Modal open={addPast} onClose={()=>setAddPast(false)} title="Add a past shift">
      <ShiftForm saveLabel="Add shift" initial={{type:"Day",day:todayStr(),start:"09:00",end:"17:00"}} onSave={savePast}/>
    </Modal>
  </div>;
}

/* ================= PROGRESS NOTES ================= */
function Notes({user,notes,setNotes,shift,toast}){
  const blank = {mood:"calm",meals:"",fluids:"",medsGiven:"given",hygiene:"",prayer:"",community:"",household:"",smoking:"",money:"",warnings:"",incidents:"",goals:"",other:"",shiftType:shift?shift.shiftType:"Day",start:shift?fmtTime(shift.startedAt):"",end:""};
  const [f,setF] = useState(blank);
  const [preview,setPreview] = useState(null);
  const [writing,setWriting] = useState(false);
  const set = k=>e=>setF({...f,[k]:e.target.value});

  const gen = ()=>{ setPreview(generateNote(f,user)); };
  const save = ()=>{
    const n = {id:uid(),day:todayStr(),workerId:user.id,workerName:user.name,structured:f,narrative:preview,at:new Date().toISOString()};
    setNotes(prev=>[n,...prev]);
    audit(user.name,"progress_note",{day:n.day});
    setPreview(null); setF(blank); setWriting(false);
    toast("Progress note saved ✓");
  };
  const copy = (t)=>{ navigator.clipboard && navigator.clipboard.writeText(t).then(()=>toast("Copied — paste into your provider system")); };

  return <div>
    {!writing && <button className="btn block" style={{marginBottom:14}} onClick={()=>setWriting(true)}>＋ New progress note</button>}
    {writing && <div className="card">
      <h3>Shift observations</h3>
      <p className="tiny">Fill in what applies — the app composes a professional ~2,000 character NDIS note. Skip anything that didn't happen.</p>
      <Field label="Mood & presentation">
        <select value={f.mood} onChange={set("mood")}>
          <option value="calm">Calm and settled</option><option value="happy">Positive / cheerful</option>
          <option value="tired">Tired / low energy</option><option value="flat">Flat / low motivation</option>
          <option value="agitated">Agitated — warning signs seen</option><option value="distressed">Distressed / escalated</option>
        </select>
      </Field>
      <Field label="Medication">
        <select value={f.medsGiven} onChange={set("medsGiven")}>
          <option value="given">All given as scheduled</option><option value="partial">Partially given</option><option value="refused">Refused (office notified)</option>
        </select>
      </Field>
      <Field label="Meals & food (what he ate, how much)"><textarea placeholder="e.g. Ate half his scrambled eggs, stored the rest in the fridge. Kebab at Merrylands — two bites. Full coffee." value={f.meals} onChange={set("meals")}/></Field>
      <Field label="Hygiene & self-care"><textarea placeholder="e.g. Good shower after prayer, applied deodorant, fresh clothes." value={f.hygiene} onChange={set("hygiene")}/></Field>
      <Field label="Prayer / religious support"><textarea placeholder="e.g. Prayed in the lounge room; attended mosque for midday prayer." value={f.prayer} onChange={set("prayer")}/></Field>
      <Field label="Community access & activities"><textarea placeholder="e.g. Coffee outing to Merrylands, shopping at Kmart — polite with staff." value={f.community} onChange={set("community")}/></Field>
      <Field label="Smoking / fire safety"><textarea placeholder="e.g. Smoked on the balcony independently, respected the household boundary." value={f.smoking} onChange={set("smoking")}/></Field>
      <Field label="Money handled this shift"><textarea placeholder="e.g. $12.50 spent on coffee and eggs, receipts photographed and sent to Batoul, $187.50 remaining." value={f.money} onChange={set("money")}/></Field>
      <Field label="Warning signs observed (if any)"><textarea placeholder="e.g. Became quiet and walked away when hygiene was offered a second time." value={f.warnings} onChange={set("warnings")}/></Field>
      <Field label="Incidents (if any)"><textarea value={f.incidents} onChange={set("incidents")} placeholder="Brief summary — full detail goes in the incident report."/></Field>
      <Field label="Household tasks"><textarea value={f.household} onChange={set("household")} placeholder="e.g. Kitchen cleaned, rubbish out, stove checked off."/></Field>
      <Field label="Anything else"><textarea value={f.other} onChange={set("other")}/></Field>
      <div className="row" style={{marginTop:14}}>
        <button className="btn grow" onClick={gen}>✨ Compose NDIS note</button>
        <button className="btn sec" onClick={()=>{setWriting(false);setPreview(null)}}>Cancel</button>
      </div>
    </div>}

    {preview && <div className="card" style={{borderLeft:"4px solid var(--accent)"}}>
      <div className="row" style={{marginBottom:8}}><h3 className="grow">Generated note</h3><span className="pill accent">{preview.length} chars</span></div>
      <textarea style={{minHeight:260,fontSize:13.5}} value={preview} onChange={e=>setPreview(e.target.value)}/>
      <p className="tiny" style={{margin:"8px 0"}}>Read it, edit anything, then save. You are responsible for its accuracy.</p>
      <div className="row">
        <button className="btn grow" onClick={save}>Save note</button>
        <button className="btn sec" onClick={()=>copy(preview)}>Copy</button>
      </div>
    </div>}

    <div className="section-title">Saved notes</div>
    {notes.length===0 ? <div className="card"><Empty text="No notes yet. Notes are your legal record of every shift."/></div> :
      notes.map(n=><div key={n.id} className="card">
        <div className="row"><b className="grow" style={{fontSize:14}}>{fmtDate(n.at)} · {n.workerName}</b>
          <button className="btn ghost sm" onClick={()=>copy(n.narrative)}>Copy</button></div>
        <p style={{fontSize:13.5,whiteSpace:"pre-wrap",margin:"6px 0 0"}}>{n.narrative}</p>
      </div>)}
  </div>;
}

/* ================= MEDICATION ================= */
function Meds({user,medLog,setMedLog,toast}){
  const day = todayStr();
  const [refuseFor,setRefuseFor] = useState(null);
  const [refNote,setRefNote] = useState("");
  const logDose = (m,status,notes)=>{
    const entry = {id:uid(),day,name:m.name,nameKey:m.id,status,notes:notes||"",by:user.name,at:new Date().toISOString()};
    setMedLog(prev=>[entry,...prev]);
    audit(user.name,"med_"+status,{med:m.name});
    if(status==="refused") toast("Logged. ☎️ Call the Case Manager / office NOW — refusal must be reported immediately.");
    else toast(m.name+" recorded ✓");
    setRefuseFor(null); setRefNote("");
  };
  const doneToday = (m)=>medLog.find(l=>l.day===day && l.nameKey===m.id);
  return <div>
    <div className="alert warn"><b>Dose check needed:</b> the Support Worker Guide lists Clozapine <b>550mg</b>, but the team update on 30/6 says <b>300mg at 5:30pm</b>. Confirm the current prescribed dose with Angel / the pharmacy and update this in Admin → Medication.</div>
    {SEED_MEDS.map(m=>{
      const d = doneToday(m);
      return <div key={m.id} className="card" style={d?{borderLeft:"4px solid "+(d.status==="given"?"var(--ok)":"var(--danger)")}:{}}>
        <div className="row">
          <div className="grow">
            <b>{m.name}</b>
            <div className="tiny">{m.timeLabel} · {m.dose}</div>
          </div>
          {d && <span className={"pill "+(d.status==="given"?"ok":"danger")}>{d.status==="given"?"✓ Given "+fmtTime(d.at):"✗ Refused"}</span>}
        </div>
        <p className="tiny" style={{margin:"8px 0"}}>{m.instructions}</p>
        {!d && <div className="row">
          <button className="btn sm grow" onClick={()=>logDose(m,"given")}>✓ Given</button>
          <button className="btn sm sec grow" onClick={()=>setRefuseFor(m)}>Refused / missed</button>
        </div>}
      </div>;
    })}
    <Modal open={!!refuseFor} onClose={()=>setRefuseFor(null)} title={"Refusal — "+(refuseFor&&refuseFor.name)}>
      <div className="alert danger"><b>Do not pressure or repeat.</b> Give space, re-approach later. You must call the Case Manager / office immediately and complete an incident report.</div>
      <Field label="What happened?"><textarea value={refNote} onChange={e=>setRefNote(e.target.value)} placeholder="e.g. Declined at 5:30pm, walked to bedroom. Will re-offer at 6pm."/></Field>
      <button className="btn danger block" style={{marginTop:12}} onClick={()=>logDose(refuseFor,"refused",refNote)}>Log refusal</button>
    </Modal>
    <div className="section-title">Medication log</div>
    <div className="card">
      {medLog.length===0 ? <Empty text="No doses recorded yet."/> :
        medLog.slice(0,30).map(l=><div key={l.id} className="list-item">
          <span className={"pill "+(l.status==="given"?"ok":"danger")} style={{marginTop:2}}>{l.status}</span>
          <div className="grow"><b style={{fontSize:14}}>{l.name}</b>
            <div className="tiny">{fmtDate(l.at)} {fmtTime(l.at)} · by {l.by}{l.notes?" · "+l.notes:""}</div></div>
        </div>)}
    </div>
  </div>;
}

/* ================= MONEY RECONCILIATION ================= */
function Money({user,moneyDays,setMoneyDays,toast}){
  const day = todayStr();
  const today = moneyDays.find(d=>d.day===day);
  const [openBal,setOpenBal] = useState(""); const [from,setFrom] = useState("");
  const [tx,setTx] = useState({items:"",amount:"",receipt:false,sent:false});
  const [closing,setClosing] = useState("");

  const startDay = ()=>{
    const ob = parseFloat(openBal); if(isNaN(ob)) return;
    setMoneyDays(prev=>[{id:uid(),day,opening:ob,balance:ob,from,tx:[],closed:false},...prev]);
    audit(user.name,"money_day_start",{opening:ob});
    toast("Money form started for today");
  };
  const addTx = ()=>{
    const amt = parseFloat(tx.amount); if(isNaN(amt)||!tx.items.trim()) return;
    setMoneyDays(prev=>prev.map(d=>d.day!==day?d:{...d,balance:+(d.balance-amt).toFixed(2),tx:[...d.tx,{id:uid(),at:new Date().toISOString(),items:tx.items.trim(),amount:amt,receipt:tx.receipt,sent:tx.sent,by:user.name,remaining:+(d.balance-amt).toFixed(2)}]}));
    audit(user.name,"money_tx",{items:tx.items,amount:amt});
    setTx({items:"",amount:"",receipt:false,sent:false});
    if(!tx.receipt||!tx.sent) toast("Saved — remember: photograph the receipt & WhatsApp it to Batoul with the balance");
    else toast("Purchase recorded ✓");
  };
  const closeDay = ()=>{
    const counted = parseFloat(closing); if(isNaN(counted)) return;
    const match = Math.abs(counted - today.balance) < 0.005;
    if(!match && !confirm(`⚠ Counted ${fmtMoney(counted)} but recorded balance is ${fmtMoney(today.balance)}.\n\nDiscrepancies must be reported to management IMMEDIATELY. Continue and log the discrepancy?`)) return;
    setMoneyDays(prev=>prev.map(d=>d.day!==day?d:{...d,closed:true,counted,match}));
    audit(user.name,"money_day_close",{counted,recorded:today.balance,match});
    toast(match?"Balances match ✓ Send the completed form to Angel/Donya":"Discrepancy logged — call the office now");
  };

  return <div>
    <div className="alert brand" style={{fontSize:13}}>Every purchase: record it here, photograph the receipt, WhatsApp the photo + remaining balance to <b>Batoul (0405 738 111)</b>. Pouch + form hand over at every shift change. Last worker of the day sends the completed form to Angel/Donya.</div>
    {!today ? <div className="card">
      <h3>Start today's form</h3>
      <div className="grid2">
        <Field label="Opening cash balance ($)"><input type="number" inputMode="decimal" step="0.05" value={openBal} onChange={e=>setOpenBal(e.target.value)} placeholder="200.00"/></Field>
        <Field label="Pouch handed over by"><input value={from} onChange={e=>setFrom(e.target.value)} placeholder="e.g. Donya"/></Field>
      </div>
      <button className="btn block" style={{marginTop:14}} onClick={startDay} disabled={openBal===""}>Open today's form</button>
    </div> :
    <div>
      <div className="card" style={{textAlign:"center"}}>
        <div className="tiny">CURRENT BALANCE</div>
        <div className="big-num">{fmtMoney(today.balance)}</div>
        <div className="tiny">Opened at {fmtMoney(today.opening)}{today.from?` · pouch from ${today.from}`:""}{today.closed?` · CLOSED (counted ${fmtMoney(today.counted)} ${today.match?"✓ match":"✗ MISMATCH"})`:""}</div>
      </div>
      {!today.closed && <div className="card">
        <h3>Record a purchase</h3>
        <Field label="Item(s) purchased"><input value={tx.items} onChange={e=>setTx({...tx,items:e.target.value})} placeholder="e.g. Coffee + cigarettes, Coles Merrylands"/></Field>
        <Field label="Amount spent ($)"><input type="number" inputMode="decimal" step="0.05" value={tx.amount} onChange={e=>setTx({...tx,amount:e.target.value})} placeholder="12.50"/></Field>
        <label className="check" style={{border:"none"}}><div className={"cbox "+(tx.receipt?"on":"")} onClick={()=>setTx({...tx,receipt:!tx.receipt})}>{tx.receipt&&"✓"}</div><span onClick={()=>setTx({...tx,receipt:!tx.receipt})}>Receipt photographed</span></label>
        <label className="check" style={{border:"none"}}><div className={"cbox "+(tx.sent?"on":"")} onClick={()=>setTx({...tx,sent:!tx.sent})}>{tx.sent&&"✓"}</div><span onClick={()=>setTx({...tx,sent:!tx.sent})}>Photo + balance sent to Batoul (WhatsApp)</span></label>
        <button className="btn block" style={{marginTop:10}} onClick={addTx}>Add purchase</button>
      </div>}
      <div className="card">
        <h3>Today's transactions</h3>
        {today.tx.length===0 ? <Empty text="No purchases yet today."/> :
          today.tx.map(t=><div key={t.id} className="list-item">
            <div className="grow"><b style={{fontSize:14}}>{t.items}</b>
              <div className="tiny">{fmtTime(t.at)} · {t.by} · {t.receipt?"🧾 receipt ✓":"⚠ no receipt"} · {t.sent?"📱 sent ✓":"⚠ not sent"}</div></div>
            <div style={{textAlign:"right"}}><b style={{color:"var(--danger)"}}>-{fmtMoney(t.amount)}</b><div className="tiny">bal {fmtMoney(t.remaining)}</div></div>
          </div>)}
      </div>
      {!today.closed && <div className="card">
        <h3>End of shift count</h3>
        <Field label="Cash counted in pouch ($)"><input type="number" inputMode="decimal" step="0.05" value={closing} onChange={e=>setClosing(e.target.value)} placeholder={String(today.balance)}/></Field>
        <button className="btn block" style={{marginTop:12}} onClick={closeDay}>Reconcile & close day</button>
      </div>}
    </div>}
    <div className="section-title">Previous days</div>
    <div className="card">
      {moneyDays.filter(d=>d.day!==day).length===0 ? <Empty text="History appears here."/> :
        moneyDays.filter(d=>d.day!==day).slice(0,14).map(d=><div key={d.id} className="list-item">
          <div className="grow"><b style={{fontSize:14}}>{fmtDate(d.day)}</b>
            <div className="tiny">{d.tx.length} purchases · {fmtMoney(d.opening)} → {fmtMoney(d.balance)}</div></div>
          {d.closed && <span className={"pill "+(d.match?"ok":"danger")}>{d.match?"✓ matched":"✗ discrepancy"}</span>}
        </div>)}
    </div>
  </div>;
}

/* ================= HANDOVER ================= */
function Handover({user,users,handovers,setHandovers,toast,quickItems}){
  const openPlan = (quickItems||[]).filter(q=>!q.done && q.day<=todayStr());
  const prefill = openPlan.map(q=>"• "+q.title+(q.time?" — "+t12(q.time):"")+(q.people&&q.people.length?" (with "+q.people.join(" and ")+")":"")).join("\n");
  const [f,setF] = useState({to:"",summary:"",outstanding:prefill,pouch:false,keys:false});
  const save = ()=>{
    if(!f.summary.trim()) return;
    const h = {id:uid(),at:new Date().toISOString(),fromName:user.name,toName:f.to||"(next worker)",summary:f.summary.trim(),outstanding:f.outstanding.trim(),pouch:f.pouch,keys:f.keys,ack:null};
    setHandovers(prev=>[h,...prev]);
    audit(user.name,"handover",{to:h.toName});
    setF({to:"",summary:"",outstanding:"",pouch:false,keys:false});
    toast("Handover posted ✓");
  };
  const ack = (id)=>{
    setHandovers(prev=>prev.map(h=>h.id===id?{...h,ack:{by:user.name,at:new Date().toISOString()}}:h));
    audit(user.name,"handover_ack",{id});
  };
  return <div>
    <div className="card">
      <h3>New handover</h3>
      <Field label="Handing over to">
        <select value={f.to} onChange={e=>setF({...f,to:e.target.value})}>
          <option value="">Next worker (unassigned)</option>
          {users.filter(u=>u.id!==user.id).map(u=><option key={u.id} value={u.name}>{u.name}</option>)}
        </select>
      </Field>
      <Field label="Shift summary — mood, meds, meals, anything the next worker MUST know">
        <textarea style={{minHeight:120}} value={f.summary} onChange={e=>setF({...f,summary:e.target.value})} placeholder="e.g. Calm day. Clozapine given 5:30pm. Ate half his eggs, rest in fridge. Smoked on balcony only. $54.20 in pouch, form up to date. He mentioned wanting to visit his mother tomorrow."/>
      </Field>
      <Field label="Outstanding / follow-ups"><textarea value={f.outstanding} onChange={e=>setF({...f,outstanding:e.target.value})} placeholder="e.g. Blood test tomorrow 10am Merrylands. Cigarettes running low."/></Field>
      <label className="check" style={{border:"none"}}><div className={"cbox "+(f.pouch?"on":"")} onClick={()=>setF({...f,pouch:!f.pouch})}>{f.pouch&&"✓"}</div><span onClick={()=>setF({...f,pouch:!f.pouch})}>Money pouch + reconciliation form handed over</span></label>
      <label className="check" style={{border:"none"}}><div className={"cbox "+(f.keys?"on":"")} onClick={()=>setF({...f,keys:!f.keys})}>{f.keys&&"✓"}</div><span onClick={()=>setF({...f,keys:!f.keys})}>House keys handed over</span></label>
      <button className="btn block" style={{marginTop:12}} onClick={save}>Post handover</button>
    </div>
    <div className="section-title">Handover feed</div>
    {handovers.length===0 ? <div className="card"><Empty text="Handovers from the team appear here — newest first."/></div> :
      handovers.map(h=><div key={h.id} className="card">
        <div className="row" style={{marginBottom:6}}>
          <div className="avatar">{h.fromName.slice(0,2).toUpperCase()}</div>
          <div className="grow"><b style={{fontSize:14}}>{h.fromName} → {h.toName}</b><div className="tiny">{fmtDate(h.at)} {fmtTime(h.at)}</div></div>
          {h.pouch && <span className="pill brand">💰 pouch</span>}
        </div>
        <p style={{fontSize:14,margin:"4px 0",whiteSpace:"pre-wrap"}}>{h.summary}</p>
        {h.outstanding && <p className="muted" style={{margin:"4px 0"}}>📌 {h.outstanding}</p>}
        {h.ack ? <span className="pill ok">✓ Read by {h.ack.by} at {fmtTime(h.ack.at)}</span> :
          <button className="btn sm sec" onClick={()=>ack(h.id)}>Mark as read</button>}
      </div>)}
  </div>;
}

/* ================= INCIDENTS ================= */
const INC_CATS = ["Verbal aggression","Major escalation","Left property without notice","Medication refusal","Missed appointment","Fire or stove risk","Property damage","Safety concern","Other"];
function Incidents({user,incidents,setIncidents,toast}){
  const [open,setOpen] = useState(false);
  const [f,setF] = useState({category:INC_CATS[0],severity:"moderate",when:"",description:"",actions:"",notified:false});
  const save = ()=>{
    if(!f.description.trim()) return;
    const inc = {id:uid(),...f,description:f.description.trim(),actions:f.actions.trim(),by:user.name,at:new Date().toISOString(),occurred:f.when||new Date().toISOString(),status:"open"};
    setIncidents(prev=>[inc,...prev]);
    audit(user.name,"incident",{category:f.category,severity:f.severity});
    setF({category:INC_CATS[0],severity:"moderate",when:"",description:"",actions:"",notified:false}); setOpen(false);
    toast(f.notified?"Incident saved ✓":"Saved — remember to CALL the office, the app doesn't replace the phone call");
  };
  const close = (id)=>{ setIncidents(prev=>prev.map(i=>i.id===id?{...i,status:"closed"}:i)); };
  const sevPill = s=>s==="critical"||s==="high"?"danger":s==="moderate"?"warn":"ok";
  return <div>
    <div className="alert danger" style={{fontSize:13}}><b>The app does not replace the phone.</b> For anything on the "call the office immediately" list — refusals, leaving property, fire risk, aggression, missing — <b>call first</b>, then document here.</div>
    {!open && <button className="btn block" style={{marginBottom:14}} onClick={()=>setOpen(true)}>＋ New incident report</button>}
    {open && <div className="card">
      <div className="grid2">
        <Field label="Category"><select value={f.category} onChange={e=>setF({...f,category:e.target.value})}>{INC_CATS.map(c=><option key={c}>{c}</option>)}</select></Field>
        <Field label="Severity"><select value={f.severity} onChange={e=>setF({...f,severity:e.target.value})}><option value="low">Low</option><option value="moderate">Moderate</option><option value="high">High</option><option value="critical">Critical</option></select></Field>
      </div>
      <Field label="When did it occur?"><input type="datetime-local" value={f.when} onChange={e=>setF({...f,when:e.target.value})}/></Field>
      <Field label="What happened? (factual, objective — what you saw and heard)">
        <textarea style={{minHeight:120}} value={f.description} onChange={e=>setF({...f,description:e.target.value})} placeholder="Time, place, what led up to it, exactly what occurred, who was present."/></Field>
      <Field label="Actions taken (BSP strategies used, who you contacted)">
        <textarea value={f.actions} onChange={e=>setF({...f,actions:e.target.value})} placeholder="e.g. Stopped all demands, gave space, used minimal words. Called Angel at 3:12pm — advised to monitor."/></Field>
      <label className="check" style={{border:"none"}}><div className={"cbox "+(f.notified?"on":"")} onClick={()=>setF({...f,notified:!f.notified})}>{f.notified&&"✓"}</div><span onClick={()=>setF({...f,notified:!f.notified})}>Office / Case Manager notified by phone</span></label>
      <div className="row" style={{marginTop:10}}>
        <button className="btn grow" onClick={save}>Save incident</button>
        <button className="btn sec" onClick={()=>setOpen(false)}>Cancel</button>
      </div>
    </div>}
    <div className="section-title">Incident log</div>
    {incidents.length===0 ? <div className="card"><Empty text="No incidents recorded."/></div> :
      incidents.map(i=><div key={i.id} className="card">
        <div className="row" style={{marginBottom:4}}>
          <b className="grow" style={{fontSize:14}}>{i.category}</b>
          <span className={"pill "+sevPill(i.severity)}>{i.severity}</span>
          <span className={"pill "+(i.status==="open"?"warn":"ok")}>{i.status}</span>
        </div>
        <div className="tiny">{fmtDate(i.occurred)} · reported by {i.by} · {i.notified?"office notified ✓":"⚠ office NOT marked notified"}</div>
        <p style={{fontSize:13.5,margin:"6px 0"}}>{i.description}</p>
        {i.actions && <p className="muted" style={{margin:"4px 0"}}>Actions: {i.actions}</p>}
        {i.status==="open" && <button className="btn ghost sm" onClick={()=>close(i.id)}>Mark closed</button>}
      </div>)}
  </div>;
}

/* ================= CHECKLIST & CLEANING ================= */
function Checklist({user,checklist,checkLog,setCheckLog}){
  const day = todayStr();
  const [kind,setKind] = useState("daily");
  const toggle = (t)=>{
    const existing = checkLog.find(l=>l.day===day && l.templateId===t.id);
    if(existing) setCheckLog(prev=>prev.filter(l=>l.id!==existing.id));
    else { setCheckLog(prev=>[{id:uid(),templateId:t.id,day,by:user.name,at:new Date().toISOString()},...prev]); audit(user.name,"check",{item:t.label}); }
  };
  const items = checklist.filter(c=>c.kind===kind).sort((a,b)=>a.sort-b.sort);
  const done = items.filter(t=>checkLog.some(l=>l.day===day&&l.templateId===t.id)).length;
  return <div>
    <div className="seg">
      <button className={kind==="daily"?"on":""} onClick={()=>setKind("daily")}>Daily checklist</button>
      <button className={kind==="cleaning"?"on":""} onClick={()=>setKind("cleaning")}>Cleaning schedule</button>
    </div>
    <div className="card">
      <div className="row" style={{marginBottom:6}}><h3 className="grow">{kind==="daily"?"Today's essentials":"House cleaning"}</h3><span className="pill brand">{done}/{items.length}</span></div>
      {items.map(t=>{
        const l = checkLog.find(x=>x.day===day&&x.templateId===t.id);
        return <div key={t.id} className="check" onClick={()=>toggle(t)} style={{cursor:"pointer"}}>
          <div className={"cbox "+(l?"on":"")}>{l&&"✓"}</div>
          <div className="grow"><span style={l?{opacity:.55,textDecoration:"line-through"}:{}}>{t.label}</span>
            {l && <div className="tiny">✓ {l.by} · {fmtTime(l.at)}</div>}</div>
        </div>;
      })}
    </div>
  </div>;
}

/* ================= CALENDAR ================= */
function Calendar({appts}){
  const days = useMemo(()=>{
    const out=[];
    for(let i=0;i<21;i++){
      const d=new Date(); d.setDate(d.getDate()+i); d.setHours(0,0,0,0);
      const todays = appts.filter(a=>{
        if(d.getDay()!==a.day) return false;
        if(a.anchor){ const weeks = Math.round((d - new Date(a.anchor))/6048e5); return weeks%2===0; }
        return true;
      });
      if(todays.length) out.push({date:d,items:todays});
    }
    return out;
  },[appts]);
  return <div>
    <div className="alert brand" style={{fontSize:13}}>Discuss appointments <b>calmly and early</b> — they can be a stressful reminder of illness. Never rush him; build in extra time.</div>
    {days.map(({date,items})=><div key={date.toISOString()} className="card">
      <b style={{fontSize:14}}>{date.toLocaleDateString("en-AU",{weekday:"long",day:"numeric",month:"long"})}{date.toDateString()===new Date().toDateString()?" — TODAY":""}</b>
      {items.map(a=><div key={a.id} className="list-item">
        <div className="avatar" style={{borderRadius:12,background:"var(--accentSoft)",color:"var(--accent)"}}>📍</div>
        <div className="grow">
          <b style={{fontSize:14}}>{a.title}</b>
          <div className="tiny">{a.location}{a.phone?" · "+a.phone:""}</div>
          <div className="tiny" style={{marginTop:2}}>{a.notes}</div>
        </div>
      </div>)}
    </div>)}
    <div className="card"><h3>Standing schedule</h3>
      {appts.map(a=><div key={a.id} className="kv"><span>{a.title}</span><b>{a.recurrence}</b></div>)}
    </div>
  </div>;
}

/* ================= INVENTORY ================= */
function Inventory({inventory,setInventory,toast}){
  const [add,setAdd] = useState({item:"",category:"groceries"});
  const bump = (id,d)=>setInventory(prev=>prev.map(i=>i.id===id?{...i,quantity:Math.max(0,i.quantity+d)}:i));
  const addItem = ()=>{
    if(!add.item.trim()) return;
    setInventory(prev=>[...prev,{id:uid(),item:add.item.trim(),category:add.category,quantity:1,low:1}]);
    setAdd({item:"",category:"groceries"}); toast("Item added");
  };
  const low = inventory.filter(i=>i.quantity<=i.low);
  const cats = [...new Set(inventory.map(i=>i.category))];
  return <div>
    {low.length>0 && <div className="alert warn"><b>Running low:</b> {low.map(i=>i.item).join(", ")}. Add to the next shopping trip (record spending in Money).</div>}
    {cats.map(c=><div key={c} className="card">
      <h3 style={{textTransform:"capitalize"}}>{c}</h3>
      {inventory.filter(i=>i.category===c).map(i=><div key={i.id} className="list-item">
        <div className="grow"><b style={{fontSize:14}}>{i.item}</b>{i.note&&<div className="tiny">{i.note}</div>}</div>
        <div className="row">
          <button className="btn sm sec" onClick={()=>bump(i.id,-1)}>−</button>
          <b style={{minWidth:22,textAlign:"center",color:i.quantity<=i.low?"var(--danger)":"inherit"}}>{i.quantity}</b>
          <button className="btn sm sec" onClick={()=>bump(i.id,1)}>＋</button>
        </div>
      </div>)}
    </div>)}
    <div className="card"><h3>Add item</h3>
      <div className="row" style={{marginTop:8}}>
        <input className="grow" placeholder="Item name" value={add.item} onChange={e=>setAdd({...add,item:e.target.value})}/>
        <select style={{width:130}} value={add.category} onChange={e=>setAdd({...add,category:e.target.value})}>
          {["groceries","hygiene","cleaning","personal","medical","other"].map(c=><option key={c}>{c}</option>)}
        </select>
      </div>
      <button className="btn block sm" style={{marginTop:10}} onClick={addItem}>Add</button>
    </div>
  </div>;
}

/* ================= GLOBAL SEARCH ================= */
function buildIndex(state){
  const P = state.participant || SEED_PARTICIPANT; const idx=[];
  const push=(section,view,text)=>text&&idx.push({section,view,text:String(text)});
  ["triggers","warningSigns","escalationSteps","routine","observations","fireSafety","hygiene","leavesProperty","callOfficeFor","neverRules","commsDo","commsDont","moneyRules"].forEach(k=>P[k].forEach(t=>push(k.replace(/([A-Z])/g," $1").toLowerCase(),"profile",t)));
  P.contacts.forEach(c=>push("contact","profile",`${c.name} ${c.role} ${c.phone||""} ${c.note}`));
  SEED_MEDS.forEach(m=>push("medication","meds",`${m.name} ${m.dose} ${m.timeLabel} ${m.instructions}`));
  SEED_APPTS.forEach(a=>push("appointment","calendar",`${a.title} ${a.recurrence} ${a.location} ${a.notes}`));
  state.notes.forEach(n=>push("progress note ("+fmtDate(n.at)+")","notes",n.narrative));
  state.handovers.forEach(h=>push("handover ("+h.fromName+")","handover",h.summary+" "+(h.outstanding||"")));
  state.incidents.forEach(i=>push("incident ("+i.category+")","incidents",i.description+" "+(i.actions||"")));
  (state.quickItems||[]).forEach(q=>push("plan item","home",q.title+" "+(q.raw||"")));
  return idx;
}
function Search({state,go}){
  const [q,setQ] = useState("");
  const idx = useMemo(()=>buildIndex(state),[state.notes,state.handovers,state.incidents]);
  const hits = useMemo(()=>{
    const s=q.trim().toLowerCase(); if(s.length<2) return [];
    return idx.filter(x=>x.text.toLowerCase().includes(s)).slice(0,40);
  },[q,idx]);
  const mark = (t)=>{
    const s=q.trim(); const i=t.toLowerCase().indexOf(s.toLowerCase());
    if(i<0) return t.slice(0,140);
    const st=Math.max(0,i-50);
    return <span>…{t.slice(st,i)}<mark>{t.slice(i,i+s.length)}</mark>{t.slice(i+s.length,i+s.length+90)}…</span>;
  };
  return <div>
    <input autoFocus placeholder="Search everything — 'clozapine', 'pouch', 'smoking', 'Batoul'…" value={q} onChange={e=>setQ(e.target.value)} style={{marginBottom:12}}/>
    {q.length>=2 && hits.length===0 && <div className="card"><Empty text="No matches."/></div>}
    {hits.map((h,i)=><div key={i} className="card search-hit" onClick={()=>go(h.view)} style={{cursor:"pointer",padding:"12px 14px"}}>
      <span className="pill brand" style={{marginBottom:6}}>{h.section}</span>
      <p style={{fontSize:13.5,margin:"6px 0 0"}}>{mark(h.text)}</p>
    </div>)}
    {q.length<2 && <div className="card">
      <h3>Try searching for</h3>
      {["clozapine","injection","blood test","pouch","receipt","Batoul","smoking","stove","prayer","triggers","000","escalate","Georges Hall","coffee"].map(s=><button key={s} className="chip" onClick={()=>setQ(s)}>{s}</button>)}
    </div>}
  </div>;
}

/* ================= ANALYTICS ================= */
function Analytics({state}){
  const days = [...Array(14)].map((_,i)=>{const d=new Date();d.setDate(d.getDate()-13+i);return localDay(d)});
  const medRate = days.map(d=>state.medLog.filter(l=>l.day===d&&l.status==="given").length);
  const refusals = state.medLog.filter(l=>l.status==="refused").length;
  const incBySev = ["low","moderate","high","critical"].map(s=>[s,state.incidents.filter(i=>i.severity===s).length]);
  const spend = state.moneyDays.reduce((a,d)=>a+d.tx.reduce((x,t)=>x+t.amount,0),0);
  const receiptsMissing = state.moneyDays.reduce((a,d)=>a+d.tx.filter(t=>!t.receipt).length,0);
  const max = Math.max(1,...medRate);
  return <div>
    <div className="grid2">
      <div className="card" style={{textAlign:"center"}}><div className="tiny">PROGRESS NOTES</div><div className="big-num">{state.notes.length}</div></div>
      <div className="card" style={{textAlign:"center"}}><div className="tiny">MED REFUSALS</div><div className="big-num" style={refusals?{color:"var(--danger)"}:{}}>{refusals}</div></div>
      <div className="card" style={{textAlign:"center"}}><div className="tiny">TOTAL SPEND TRACKED</div><div className="big-num">{fmtMoney(spend)}</div></div>
      <div className="card" style={{textAlign:"center"}}><div className="tiny">RECEIPTS MISSING</div><div className="big-num" style={receiptsMissing?{color:"var(--warn)"}:{}}>{receiptsMissing}</div></div>
    </div>
    <div className="card">
      <h3>Doses recorded — last 14 days</h3>
      <div style={{display:"flex",alignItems:"flex-end",gap:4,height:90,marginTop:10}}>
        {medRate.map((v,i)=><div key={i} style={{flex:1,background:v?"var(--brand)":"var(--surface2)",borderRadius:4,height:Math.max(6,v/max*84)+"px"}} title={days[i]+": "+v}/>)}
      </div>
      <div className="tiny" style={{marginTop:6}}>Target: 2 per day (morning tablet + 5:30pm Clozapine). Gaps = missed logging or missed doses — follow up either way.</div>
    </div>
    <div className="card"><h3>Incidents by severity</h3>
      {incBySev.map(([s,n])=><div key={s} className="kv"><span style={{textTransform:"capitalize"}}>{s}</span><b>{n}</b></div>)}
    </div>
  </div>;
}

/* ================= ADMIN ================= */
function Admin({user,users,setUsers,toast}){
  const [auditView,setAuditView] = useState(false);
  const auditLog = LS.get("audit",[]);
  const setRole=(id,role)=>{ setUsers(prev=>prev.map(u=>u.id===id?{...u,role}:u)); audit(user.name,"role_change",{id,role}); };
  const exportAll = ()=>{
    const dump = {}; ["users","notes","medLog","moneyDays","handovers","incidents","checkLog","inventory","shifts","audit"].forEach(k=>dump[k]=LS.get(k,[]));
    const blob = new Blob([JSON.stringify(dump,null,2)],{type:"application/json"});
    const a = document.createElement("a"); a.href=URL.createObjectURL(blob);
    a.download = `borealis-silos-backup-${todayStr()}.json`; a.click();
    toast("Backup downloaded — store it securely, it contains participant data");
  };
  if(user.role!=="admin" && user.role!=="team_leader") return <div className="card"><Empty text="Admin access only. Ask an administrator to change your role."/></div>;
  return <div>
    <div className="card">
      <h3>Team & roles</h3>
      {users.map(u=><div key={u.id} className="list-item">
        <div className="avatar">{u.name.slice(0,2).toUpperCase()}</div>
        <div className="grow"><b style={{fontSize:14}}>{u.name}</b><div className="tiny">{u.email}</div></div>
        {user.role==="admin" ? <select style={{width:150,padding:"7px 9px",fontSize:13}} value={u.role} onChange={e=>setRole(u.id,e.target.value)}>
          {Object.entries(ROLE_LABEL).map(([k,l])=><option key={k} value={k}>{l}</option>)}
        </select> : <span className="pill brand">{ROLE_LABEL[u.role]}</span>}
      </div>)}
      <p className="tiny" style={{marginTop:8}}>New workers appear here automatically the first time they sign in. In Supabase mode, roles live in the profiles table and RLS enforces them server-side.</p>
    </div>
    <div className="card">
      <h3>Audit trail</h3>
      <p className="tiny">Every login, dose, dollar, note, incident and role change is stamped with who and when. {auditLog.length} events on this device.</p>
      <button className="btn sm sec" onClick={()=>setAuditView(!auditView)}>{auditView?"Hide":"View"} last 50 events</button>
      {auditView && <div style={{marginTop:10,maxHeight:300,overflowY:"auto"}}>
        {auditLog.slice(0,50).map((a,i)=><div key={i} className="tiny" style={{padding:"5px 0",borderBottom:"1px solid var(--border)"}}>
          {new Date(a.at).toLocaleString("en-AU")} · <b>{a.actor}</b> · {a.action} {a.detail?JSON.stringify(a.detail).slice(0,80):""}</div>)}
      </div>}
    </div>
    <div className="card">
      <h3>Data</h3>
      <button className="btn sec block" onClick={exportAll}>⬇ Export encrypted-device backup (JSON)</button>
      <p className="tiny" style={{marginTop:8}}>For new participants: this app is participant-scoped by design. Duplicate the deployment, replace the profile seed (or add a participant row in Supabase) — no rewrite needed.</p>
    </div>
  </div>;
}

/* ================= SETTINGS ================= */
function Settings({user,onLogout,theme,setTheme,toast}){
  const cfg = LS.get("sbcfg",{url:"",key:""});
  const [url,setUrl] = useState(cfg.url); const [key,setKey] = useState(cfg.key);
  const saveSb = ()=>{ LS.set("sbcfg",{url:url.trim(),key:key.trim()}); toast("Saved — reload the app to connect"); };
  return <div>
    <div className="card">
      <div className="row"><div className="avatar" style={{width:46,height:46}}>{user.name.slice(0,2).toUpperCase()}</div>
        <div className="grow"><b>{user.name}</b><div className="tiny">{user.email} · {ROLE_LABEL[user.role]}</div></div></div>
      <button className="btn sec block" style={{marginTop:14}} onClick={onLogout}>Sign out</button>
    </div>
    <div className="card">
      <h3>Appearance</h3>
      <div className="row" style={{marginTop:8}}>
        <button className={"btn sm grow "+(theme==="light"?"":"sec")} onClick={()=>setTheme("light")}>☀ Light</button>
        <button className={"btn sm grow "+(theme==="dark"?"":"sec")} onClick={()=>setTheme("dark")}>🌙 Dark</button>
        <button className={"btn sm grow "+(theme==="auto"?"":"sec")} onClick={()=>setTheme("auto")}>Auto</button>
      </div>
    </div>
    <div className="card">
      <h3>Supabase (team database)</h3>
      <p className="tiny">Run <b>supabase-schema.sql</b> in a new Supabase project, then paste your Project URL and anon key. The app switches to secure email sign-in with Row Level Security, and the whole team shares one live database.</p>
      <Field label="Project URL"><input value={url} onChange={e=>setUrl(e.target.value)} placeholder="https://xxxx.supabase.co"/></Field>
      <Field label="Anon (public) key"><input value={key} onChange={e=>setKey(e.target.value)} placeholder="eyJhbGciOi…"/></Field>
      <button className="btn block" style={{marginTop:12}} onClick={saveSb}>Save connection</button>
    </div>
    <div className="card">
      <h3>Install as an app</h3>
      <p className="tiny">iPhone: Share → Add to Home Screen. Android: menu → Install app. Works offline — everything syncs from this device's storage.</p>
    </div>
    <p className="tiny" style={{textAlign:"center"}}>Borealis SIL OS v{APP_VER} · Confidential · Participant data must never be shared outside the authorised team.</p>
  </div>;
}

/* ================= MORE HUB ================= */
function MoreHub({go,user}){
  const items = [
    ["calendar","Appointments","Blood tests · injections · pickups",I.cal],
    ["money","Money reconciliation","Pouch, receipts, daily form",I.money],
    ["incidents","Incident reports","Document and escalate",I.alertT],
    ["checklist","Checklist & cleaning","Daily essentials + house",I.checkl],
    ["inventory","Inventory","Groceries, hygiene, supplies",I.box],
    ["handover","Handover","Team feed + acknowledgements",I.hand],
    ["search","Search everything","BSP, notes, incidents, contacts",I.search],
    ["analytics","Analytics","Meds, incidents, spending",I.chart],
    ["admin","Admin portal","Users, roles, audit, backup",I.shield],
    ["settings","Settings","Theme, Supabase, account",I.gear],
  ];
  return <div className="grid2">
    {items.map(([v,t,s,Ic])=><button key={v} className="tile" onClick={()=>go(v)}>
      <div className="ic"><Ic/></div><b>{t}</b><span>{s}</span>
    </button>)}
  </div>;
}

/* ================= APP SHELL ================= */
const TITLES = {home:"Dashboard",profile:"About Muhamad",shift:"Shift",notes:"Progress notes",meds:"Medication",money:"Money",handover:"Handover",incidents:"Incidents",checklist:"Checklist",calendar:"Appointments",inventory:"Inventory",search:"Search",analytics:"Analytics",admin:"Admin",settings:"Settings",more:"More"};

function App(){
  const [user,setUser] = useState(()=>LS.get("session",null));
  const [view,setView] = useState("home");
  const [subTab,setSubTab] = useState(null);
  const [theme,setThemeRaw] = useState(()=>LS.get("theme","auto"));
  const [toastMsg,setToastMsg] = useState("");

  const [users,setUsers] = useStore("users",SEED_USERS);
  const [notes,setNotes] = useStore("notes",[]);
  const [medLog,setMedLog] = useStore("medLog",[]);
  const [moneyDays,setMoneyDays] = useStore("moneyDays",[]);
  const [handovers,setHandovers] = useStore("handovers",[]);
  const [incidents,setIncidents] = useStore("incidentsv",LS.get("incidents",[]));
  const [checkLog,setCheckLog] = useStore("checkLog",[]);
  const [inventory,setInventory] = useStore("inventory",SEED_INVENTORY);
  const [shifts,setShifts] = useStore("shifts",[]);
  const [shift,setShift] = useState(()=>LS.get("activeShift",null));
  const [participant,setParticipant] = useStore("participant",SEED_PARTICIPANT);
  const [quickItems,setQuickItems] = useStore("quickItems",[]);
  const [quickOpen,setQuickOpen] = useState(false);
  const checklist = SEED_CHECKLIST;
  const appts = SEED_APPTS;

  const setTheme = t=>{ setThemeRaw(t); LS.set("theme",t); };
  useEffect(()=>{
    const apply = ()=>{
      const dark = theme==="dark" || (theme==="auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.setAttribute("data-theme", dark?"dark":"light");
    };
    apply();
    const mq = window.matchMedia("(prefers-color-scheme: dark)");
    mq.addEventListener && mq.addEventListener("change",apply);
    return ()=>mq.removeEventListener && mq.removeEventListener("change",apply);
  },[theme]);

  const toast = (m)=>{ setToastMsg(m); setTimeout(()=>setToastMsg(""),3200); };
  const go = (v,sub)=>{ setView(v); setSubTab(sub||null); window.scrollTo(0,0); };
  const login = (u)=>{ setUser(u); LS.set("session",u); };
  const logout = ()=>{ setUser(null); LS.del("session"); setView("home"); };

  // Notification permission + Clozapine reminder while app open
  useEffect(()=>{
    if(!user) return;
    if("Notification" in window && Notification.permission==="default") Notification.requestPermission();
    const iv = setInterval(()=>{
      const n = new Date();
      if(n.getHours()===17 && n.getMinutes()===25){
        const day = todayStr();
        const done = LS.get("medLog",[]).some(l=>l.day===day && l.nameKey==="m1");
        if(!done && "Notification" in window && Notification.permission==="granted")
          new Notification("Clozapine due at 5:30 PM",{body:"Calm wording: \"Here's your medication, Muhamad.\" Log it in the app."});
      }
    },55000);
    return ()=>clearInterval(iv);
  },[user]);

  // keep live user object fresh if role changed in admin
  const liveUser = user ? (users.find(u=>u.id===user.id)||user) : null;

  if(!liveUser) return <><Login users={users} setUsers={setUsers} onLogin={login}/><Toast msg={toastMsg}/></>;

  const state = {notes,handovers,incidents,medLog,moneyDays,participant,quickItems};
  const showNoteFab = shift && !["notes","search"].includes(view);
  const showAddFab = !["search","settings","admin"].includes(view);

  return <div className="app">
    <div className="hdr">
      <div className="grow">
        <div className="logo">Borealis <span style={{fontWeight:400,opacity:.8}}>SIL OS</span></div>
        <div className="sub">{TITLES[view]||""} · Muhamad Khayat</div>
      </div>
      <button onClick={()=>go("search")} style={{color:"#F7F3E3",width:38,height:38,display:"flex",alignItems:"center",justifyContent:"center"}} aria-label="Search"><div style={{width:22,height:22}}><I.search/></div></button>
      <button onClick={()=>go("settings")} className="avatar" style={{background:"rgba(255,255,255,.15)",color:"#F7F3E3",width:36,height:36,fontSize:13}}>{liveUser.name.slice(0,2).toUpperCase()}</button>
    </div>

    <div className="main">
      {view==="home" && <Dashboard user={liveUser} go={go} shift={shift} meds={SEED_MEDS} medLog={medLog} appts={appts} checkLog={checkLog} checklist={checklist} handovers={handovers} moneyDays={moneyDays} incidents={incidents} quickItems={quickItems} setQuickItems={setQuickItems}/>}
      {view==="profile" && <Profile initialTab={subTab} participant={participant} setParticipant={setParticipant} user={liveUser} toast={toast}/>}
      {view==="shift" && <Shift user={liveUser} shift={shift} setShift={setShift} shifts={shifts} setShifts={setShifts} go={go} toast={toast}/>}
      {view==="notes" && <Notes user={liveUser} notes={notes} setNotes={setNotes} shift={shift} toast={toast}/>}
      {view==="meds" && <Meds user={liveUser} medLog={medLog} setMedLog={setMedLog} toast={toast}/>}
      {view==="money" && <Money user={liveUser} moneyDays={moneyDays} setMoneyDays={setMoneyDays} toast={toast}/>}
      {view==="handover" && <Handover user={liveUser} users={users} handovers={handovers} setHandovers={setHandovers} toast={toast} quickItems={quickItems}/>}
      {view==="incidents" && <Incidents user={liveUser} incidents={incidents} setIncidents={setIncidents} toast={toast}/>}
      {view==="checklist" && <Checklist user={liveUser} checklist={checklist} checkLog={checkLog} setCheckLog={setCheckLog}/>}
      {view==="calendar" && <Calendar appts={appts}/>}
      {view==="inventory" && <Inventory inventory={inventory} setInventory={setInventory} toast={toast}/>}
      {view==="search" && <Search state={state} go={go}/>}
      {view==="analytics" && <Analytics state={state}/>}
      {view==="admin" && <Admin user={liveUser} users={users} setUsers={setUsers} toast={toast}/>}
      {view==="settings" && <Settings user={liveUser} onLogout={logout} theme={theme} setTheme={setTheme} toast={toast}/>}
      {view==="more" && <MoreHub go={go} user={liveUser}/>}
    </div>

    {showAddFab && <button className={"fab-add"+(showNoteFab?" up":"")} onClick={()=>setQuickOpen(true)}>＋ Add</button>}
    {showNoteFab && <button className="fab-note" onClick={()=>go("notes")}><div style={{width:18,height:18}}><I.note/></div> Note</button>}
    <QuickAdd open={quickOpen} onClose={()=>setQuickOpen(false)} user={liveUser} setQuickItems={setQuickItems} toast={toast}/>

    <div className="nav">
      {[["home","Home",I.home],["profile","Muhamad",I.user],["shift","Shift",I.shift],["meds","Meds",I.pill],["more","More",I.more]].map(([v,l,Ic])=>
        <button key={v} className={view===v||(v==="more"&&!["home","profile","shift","meds"].includes(view))?"on":""} onClick={()=>go(v)}>
          <Ic/>{l}
        </button>)}
    </div>
    <Toast msg={toastMsg}/>
  </div>;
}

ReactDOM.createRoot(document.getElementById("root")).render(<App/>);

/* Service worker */
if("serviceWorker" in navigator && location.protocol==="https:"){
  window.addEventListener("load",()=>navigator.serviceWorker.register("sw.js").catch(()=>{}));
}
</script>
</body>
</html>
