/* lightweight roster line parser — strips the date out first so date
   separators (e.g. the “-” in 2026-07-10) never get read as times */
function parseShiftLine(line,type){
  line=line.trim(); if(!line) return null;
  const months={jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};
  const now=new Date(); let year=now.getFullYear(), mo=null, day=null;
  let work=' '+line+' ';
  // ISO date  2026-07-10
  let m=work.match(/(\d{4})-(\d{1,2})-(\d{1,2})/);
  if(m){ year=+m[1]; mo=+m[2]-1; day=+m[3]; work=work.replace(m[0],' '); }
  if(mo===null){ // "8 Jul" or "Jul 8"
    let dm=work.match(/(\d{1,2})\s*(?:st|nd|rd|th)?\s+([a-z]{3,})/i);
    let md=work.match(/([a-z]{3,})\s+(\d{1,2})/i);
    if(dm && months[dm[2].slice(0,3).toLowerCase()]!==undefined){ day=+dm[1]; mo=months[dm[2].slice(0,3).toLowerCase()]; work=work.replace(dm[0],' '); }
    else if(md && months[md[1].slice(0,3).toLowerCase()]!==undefined){ mo=months[md[1].slice(0,3).toLowerCase()]; day=+md[2]; work=work.replace(md[0],' '); }
  }
  if(mo===null){ // dd/mm  or  dd/mm/yy
    let dd=work.match(/(\d{1,2})\/(\d{1,2})(?:\/(\d{2,4}))?/);
    if(dd){ day=+dd[1]; mo=+dd[2]-1; if(dd[3]) year=+dd[3]<100?2000+ +dd[3]:+dd[3]; work=work.replace(dd[0],' '); }
  }
  if(mo===null||!day) return null;
  const date=`${year}-${String(mo+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
  // times — safe now, the date is gone from `work`
  let start='',end='';
  const tm=work.match(/(\d{1,2}(?::\d{2})?\s*(?:am|pm)?)\s*(?:-|–|—|to)\s*(\d{1,2}(?::\d{2})?\s*(?:am|pm)?)/i);
  if(tm){ start=to24(tm[1]); end=to24(tm[2]); work=work.replace(tm[0],' '); }
  // title = whatever's left
  let title=work
    .replace(/\b(mon|tue|wed|thu|fri|sat|sun)[a-z]*\b/ig,'')
    .replace(/\b\d{1,2}\s*(?:st|nd|rd|th)?\b/ig,'')
    .replace(/[-–—,:]/g,' ').replace(/\s+/g,' ').trim();
  if(!title) title = type==='shift'?'Shift':'Event';
  return {title:title.charAt(0).toUpperCase()+title.slice(1), type, date, start, end, note:''};
}
function to24(str){
  str=str.trim().toLowerCase(); const pm=/pm/.test(str), am=/am/.test(str);
  let[h,mn]=str.replace(/[apm\s]/g,'').split(':'); h=parseInt(h); mn=mn?parseInt(mn):0;
  if(pm&&h<12)h+=12; if(am&&h===12)h=0;
  return String(h).padStart(2,'0')+':'+String(mn).padStart(2,'0');
}

