      <div className="tiny muted" style={{marginBottom:14}}>You can tap each side to upload photos after creating.</div>
      <button className="btn btn-primary btn-lg" style={{width:"100%"}} onClick={add}>Create showcase</button>
    </Modal>}
  </React.Fragment>;
}

