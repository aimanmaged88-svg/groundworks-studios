      <div className="modal-head"><div className="h2">{title}</div><button className="x" onClick={onClose}>✕</button></div>
      {children}
    </div>
  </div>;
}
function Field({label,children}){ return <div className="field"><label className="label">{label}</label>{children}</div>; }
function Stat({label,value,delta,tone,onClick}){
  return <div className={"stat"+(onClick?" clickable":"")} onClick={onClick} style={onClick?{cursor:"pointer"}:null}>
    <div className="l">{label}{onClick&&<span className="faint" style={{float:"right",fontWeight:700}}>→</span>}</div>
    <div className="v money">{value}</div>
    {delta!=null && <div className="d" style={{color:tone==="bad"?"var(--bad)":tone==="warn"?"var(--warn)":"var(--good)"}}>{delta}</div>}</div>;
}
function Empty({icon,title,sub,action}){
  return <div className="empty"><div className="big">{icon}</div><div className="h3" style={{color:"var(--text)"}}>{title}</div>
    <div className="tiny" style={{margin:"4px 0 14px"}}>{sub}</div>{action}</div>;
