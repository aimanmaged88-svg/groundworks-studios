function Leads(props){
  const {tenant,ind,data,setData,toast}=props;
  const [filter,setFilter]=useState("all");
  const [modal,setModal]=useState(null); // "new" | lead object
  const stages=["new","contacted","quoted","won","lost"];
  const shown=data.leads.filter(l=>filter==="all"?true:l.stage===filter);

  const saveLead=l=>{
    setData(d=>{
      if(l.id){ d.leads=d.leads.map(x=>x.id===l.id?l:x); }
      else{
        l={...l,id:uid(),stage:"new",createdAt:todayISO()};
        d.leads.unshift(l);
        d.activity.unshift({id:uid(),text:"New lead: "+l.name+" ("+l.source+")",date:todayISO(),icon:"🎯"});
        runAutomations(d,"lead_created",{name:l.name,brandName:tenant.name});
      }
      return d;
    });
    setModal(null); toast(l.id?"Lead updated":"Lead added — instant SMS sent ⚙️");
  };
  const setStage=(l,stage)=>{
    setData(d=>{
      d.leads=d.leads.map(x=>x.id===l.id?{...x,stage}:x);
      if(stage==="won" && !d.customers.some(c=>c.email===l.email)){
        d.customers.unshift({id:uid(),name:l.name,phone:l.phone,email:l.email,address:(l.suburb||"")+" NSW",notes:"Converted from lead ("+l.source+")",createdAt:todayISO(),tags:[]});
        d.activity.unshift({id:uid(),text:l.name+" converted to customer 🎉",date:todayISO(),icon:"🎉"});
      }
      return d;
    });
    toast(stage==="won"?"Lead won — added to Customers 🎉":"Moved to "+stage);
  };

  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Leads</div><div className="muted tiny">Every enquiry, captured and chased. Speed wins jobs.</div></div>
      <button className="btn btn-primary no-print" onClick={()=>setModal("new")}>+ Add lead</button>
    </div>
    <div className="pills" style={{marginBottom:14}}>
      {["all",...stages].map(s=><button key={s} className={"pill"+(filter===s?" active":"")} onClick={()=>setFilter(s)}>
        {s==="all"?"All ("+data.leads.length+")":s[0].toUpperCase()+s.slice(1)}</button>)}
    </div>
    <div className="card">
      <div className="list">
        {shown.map(l=><div key={l.id} className="list-row">
          <Avatar name={l.name}/>
          <div style={{flex:1,minWidth:0,cursor:"pointer"}} onClick={()=>setModal(l)}>
            <div style={{fontWeight:600}}>{l.name} <span className="tiny faint">· {l.suburb}</span></div>
            <div className="tiny muted" style={{whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis"}}>{l.need} · via {l.source} · est {fmt$(l.value)}</div>
          </div>
          <select className="select" style={{width:130,padding:"6px 8px",fontSize:12.5}} value={l.stage} onChange={e=>setStage(l,e.target.value)}>
            {stages.map(s=><option key={s} value={s}>{s[0].toUpperCase()+s.slice(1)}</option>)}
          </select>
        </div>)}
        {shown.length===0 && <Empty icon="🎯" title="No leads here" sub="New enquiries land in this pipeline automatically." action={<button className="btn btn-primary btn-sm" onClick={()=>setModal("new")}>Add your first lead</button>}/>}
      </div>
    </div>
    {modal && <LeadModal lead={modal==="new"?null:modal} ind={ind} onSave={saveLead} onClose={()=>setModal(null)}/>}
  </React.Fragment>;
}
function LeadModal({lead,ind,onSave,onClose}){
  const [f,setF]=useState(lead||{name:"",phone:"",email:"",suburb:"",source:"Website",need:ind.rates[0].name,value:1000});
  return <Modal title={lead?"Edit lead":"New lead"} onClose={onClose}>
    <Field label="Name"><input className="input" autoFocus value={f.name} onChange={e=>setF({...f,name:e.target.value})}/></Field>
    <div className="grid2">
