      "cases": [
        { "dob": "2016-12-31", "expect": "U12" },
        { "dob": "2015-01-01", "expect": "U12" },
        { "dob": "2014-07-04", "expect": "U14" },
        { "dob": "2011-01-01", "expect": "U16" },
        { "dob": "2010-06-06", "expect": null },
        { "dob": "2008-12-31", "expect": "Seniors" },
        { "dob": "1990-01-01", "expect": "Seniors" },
