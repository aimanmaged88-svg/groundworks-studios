function FilesPage(props){
  const {data,setData,toast}=props;
  const upload=usePhotoUpload();
  const icons={pdf:"📕",doc:"📘",img:"🖼️",other:"📄"};
  const addFile=()=>{
    const inp=document.createElement("input"); inp.type="file";
    inp.onchange=()=>{ const f=inp.files[0]; if(!f) return;
      const rd=new FileReader();
      rd.onload=()=>{
        const type=f.type.includes("pdf")?"pdf":f.type.includes("image")?"img":f.name.match(/\.docx?$/)?"doc":"other";
        const data64=f.size<2_000_000? rd.result : null; // keep storage sane
        setData(d=>{ d.files.unshift({id:uid(),name:f.name,size:f.size>1e6?(f.size/1e6).toFixed(1)+" MB":Math.round(f.size/1024)+" KB",type,date:todayISO(),data:data64}); return d; });
        toast(data64?"File uploaded 📁":"File added (too large to store offline — metadata only)");
      };
      rd.readAsDataURL(f);
    };
    inp.click();
  };
  const download=f=>{
    if(!f.data){ toast("Demo file — no content stored"); return; }
    const a=document.createElement("a"); a.href=f.data; a.download=f.name; a.click();
  };
  const del=f=>{ setData(d=>{ d.files=d.files.filter(x=>x.id!==f.id); return d; }); toast("Deleted"); };
  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Files</div><div className="muted tiny">Insurance, licences, safety docs and job attachments — one place.</div></div>
      <button className="btn btn-primary no-print" onClick={addFile}>+ Upload</button>
    </div>
    <div className="card"><div className="list">
      {data.files.map(f=><div key={f.id} className="list-row">
        <span style={{fontSize:20}}>{icons[f.type]||icons.other}</span>
        <div style={{flex:1,minWidth:0}}>
          <div style={{fontWeight:600,whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis"}}>{f.name}</div>
          <div className="tiny faint">{f.size} · {fmtDate(f.date)}</div>
        </div>
        <button className="btn btn-ghost btn-sm" onClick={()=>download(f)}>↓</button>
        <button className="btn btn-ghost btn-sm" onClick={()=>del(f)}>🗑</button>
      </div>)}
      {data.files.length===0&&<Empty icon="📁" title="No files" sub="Upload licences, insurance and job docs."/>}
    </div></div>
  </React.Fragment>;
}

