function JobsPage(props){
  const {ind,data,setData,toast}=props;
  const [modal,setModal]=useState(null);
  const custById=id=>data.customers.find(c=>c.id===id)||{name:"—"};
  const teamById=id=>data.team.find(m=>m.id===id)||{name:"Unassigned"};
  const cols=[["scheduled","Scheduled"],["in_progress","In progress"],["done","Done"]];

  const setStatus=(j,status)=>{
    setData(d=>{
      d.jobs=d.jobs.map(x=>x.id===j.id?{...x,status}:x);
      if(status==="done"){
        const c=custById(j.customerId);
        d.activity.unshift({id:uid(),text:j.title+" completed for "+c.name,date:todayISO(),icon:"🏁"});
        runAutomations(d,"job_done",{customerName:c.name});
        if(j.value && !d.invoices.some(i=>i.jobId===j.id)){
          d.counters.invoice++;
          d.invoices.unshift({id:uid(),num:"INV-"+d.counters.invoice,customerId:j.customerId,jobId:j.id,title:j.title,
            amount:j.value,status:"sent",issuedAt:todayISO(),dueAt:addDays(todayISO(),14),paidAt:null,method:null});
          d.activity.unshift({id:uid(),text:"Invoice INV-"+d.counters.invoice+" auto-issued for "+j.title,date:todayISO(),icon:"🧾"});
        }
      }
      return d;
    });
    toast(status==="done"?"Done — invoice issued & review request sent ⚙️":"Moved to "+cols.find(c=>c[0]===status)[1]);
  };
  const save=j=>{
    setData(d=>{
      if(j.id) d.jobs=d.jobs.map(x=>x.id===j.id?j:x);
      else{ d.counters.job++; d.jobs.unshift({...j,id:uid(),num:"J-"+d.counters.job,status:"scheduled"}); }
      return d;
    });
    setModal(null); toast("Saved");
  };
  const del=j=>{
    setData(d=>{ d.jobs=d.jobs.filter(x=>x.id!==j.id); return d; });
    setModal(null); toast(ind.jobNoun[0].toUpperCase()+ind.jobNoun.slice(1)+" deleted");
  };

  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Jobs & Schedule</div><div className="muted tiny">Drag {ind.jobNoun}s through to done — invoicing and review requests fire automatically.</div></div>
      <button className="btn btn-primary no-print" onClick={()=>setModal("new")}>+ New {ind.jobNoun}</button>
    </div>
    <div className="kanban">
      {cols.map(([key,label])=><div key={key} className="kcol">
        <div className="spread" style={{padding:"4px 6px 10px"}}>
          <span className="h3">{label}</span>
          <span className="badge b-gray">{data.jobs.filter(j=>j.status===key).length}</span>
        </div>
        {data.jobs.filter(j=>j.status===key).sort((a,b)=>a.date.localeCompare(b.date)).map(j=><div key={j.id} className="kcard" onClick={()=>setModal(j)}>
          <div className="spread" style={{marginBottom:5}}>
            <span className="tiny faint">{j.num}</span>
            <span className="tiny" style={{fontWeight:700}}>{fmtDate(j.date)} · {j.time}</span>
          </div>
          <div style={{fontWeight:600,fontSize:13.5,marginBottom:3}}>{j.title}</div>
          <div className="tiny muted" style={{marginBottom:8}}>{custById(j.customerId).name}</div>
          <div className="spread">
            <div className="row" style={{gap:6}}><Avatar name={teamById(j.assigneeId).name} size={22}/><span className="tiny muted">{teamById(j.assigneeId).name}</span></div>
            <span className="tiny money" style={{fontWeight:700}}>{fmt$(j.value)}</span>
          </div>
          <div className="row no-print" style={{marginTop:9,gap:6}} onClick={e=>e.stopPropagation()}>
            {key!=="scheduled"&&<button className="btn btn-ghost btn-sm" style={{flex:1}} onClick={()=>setStatus(j,key==="done"?"in_progress":"scheduled")}>←</button>}
            {key!=="done"&&<button className="btn btn-primary btn-sm" style={{flex:2}} onClick={()=>setStatus(j,key==="scheduled"?"in_progress":"done")}>{key==="scheduled"?"Start":"Complete ✓"}</button>}
          </div>
        </div>)}
        {data.jobs.filter(j=>j.status===key).length===0&&<div className="empty tiny" style={{padding:"22px 8px"}}>Empty</div>}
      </div>)}
    </div>
    {modal && <JobModal job={modal==="new"?null:modal} data={data} ind={ind} onSave={save} onDelete={del} onClose={()=>setModal(null)}/>}
  </React.Fragment>;
}
