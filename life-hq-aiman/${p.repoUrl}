/* one shared token client; per-request success/fail routed through gOnOk/gOnFail */
let gOnOk=null, gOnFail=null;
function setToken(resp){ gToken={access_token:resp.access_token,expires:Date.now()+((resp.expires_in||3500)*1000)}; S.gcal.token=gToken; S.gcal.connected=true; save(); }
function gcalGetClient(){
  if(gTokenClient) return gTokenClient;
  if(!gcalReady()||!gcalClientId()) return null;
  gTokenClient=google.accounts.oauth2.initTokenClient({
    client_id:gcalClientId(), scope:GCAL_SCOPE,
    callback:(resp)=>{ if(resp&&resp.access_token){ setToken(resp); const f=gOnOk; gOnOk=gOnFail=null; f&&f(); } else { const f=gOnFail; gOnOk=gOnFail=null; f&&f(resp); } },
    error_callback:(err)=>{ const f=gOnFail; gOnOk=gOnFail=null; f&&f(err); }
  });
  return gTokenClient;
}
function gcalRequest(mode,ok,fail){
  const c=gcalGetClient(); if(!c){ fail&&fail(); return; }
  gOnOk=ok; gOnFail=fail;
  try{ c.requestAccessToken({prompt: mode==='consent'?'consent':''}); }catch(e){ gOnOk=gOnFail=null; fail&&fail(e); }
}
function gcalWhenReady(cb,n){ n=n||0; if(gcalReady()){ cb(); return; } if(n>50) return; setTimeout(()=>gcalWhenReady(cb,n+1),200); }
function gcalConnect(){
  if(!gcalClientId()){ openGcalSetup(); return; }
  gcalWhenReady(()=>{
    const done=()=>{ toast('Connected to Google ✅'); sfx('cash'); renderGcard(); gcalSync(true); };
    if(S.gcal.connected){ gcalRequest('silent',done,()=>gcalRequest('consent',done,()=>toast('Google sign-in cancelled'))); }
    else { gcalRequest('consent',done,()=>toast('Google sign-in cancelled')); }
  });
}
function gcalEnsureToken(cb){
  if(gToken && gToken.expires>Date.now()+30000){ cb(); return; }
  gcalWhenReady(()=> gcalRequest('silent', cb, ()=>{ gToken=null; if(S.gcal){S.gcal.token=null;} save(); renderGcard(); toast('Google session expired — tap Connect'); }) );
}
/* on app open: restore a valid token instantly, else silently refresh in the background */
function gcalAutoConnect(){
  if(!S.gcal) return;
  if(S.gcal.token && S.gcal.token.expires>Date.now()+30000){ gToken=S.gcal.token; renderGcard(); gcalSync(true); return; }
  if(S.gcal.connected){ gcalWhenReady(()=> gcalRequest('silent', ()=>{ renderGcard(); gcalSync(true); }, ()=>renderGcard()) ); }
}
function gcalDisconnect(){
  try{ if(gToken) google.accounts.oauth2.revoke(gToken.access_token,()=>{}); }catch(e){}
  gToken=null; S.gcal.token=null; S.gcal.connected=false; save(); renderGcard(); toast('Disconnected from Google');
}
async function gcalApi(path,opts={}){
  const r=await fetch('https://www.googleapis.com/calendar/v3'+path,{...opts,headers:{'Authorization':'Bearer '+gToken.access_token,'Content-Type':'application/json',...(opts.headers||{})}});
  if(!r.ok) throw new Error('gcal '+r.status);
  return r.status===204?null:r.json();
}
function gcalBody(e){
  const tz=Intl.DateTimeFormat().resolvedOptions().timeZone;
  return e.start
    ? {summary:e.title,description:e.note||'',start:{dateTime:`${e.date}T${e.start}:00`,timeZone:tz},end:{dateTime:`${e.date}T${e.end||addMin(e.start,60)}:00`,timeZone:tz}}
    : {summary:e.title,description:e.note||'',start:{date:e.date},end:{date:addDays(e.date,1)}};
}
/* push a single add/edit up to Google (only when connected this session) */
function gcalPushOne(e){
  if(!e || !gToken) return;               // not connected → will go up on next Connect/Sync
  gcalEnsureToken(async()=>{
    try{
      if(e.googleId){ await gcalApi('/calendars/primary/events/'+e.googleId,{method:'PATCH',body:JSON.stringify(gcalBody(e))}); }
      else { const g=await gcalApi('/calendars/primary/events',{method:'POST',body:JSON.stringify(gcalBody(e))}); e.googleId=g.id; save(); }
    }catch(err){ /* stays local; next full Sync reconciles */ }
  });
}
/* delete a single event from Google */
function gcalDeleteOne(googleId){
  if(!googleId || !gToken) return;
  gcalEnsureToken(async()=>{ try{ await gcalApi('/calendars/primary/events/'+googleId,{method:'DELETE'}); }catch(_){ } });
}
function gcalSync(silent){
  gcalEnsureToken(async()=>{
    try{
      // PULL — next 60 days from primary
      const tmin=new Date(); tmin.setHours(0,0,0,0);
      const tmax=new Date(); tmax.setDate(tmax.getDate()+60);
      const data=await gcalApi(`/calendars/primary/events?singleEvents=true&orderBy=startTime&timeMin=${tmin.toISOString()}&timeMax=${tmax.toISOString()}&maxResults=250`);
      let pulled=0;
      (data.items||[]).forEach(g=>{
        if(g.status==='cancelled') return;
        const date=(g.start.dateTime||g.start.date||'').slice(0,10); if(!date) return;
        const start=g.start.dateTime?g.start.dateTime.slice(11,16):'';
        const end=g.end&&g.end.dateTime?g.end.dateTime.slice(11,16):'';
        const ex=S.events.find(e=>e.googleId===g.id);
        const rec={title:g.summary||'(no title)',date,start,end,note:g.location||g.description||''};
        if(ex){ Object.assign(ex,rec); } // keep the local type (shift/family/etc.)
        else { S.events.push({id:uid(),...rec,type:'google',googleId:g.id}); pulled++; }
      });
      // PUSH — local events not yet in Google
      const tz=Intl.DateTimeFormat().resolvedOptions().timeZone;
      let pushed=0;
      for(const e of S.events.filter(e=>!e.googleId && e.type!=='google')){
        try{ const g=await gcalApi('/calendars/primary/events',{method:'POST',body:JSON.stringify(gcalBody(e))}); e.googleId=g.id; pushed++; }catch(_){}
      }
      save(); renderCal(); renderHome(); renderGcard();
      const last=$('#gLast'); if(last) last.textContent=new Date().toLocaleTimeString('en-AU',{hour:'numeric',minute:'2-digit'});
      if(!silent||pulled||pushed){ toast(`Synced ✅ ${pulled} in · ${pushed} out`); sfx('done'); }
    }catch(e){ toast('Sync failed — tap Connect to sign in again'); sfx('error'); gToken=null; renderGcard(); }
  });
}

