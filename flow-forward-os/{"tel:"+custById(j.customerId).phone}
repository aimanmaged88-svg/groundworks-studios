<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Flow Forward OS — AI Business Operating System</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
<style>
:root{
  --accent:#4F46E5; --accent-ink:#ffffff;
  --accent-grad:linear-gradient(135deg, color-mix(in srgb,var(--accent) 88%,#fff) 0%, var(--accent) 52%, color-mix(in srgb,var(--accent) 82%,#000) 100%);
  --bg:#F3F4F8; --surface:#FFFFFF; --surface-2:#FAFBFD; --border:#EAECF1; --border-strong:#DBDEE6;
  --text:#0B1220; --muted:#5B6573; --faint:#98A2B3;
  --good:#12B76A; --warn:#F79009; --bad:#F04438; --info:#2E90FA;
  --sidebar:#0A0E17; --sidebar-2:#0E1320; --sidebar-text:#98A2B3; --sidebar-active:#FFFFFF;
  --radius:14px; --radius-sm:10px;
  --shadow-xs:0 1px 2px rgba(11,18,32,.04);
  --shadow:0 1px 3px rgba(11,18,32,.055), 0 1px 2px rgba(11,18,32,.035);
  --shadow-md:0 6px 16px -4px rgba(11,18,32,.10), 0 2px 6px -2px rgba(11,18,32,.05);
  --shadow-lg:0 24px 48px -14px rgba(11,18,32,.26), 0 8px 18px -8px rgba(11,18,32,.14);
  --ring:0 0 0 3.5px color-mix(in srgb,var(--accent) 16%,transparent);
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;letter-spacing:-.006em;font-feature-settings:"cv05","ss01","tnum" 0}
::selection{background:color-mix(in srgb,var(--accent) 22%,transparent)}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;font-size:inherit}
input,select,textarea{font-family:inherit;font-size:14px;color:var(--text)}
::placeholder{color:var(--faint)}
a{color:var(--accent);text-decoration:none}
#root{min-height:100vh}

/* ---------- shared ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:9px 16px;border-radius:10px;font-weight:600;font-size:13.5px;letter-spacing:-.01em;transition:transform .16s cubic-bezier(.4,0,.2,1),box-shadow .16s,background .16s,filter .16s;white-space:nowrap}
.btn:active{transform:translateY(0) scale(.985)}
.btn-primary{background:var(--accent-grad);color:var(--accent-ink);box-shadow:0 1px 2px rgba(11,18,32,.16),inset 0 1px 0 rgba(255,255,255,.16)}
.btn-primary:hover{filter:brightness(1.05);transform:translateY(-1px);box-shadow:0 8px 20px -6px color-mix(in srgb,var(--accent) 60%,transparent),inset 0 1px 0 rgba(255,255,255,.18)}
.btn-ghost{background:var(--surface);border:1px solid var(--border-strong);color:var(--text);box-shadow:var(--shadow-xs)}
.btn-ghost:hover{background:var(--surface-2);transform:translateY(-1px);box-shadow:var(--shadow)}
.btn-danger{background:#FEF3F2;color:var(--bad);border:1px solid #FECDCA}
.btn-sm{padding:6px 11px;font-size:12.5px;border-radius:8px}
.btn-lg{padding:12px 22px;font-size:15px;border-radius:12px}
.btn[disabled]{opacity:.45;cursor:not-allowed;box-shadow:none;transform:none;filter:none}
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow)}
.input,.select,.textarea{width:100%;padding:10px 13px;border:1px solid var(--border-strong);border-radius:10px;background:var(--surface);outline:none;box-shadow:var(--shadow-xs);transition:border .15s,box-shadow .15s,background .15s}
.input:hover,.select:hover,.textarea:hover{border-color:color-mix(in srgb,var(--border-strong) 60%,var(--muted))}
.input:focus,.select:focus,.textarea:focus{border-color:var(--accent);box-shadow:var(--ring)}
.textarea{resize:vertical;min-height:84px}
.label{display:block;font-size:12px;font-weight:650;color:var(--muted);margin:0 0 6px 1px;letter-spacing:-.01em}
.field{margin-bottom:14px}
.badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:99px;font-size:11.5px;font-weight:650;line-height:1.6;letter-spacing:-.01em}
.b-gray{background:#F2F4F7;color:#475467}.b-green{background:#ECFDF3;color:#067647}.b-amber{background:#FFFAEB;color:#B54708}.b-red{background:#FEF3F2;color:#B42318}.b-blue{background:#EFF8FF;color:#175CD3}.b-purple{background:#F4F3FF;color:#5925DC}.b-accent{background:color-mix(in srgb,var(--accent) 12%,white);color:var(--accent)}
.dot{width:7px;height:7px;border-radius:99px;display:inline-block}
.row{display:flex;align-items:center;gap:10px}
.spread{display:flex;align-items:center;justify-content:space-between;gap:10px}
.muted{color:var(--muted)}.faint{color:var(--faint)}
.h1{font-size:24px;font-weight:800;letter-spacing:-.65px}
.h2{font-size:16.5px;font-weight:750;letter-spacing:-.35px}
.h3{font-size:13.5px;font-weight:700;letter-spacing:-.2px}
.tiny{font-size:12px}
.money{font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.avatar{width:34px;height:34px;border-radius:99px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12.5px;color:#fff;flex-shrink:0;box-shadow:0 1px 2px rgba(11,18,32,.18),inset 0 0 0 1px rgba(255,255,255,.14)}
.clickable{cursor:pointer;transition:background .14s}
.clickable:hover{background:var(--surface-2)}
.divider{height:1px;background:var(--border);margin:14px 0}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid2>*,.kanban>*,.stats>*{min-width:0}
.empty{padding:44px 20px;text-align:center;color:var(--muted)}
.empty .big{font-size:34px;margin-bottom:10px}
.section-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--faint);margin:0 0 10px}

/* ---------- layout ---------- */
.shell{display:flex;min-height:100vh}
.sidebar{width:236px;background:linear-gradient(180deg,var(--sidebar) 0%,var(--sidebar-2) 100%);color:var(--sidebar-text);display:flex;flex-direction:column;position:fixed;top:0;bottom:0;left:0;z-index:40;padding:16px 12px;overflow-y:auto;border-right:1px solid rgba(255,255,255,.05)}
.s-brand{display:flex;align-items:center;gap:10px;padding:6px 8px 18px}
.s-logo{width:36px;height:36px;border-radius:10px;background:var(--accent-grad);color:var(--accent-ink);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0;box-shadow:0 4px 14px -2px color-mix(in srgb,var(--accent) 55%,transparent),inset 0 1px 0 rgba(255,255,255,.2)}
.s-brand-name{color:#fff;font-weight:700;font-size:14px;line-height:1.2;letter-spacing:-.2px}
.s-brand-sub{font-size:10.5px;color:var(--sidebar-text)}
.s-item{display:flex;align-items:center;gap:11px;padding:9px 10px;border-radius:9px;font-size:13.5px;font-weight:500;width:100%;text-align:left;color:var(--sidebar-text);transition:background .14s,color .14s,box-shadow .14s;position:relative}
.s-item:hover{background:rgba(255,255,255,.055);color:#fff}
.s-item.active{background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 26%,transparent),rgba(255,255,255,.035));color:var(--sidebar-active);font-weight:600;box-shadow:inset 2.5px 0 0 var(--accent)}
.s-item .ic{width:19px;text-align:center;font-size:15px;flex-shrink:0}
.s-group{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#4A5468;padding:15px 10px 6px}
.main{flex:1;margin-left:236px;min-width:0}
.topbar{position:sticky;top:0;z-index:30;background:color-mix(in srgb,var(--bg) 68%,transparent);backdrop-filter:blur(18px) saturate(1.5);border-bottom:1px solid var(--border);padding:12px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.content{padding:24px 24px 90px;max-width:1200px;margin:0 auto}
.pagehead{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:20px;flex-wrap:wrap}

/* stats */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:20px}
.stat{padding:18px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);position:relative;overflow:hidden;transition:transform .2s cubic-bezier(.4,0,.2,1),box-shadow .2s}
.stat:hover{transform:translateY(-2px);box-shadow:var(--shadow-md)}
.stat .v{font-size:27px;font-weight:800;letter-spacing:-1px;margin:9px 0 3px;font-variant-numeric:tabular-nums}
.stat .l{font-size:11.5px;font-weight:650;color:var(--muted);letter-spacing:-.01em}
.stat .d{font-size:11.5px;font-weight:650;letter-spacing:-.01em}

/* table-ish lists */
.list{display:flex;flex-direction:column}
.list-row{display:flex;align-items:center;gap:12px;padding:13px 16px;border-bottom:1px solid var(--border)}
.list-row:last-child{border-bottom:none}

/* modal */
.overlay{position:fixed;inset:0;background:rgba(9,14,23,.5);backdrop-filter:blur(5px);z-index:100;display:flex;align-items:flex-end;justify-content:center;animation:fade .18s}
.modal{background:var(--surface);width:100%;max-width:560px;max-height:92vh;overflow-y:auto;border-radius:22px 22px 0 0;padding:24px;animation:up .22s cubic-bezier(.4,0,.2,1);box-shadow:var(--shadow-lg)}
@media(min-width:640px){.overlay{align-items:center;padding:20px}.modal{border-radius:20px}}
@keyframes fade{from{opacity:0}}
@keyframes up{from{transform:translateY(24px);opacity:.6}}
.modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.x{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:16px}
.x:hover{background:var(--bg)}

/* toast */
.toasts{position:fixed;bottom:84px;left:50%;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.toast{background:#0C111D;color:#fff;padding:10px 18px;border-radius:99px;font-size:13px;font-weight:600;box-shadow:var(--shadow-lg);animation:up .2s;max-width:90vw}
@media(min-width:900px){.toasts{bottom:28px}}

/* tabs & filter pills */
.pills{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;-webkit-overflow-scrolling:touch}
.pill{padding:7px 14px;border-radius:99px;font-size:12.5px;font-weight:650;letter-spacing:-.01em;border:1px solid var(--border-strong);background:var(--surface);color:var(--muted);white-space:nowrap;box-shadow:var(--shadow-xs);transition:all .15s}
.pill:hover{color:var(--text);border-color:var(--muted)}
.pill.active{background:var(--text);color:#fff;border-color:var(--text);box-shadow:var(--shadow)}

/* kanban */
.kanban{display:grid;grid-template-columns:repeat(3,1fr);gap:13px;align-items:start}
.kcol{background:color-mix(in srgb,var(--bg) 60%,var(--surface));border:1px solid var(--border);border-radius:var(--radius);padding:11px}
.kcard{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:13px;margin-bottom:9px;box-shadow:var(--shadow);cursor:pointer;transition:transform .16s cubic-bezier(.4,0,.2,1),box-shadow .16s,border-color .16s}
.kcard:hover{border-color:var(--border-strong);transform:translateY(-2px);box-shadow:var(--shadow-md)}

/* calendar */
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--border);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden}
.cal-h{background:var(--bg);padding:8px 4px;text-align:center;font-size:11px;font-weight:700;color:var(--faint);text-transform:uppercase}
.cal-d{background:var(--surface);min-height:86px;padding:6px;font-size:12px;cursor:pointer;position:relative}
.cal-d:hover{background:var(--bg)}
.cal-d.off{background:#FAFBFC;color:var(--faint)}
.cal-d .n{font-weight:600;font-size:11.5px}
.cal-d.today .n{background:var(--accent);color:var(--accent-ink);width:20px;height:20px;border-radius:99px;display:inline-flex;align-items:center;justify-content:center}
.cal-ev{margin-top:3px;background:color-mix(in srgb,var(--accent) 14%,white);color:var(--accent);border-radius:5px;padding:2px 5px;font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

/* login */
.login{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;position:relative;overflow:hidden;background:var(--sidebar)}
.login::before{content:'';position:absolute;inset:-10%;pointer-events:none;background:
  radial-gradient(760px 520px at 12% -5%, color-mix(in srgb,var(--accent) 40%,transparent), transparent 62%),
  radial-gradient(680px 560px at 92% 108%, color-mix(in srgb,var(--accent) 26%,transparent), transparent 58%),
  radial-gradient(520px 420px at 78% 18%, rgba(124,111,245,.16), transparent 60%);
  animation:aurora 16s ease-in-out infinite alternate}
.login::after{content:'';position:absolute;inset:0;pointer-events:none;opacity:.4;background:radial-gradient(120% 90% at 50% 0%,transparent 60%,rgba(0,0,0,.35))}
@keyframes aurora{from{transform:translate3d(-2%,-1%,0) scale(1)}to{transform:translate3d(2%,2%,0) scale(1.06)}}
.login-card{width:100%;max-width:460px;position:relative;z-index:1}
.tenant-tile{display:flex;align-items:center;gap:13px;width:100%;text-align:left;padding:15px;border-radius:15px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.1);color:#fff;backdrop-filter:blur(14px);box-shadow:0 4px 18px -6px rgba(0,0,0,.35);transition:transform .18s cubic-bezier(.4,0,.2,1),background .18s,border-color .18s;margin-bottom:10px}
.tenant-tile:hover{background:rgba(255,255,255,.11);border-color:rgba(255,255,255,.2);transform:translateY(-2px)}
.role-tile{flex:1;padding:18px 12px;border-radius:15px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.1);color:#fff;text-align:center;backdrop-filter:blur(14px);box-shadow:0 4px 18px -6px rgba(0,0,0,.35);transition:transform .18s cubic-bezier(.4,0,.2,1),background .18s,border-color .18s}
.role-tile:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.2);transform:translateY(-3px)}

/* switches */
.switch{width:38px;height:22px;border-radius:99px;background:var(--border-strong);position:relative;transition:background .15s;flex-shrink:0}
.switch.on{background:var(--good)}
.switch::after{content:'';position:absolute;top:2px;left:2px;width:18px;height:18px;border-radius:99px;background:#fff;transition:left .15s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.switch.on::after{left:18px}

/* charts */
.bar{fill:var(--accent);rx:4}
.bar.dim{fill:color-mix(in srgb,var(--accent) 25%,white)}

/* quote doc */
.doc{border:1px solid var(--border);border-radius:var(--radius);padding:26px;background:var(--surface);box-shadow:var(--shadow-md)}
.doc table{width:100%;border-collapse:collapse;font-size:13px}
.doc th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--faint);padding:8px 6px;border-bottom:1px solid var(--border)}
.doc td{padding:9px 6px;border-bottom:1px solid var(--border)}
.doc td:last-child,.doc th:last-child{text-align:right}

/* mobile */
.bottomnav{display:none}
.menu-btn{display:none}
@media(max-width:900px){
  .sidebar{display:none}
  .main{margin-left:0}
  .content{padding:16px 14px 96px}
  .topbar{padding:11px 14px}
  .stats{grid-template-columns:1fr 1fr}
  .kanban{grid-template-columns:1fr;}
  .grid2{grid-template-columns:1fr}
  .cal-d{min-height:58px;padding:4px}
  .cal-ev{display:none}
  .cal-d .has{position:absolute;bottom:5px;left:50%;transform:translateX(-50%);width:5px;height:5px;border-radius:99px;background:var(--accent)}
  .bottomnav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:50;background:color-mix(in srgb,var(--surface) 92%,transparent);backdrop-filter:blur(12px);border-top:1px solid var(--border);padding:6px 4px calc(6px + env(safe-area-inset-bottom))}
  .bn-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:5px 2px;font-size:9.5px;font-weight:600;color:var(--faint);border-radius:9px}
  .bn-item.active{color:var(--accent)}
  .bn-item .ic{font-size:19px}
  .menu-btn{display:flex}
}
.drawer-overlay{position:fixed;inset:0;background:rgba(12,17,29,.55);z-index:60;animation:fade .15s}
.drawer{position:fixed;top:0;bottom:0;left:0;width:270px;background:var(--sidebar);z-index:61;padding:16px 12px;overflow-y:auto;animation:slide .2s}
@keyframes slide{from{transform:translateX(-40px);opacity:.5}}
@media print{.sidebar,.topbar,.bottomnav,.no-print{display:none!important}.main{margin:0}.content{padding:0}}
</style>
</head>
