/* ================================================================
   ANALYTICS
   ================================================================ */
function Analytics(props){
  const {data,ind}=props;
  const [drill,setDrill]=useState(null); // {title, items:[{main,sub,right}]}
  const custName=id=>data.customers.find(c=>c.id===id)?.name||"—";
  const t=todayISO();
  const months=[]; for(let i=5;i>=0;i--){ const k=monthKey(addDays(t,-i*30)); months.push(k); }
  const paid=data.invoices.filter(i=>i.status==="paid");
  const series=months.map(k=>({l:new Date(k+"-15").toLocaleDateString("en-AU",{month:"short"}), v:paid.filter(i=>monthKey(i.paidAt||i.issuedAt)===k).reduce((a,i)=>a+i.amount,0)}));
  const funnel=[
    {l:"Leads",v:data.leads.length,c:"var(--info)"},
    {l:"Quoted",v:data.quotes.length,c:"#7839EE"},
    {l:"Won",v:data.quotes.filter(q=>q.status==="accepted").length,c:"var(--good)"}];
  const jobParts=[
    {v:data.jobs.filter(j=>j.status==="scheduled").length,c:"var(--info)",l:"Scheduled"},
    {v:data.jobs.filter(j=>j.status==="in_progress").length,c:"var(--warn)",l:"In progress"},
    {v:data.jobs.filter(j=>j.status==="done").length,c:"var(--good)",l:"Done"}];
  const svc={}; paid.forEach(i=>{svc[i.title]=(svc[i.title]||0)+i.amount});
  const topSvcs=Object.entries(svc).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const maxSvc=topSvcs[0]?.[1]||1;

  const drillFunnel=stage=>{
    if(stage==="Leads") setDrill({title:"All leads ("+data.leads.length+")",items:data.leads.map(l=>({main:l.name,sub:l.need+" · "+l.source,right:l.stage}))});
    else if(stage==="Quoted") setDrill({title:"All quotes ("+data.quotes.length+")",items:data.quotes.map(q=>({main:q.num+" · "+q.title,sub:custName(q.customerId),right:fmt$(q.total)}))});
    else setDrill({title:"Won quotes",items:data.quotes.filter(q=>q.status==="accepted").map(q=>({main:q.num+" · "+q.title,sub:custName(q.customerId),right:fmt$(q.total)}))});
  };
  const drillJobs=status=>{
    const map={Scheduled:"scheduled","In progress":"in_progress",Done:"done"};
    const js=data.jobs.filter(j=>j.status===map[status]);
    setDrill({title:status+" ("+js.length+")",items:js.map(j=>({main:j.title,sub:custName(j.customerId)+" · "+fmtDate(j.date),right:fmt$(j.value)}))});
  };
  const drillSvc=name=>{
    const invs=paid.filter(i=>i.title===name);
    setDrill({title:name,items:invs.map(i=>({main:i.num,sub:custName(i.customerId)+" · paid "+fmtDate(i.paidAt||i.issuedAt),right:fmt$(i.amount)}))});
  };
  const drillMonth=k=>{
    const invs=paid.filter(i=>monthKey(i.paidAt||i.issuedAt)===k);
    setDrill({title:new Date(k+"-15").toLocaleDateString("en-AU",{month:"long",year:"numeric"})+" — "+fmt$(invs.reduce((a,i)=>a+i.amount,0)),items:invs.map(i=>({main:i.num+" · "+i.title,sub:custName(i.customerId),right:fmt$(i.amount)}))});
  };

  return <React.Fragment>
    <div className="pagehead"><div><div className="h1">Analytics</div><div className="muted tiny">The full picture — tap any bar, stage or service to see what's behind it.</div></div></div>
    <div className="card" style={{padding:18,marginBottom:14}}>
      <div className="h3" style={{marginBottom:12}}>Revenue collected — last 6 months</div>
      <BarChart series={series} onBar={i=>drillMonth(months[i])}/>
    </div>
    <div className="grid2" style={{alignItems:"stretch"}}>
      <div className="card" style={{padding:18}}>
        <div className="h3" style={{marginBottom:12}}>Sales funnel</div>
        {funnel.map((f,i)=><div key={i} className="clickable" style={{marginBottom:10,padding:4,margin:"-4px -4px 6px",borderRadius:8}} onClick={()=>drillFunnel(f.l)}>
          <div className="spread tiny" style={{marginBottom:4}}><span className="muted">{f.l} →</span><span style={{fontWeight:700}}>{f.v}</span></div>
          <div style={{height:9,background:"var(--bg)",borderRadius:99}}><div style={{height:"100%",width:Math.max(4,100*f.v/(funnel[0].v||1))+"%",background:f.c,borderRadius:99}}/></div>
        </div>)}
        <div className="tiny faint" style={{marginTop:8}}>Lead → won conversion: {funnel[0].v?Math.round(100*funnel[2].v/funnel[0].v):0}%</div>
      </div>
      <div className="card" style={{padding:18}}>
        <div className="h3" style={{marginBottom:12}}>{ind.jobNoun[0].toUpperCase()+ind.jobNoun.slice(1)} status</div>
        <div className="row" style={{gap:18}}>
          <Donut parts={jobParts}/>
          <div>{jobParts.map((p,i)=><div key={i} className="row tiny clickable" style={{gap:7,marginBottom:4,padding:"3px 6px",borderRadius:7}} onClick={()=>drillJobs(p.l)}><span className="dot" style={{background:p.c}}/>{p.l} · <b>{p.v}</b> →</div>)}</div>
        </div>
      </div>
    </div>
    <div className="card" style={{padding:18,marginTop:14}}>
      <div className="h3" style={{marginBottom:12}}>Top services by revenue</div>
      {topSvcs.map(([name,v],i)=><div key={i} className="clickable" style={{marginBottom:10,padding:4,margin:"-4px -4px 6px",borderRadius:8}} onClick={()=>drillSvc(name)}>
        <div className="spread tiny" style={{marginBottom:4}}><span className="muted" style={{whiteSpace:"nowrap",overflow:"hidden",textOverflow:"ellipsis",maxWidth:"70%"}}>{name} →</span><span className="money" style={{fontWeight:700}}>{fmt$(v)}</span></div>
        <div style={{height:9,background:"var(--bg)",borderRadius:99}}><div style={{height:"100%",width:Math.max(4,100*v/maxSvc)+"%",background:"var(--accent)",borderRadius:99,opacity:1-(i*0.15)}}/></div>
      </div>)}
      {topSvcs.length===0&&<div className="empty tiny">Complete some jobs to see your top earners.</div>}
    </div>
    {drill && <Modal title={drill.title} onClose={()=>setDrill(null)}>
      <div className="list" style={{margin:"-6px 0"}}>
        {drill.items.map((it,i)=><div key={i} className="list-row">
          <div style={{flex:1,minWidth:0}}><div style={{fontWeight:600,fontSize:13}}>{it.main}</div><div className="tiny faint">{it.sub}</div></div>
          <span className="tiny" style={{fontWeight:700}}>{it.right}</span>
        </div>)}
        {drill.items.length===0&&<div className="empty tiny">Nothing here yet.</div>}
      </div>
    </Modal>}
  </React.Fragment>;
}

/* ================================================================
   REVIEWS
   ================================================================ */
function Reviews(props){
  const {data,setData,toast}=props;
  const [replying,setReplying]=useState(null);
  const [txt,setTxt]=useState("");
  const custById=id=>data.customers.find(c=>c.id===id)||{name:"A customer"};
  const avg=data.reviews.length? (data.reviews.reduce((a,r)=>a+r.rating,0)/data.reviews.length):0;
  const reply=r=>{
    setData(d=>{ d.reviews=d.reviews.map(x=>x.id===r.id?{...x,reply:txt}:x); return d; });
    setReplying(null); setTxt(""); toast("Reply posted");
  };
  return <React.Fragment>
    <div className="pagehead">
      <div><div className="h1">Reviews</div><div className="muted tiny">Review requests send automatically after every completed job.</div></div>
      <div style={{textAlign:"right"}}><div style={{fontWeight:800,fontSize:24}}>{avg.toFixed(1)} <span style={{fontSize:15}}>⭐</span></div><div className="tiny faint">{data.reviews.length} reviews</div></div>
    </div>
    {data.reviews.map(r=><div key={r.id} className="card" style={{padding:18,marginBottom:12}}>
      <div className="spread" style={{marginBottom:8}}>
        <div className="row"><Avatar name={custById(r.customerId).name} size={30}/><div><div style={{fontWeight:700,fontSize:13}}>{custById(r.customerId).name}</div><div className="tiny faint">{r.platform} · {fmtDate(r.date)}</div></div></div>
        <Stars n={r.rating}/>
      </div>
      <div className="tiny" style={{lineHeight:1.6}}>{r.text}</div>
      {r.reply
        ? <div className="tiny" style={{marginTop:10,padding:"10px 12px",background:"var(--bg)",borderRadius:9}}><b>Your reply:</b> {r.reply}</div>
        : replying===r.id
          ? <div style={{marginTop:10}}>
              <textarea className="textarea" rows={2} autoFocus value={txt} onChange={e=>setTxt(e.target.value)} placeholder="Thanks so much…"/>
              <div className="row" style={{marginTop:8}}>
                <button className="btn btn-primary btn-sm" disabled={!txt.trim()} onClick={()=>reply(r)}>Post reply</button>
                <button className="btn btn-ghost btn-sm" onClick={()=>setReplying(null)}>Cancel</button>
              </div>
            </div>
          : <button className="btn btn-ghost btn-sm no-print" style={{marginTop:10}} onClick={()=>{setReplying(r.id);setTxt("");}}>↩ Reply</button>}
    </div>)}
  </React.Fragment>;
}

