function leadLinkFor(tenant){
  const base=location.origin+location.pathname;
  const q=new URLSearchParams({lead:"1",b:tenant.name,c:tenant.color,i:tenant.industry,
    p:tenant.leadPhone||"",e:tenant.leadEmail||"",t:tenant.tagline||""});
  return base+"?"+q.toString();
}

